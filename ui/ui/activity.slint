// The Activity app: three pages scrolled up and down. Today's steps in the middle of an arc that
// fills towards the daily goal, the steps of the last seven days as bars with the goal as a line,
// and the goal to set. The arc is the Heart Rate app's: its pieces do not overlap, so the part
// still to go can be drawn see-through.
import { Face } from "face.slint";
import { Codes } from "codes.slint";
import { PageDot, IntSelector } from "controls.slint";
import { Pager } from "launcher.slint";
import { HeartArc } from "heart_arc.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

export component ActivityScreen {
    property <int> today: Face.activity-today;
    property <int> goal: Math.max(1, Face.activity-goal);
    property <[int]> days: Face.activity-days;
    property <color> accent: #ffc94a;
    property <[string]> initials: ["S", "M", "T", "W", "T", "F", "S"];
    // In whole degrees from 3 o'clock, as the arc's pieces are: the filled run is 115..end.
    property <int> end: 115 + Math.round(Math.min(1, self.today / self.goal) * 310);
    property <int> best: Math.max(self.goal, self.days.length > 0 ? Math.max(self.days[0], self.days[1], self.days[2], self.days[3], self.days[4], self.days[5], self.days[6]) : 0);
    property <length> scroll: pager.index * 100 * Theme.unit - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    pure function grouped(n: int) -> string {
        return n < 1000 ? n : Math.floor(n / 1000) + "," + (Math.mod(n, 1000) < 100 ? "0" : "") + (Math.mod(n, 1000) < 10 ? "0" : "") + Math.mod(n, 1000);
    }

    width: 100%;
    height: 100%;

    pager := Pager {
        horizontal: false;
        item: 100 * Theme.unit;
        count: 3;
        limit: 1;
    }

    Rectangle {
        y: -root.scroll;
        width: 100 * Theme.unit;
        height: 100 * Theme.unit;
        visible: root.scroll < 100 * Theme.unit;

        for seg[i] in HeartArc.segments: Image {
            x: seg.x;
            y: seg.y;
            width: seg.w;
            height: seg.h;
            source: Icons.get(seg.img, self.width, self.height);
            colorize: 116 + i <= root.end ? root.accent : white;
            opacity: 116 + i <= root.end ? 1 : 0.25;
        }

        for cap in [
            { on: root.end > 115, img: HeartArc.starts[0], done: true },
            { on: root.end > 115, img: HeartArc.ends[root.end - 115], done: true },
            { on: root.end == 115, img: HeartArc.starts[0], done: false },
            { on: root.end < 425, img: HeartArc.ends[310], done: false },
        ]: Image {
            x: cap.img.x;
            y: cap.img.y;
            width: cap.img.w;
            height: cap.img.h;
            source: Icons.get(cap.img.img, self.width, self.height);
            colorize: cap.done ? root.accent : white;
            opacity: cap.done ? 1 : 0.25;
            visible: cap.on;
        }

        Image {
            x: 44 * Theme.unit;
            y: 23 * Theme.unit;
            width: 12 * Theme.unit;
            height: 12 * Theme.unit;
            source: Icons.get("ios-walk", self.width, self.height);
            colorize: white;
        }

        Text {
            y: 36 * Theme.unit;
            width: 100 * Theme.unit;
            height: 22 * Theme.unit;
            text: root.grouped(root.today);
            color: white;
            font-size: root.today >= 10000 ? 15 * Theme.unit : 18 * Theme.unit;
            letter-spacing: -0.5 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            y: 58 * Theme.unit;
            width: 100 * Theme.unit;
            height: 8 * Theme.unit;
            text: "steps";
            color: #ffffffcc;
            font-size: 6 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            y: 78 * Theme.unit;
            width: 100 * Theme.unit;
            height: 8 * Theme.unit;
            text: root.today >= root.goal ? "Goal reached" : "of " + root.grouped(root.goal);
            color: root.today >= root.goal ? root.accent : #ffffffcc;
            font-size: 5 * Theme.unit;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: 100 * Theme.unit - root.scroll;
        width: 100 * Theme.unit;
        height: 100 * Theme.unit;
        visible: self.y > -100 * Theme.unit && self.y < 100 * Theme.unit;

        Text {
            y: 12 * Theme.unit;
            width: 100 * Theme.unit;
            height: 12 * Theme.unit;
            text: "Last 7 days";
            color: white;
            font-family: "Noto Sans SemiCondensed ExtraLight";
            font-size: 9 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // The bars stand on y = 70, 40 high for the best day or the goal, whichever is more.
        for steps[i] in root.days: Rectangle {
            x: 18 * Theme.unit + i * 9.5 * Theme.unit;
            y: 70 * Theme.unit - self.height;
            width: 7 * Theme.unit;
            height: Math.max(1, 40 * steps / root.best) * Theme.unit;
            border-radius: 1 * Theme.unit;
            background: root.accent;
            opacity: steps >= root.goal ? 1 : 0.55;
        }

        Rectangle {
            x: 16 * Theme.unit;
            y: 70 * Theme.unit - 40 * Theme.unit * root.goal / root.best;
            width: 68 * Theme.unit;
            height: 0.5 * Theme.unit;
            background: white;
            opacity: 0.6;
        }

        for steps[i] in root.days: Text {
            x: 18 * Theme.unit + i * 9.5 * Theme.unit;
            y: 71 * Theme.unit;
            width: 7 * Theme.unit;
            height: 7 * Theme.unit;
            text: root.initials[Math.mod(Face.weekday + i + 1, 7)];
            color: i == root.days.length - 1 ? white : #ffffff99;
            font-size: 4.5 * Theme.unit;
            font-weight: i == root.days.length - 1 ? 700 : 300;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            y: 79 * Theme.unit;
            width: 100 * Theme.unit;
            height: 8 * Theme.unit;
            property <int> sum: root.days.length > 0 ? root.days[0] + root.days[1] + root.days[2] + root.days[3] + root.days[4] + root.days[5] + root.days[6] : 0;
            text: "Average " + root.grouped(Math.round(self.sum / 7));
            color: #ffffffcc;
            font-size: 4.5 * Theme.unit;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: 200 * Theme.unit - root.scroll;
        width: 100 * Theme.unit;
        height: 100 * Theme.unit;
        visible: root.scroll > 100 * Theme.unit;

        Text {
            y: 22 * Theme.unit;
            width: 100 * Theme.unit;
            height: 12 * Theme.unit;
            text: "Daily goal";
            color: white;
            font-family: "Noto Sans SemiCondensed ExtraLight";
            font-size: 9 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        IntSelector {
            y: 40 * Theme.unit;
            value: root.goal;
            min: 500;
            max: 20000;
            step: 500;
            unit: "";
            down => {
                Face.setting-set(Codes.setting-step-goal, Math.max(500, root.goal - 500) / 500);
            }
            up => {
                Face.setting-set(Codes.setting-step-goal, Math.min(20000, root.goal + 500) / 500);
            }
            set(v) => {
                Face.setting-set(Codes.setting-step-goal, v / 500);
            }
        }

        Text {
            y: 66 * Theme.unit;
            width: 100 * Theme.unit;
            height: 8 * Theme.unit;
            text: "steps a day";
            color: #ffffffcc;
            font-size: 5 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    PageDot {
        x: (100 * Theme.unit - self.width) / 2;
        y: 94 * Theme.unit;
        count: 3;
        current: pager.index;
        size: 2 * Theme.unit;
    }
}
