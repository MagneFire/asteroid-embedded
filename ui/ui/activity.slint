// The Activity app: pages scrolled up and down. Today's steps in the middle of an arc that fills
// towards the daily goal, the steps of the last seven days as bars with the goal as a line, a
// day of logged heart rates where the watch has the sensor, a workout to start and stop with the
// last one below it, and the daily goal, height and weight to
// set. The arc is the Heart Rate app's: its pieces do not
// overlap, so the part still to go can be drawn see-through.
import { Face, HeartPoint } from "face.slint";
import { Codes } from "codes.slint";
import { PageDot, IntSelector, RowLabel, Pill, LabeledSwitch } from "controls.slint";
import { Pager } from "launcher.slint";
import { HeartArc } from "heart_arc.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

global Activity {
    out property <color> accent: #ffc94a;

    public pure function grouped(n: int) -> string {
        return n < 1000 ? n : Math.floor(n / 1000) + "," + (Math.mod(n, 1000) < 100 ? "0" : "") + (Math.mod(n, 1000) < 10 ? "0" : "") + Math.mod(n, 1000);
    }
    public pure function duration(s: int) -> string {
        return (s >= 3600 ? Math.floor(s / 3600) + ":" + Face.two-digits(Math.mod(Math.floor(s / 60), 60)) : Math.floor(s / 60)) + ":" + Face.two-digits(Math.mod(s, 60));
    }
    // Miles where temperatures are in Fahrenheit, kilometres elsewhere, to a tenth.
    public pure function distance(m: int) -> string {
        let tenths = Math.round(Face.fahrenheit ? m / 160.934 : m / 100);
        return Math.floor(tenths / 10) + "." + Math.mod(tenths, 10) + (Face.fahrenheit ? " mi" : " km");
    }
}

component PageTitle inherits Text {
    width: 100 * Theme.unit;
    height: 12 * Theme.unit;
    color: white;
    font-family: "Noto Sans SemiCondensed ExtraLight";
    font-size: 9 * Theme.unit;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Caption inherits Text {
    width: 100 * Theme.unit;
    height: 8 * Theme.unit;
    color: #ffffffcc;
    font-size: 5 * Theme.unit;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component TodayPage {
    property <int> today: Face.activity-today;
    property <int> goal: Math.max(1, Face.activity-goal);
    // In whole degrees from 3 o'clock, as the arc's pieces are: the filled run is 115..end.
    property <int> end: 115 + Math.round(Math.min(1, self.today / self.goal) * 310);

    for seg[i] in HeartArc.segments: Image {
        x: seg.x;
        y: seg.y;
        width: seg.w;
        height: seg.h;
        source: Icons.get(seg.img, self.width, self.height);
        colorize: 116 + i <= root.end ? Activity.accent : white;
        opacity: 116 + i <= root.end ? 1 : 0.25;
    }

    for cap in [
        { on: root.end > 115, img: HeartArc.starts[0], done: true },
        { on: root.end > 115, img: HeartArc.ends[root.end - 115], done: true },
        { on: root.end == 115, img: HeartArc.starts[0], done: false },
        { on: root.end < 425, img: HeartArc.ends[310], done: false },
    ]: Image {
        x: cap.img.x;
        y: cap.img.y;
        width: cap.img.w;
        height: cap.img.h;
        source: Icons.get(cap.img.img, self.width, self.height);
        colorize: cap.done ? Activity.accent : white;
        opacity: cap.done ? 1 : 0.25;
        visible: cap.on;
    }

    Image {
        x: 44 * Theme.unit;
        y: 21 * Theme.unit;
        width: 12 * Theme.unit;
        height: 12 * Theme.unit;
        source: Icons.get("ios-walk", self.width, self.height);
        colorize: white;
    }

    Text {
        y: 33 * Theme.unit;
        width: 100 * Theme.unit;
        height: 22 * Theme.unit;
        text: Activity.grouped(root.today);
        color: white;
        font-size: root.today >= 10000 ? 15 * Theme.unit : 18 * Theme.unit;
        letter-spacing: -0.5 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Caption {
        y: 55 * Theme.unit;
        text: "steps";
        font-size: 6 * Theme.unit;
    }

    Caption {
        y: 64 * Theme.unit;
        text: Activity.distance(Face.activity-distance) + "  ·  " + Face.activity-kcal + " kcal";
        font-size: 4.5 * Theme.unit;
    }

    Caption {
        y: 78 * Theme.unit;
        text: root.today >= root.goal ? "Goal reached" : "of " + Activity.grouped(root.goal);
        color: root.today >= root.goal ? Activity.accent : #ffffffcc;
        font-weight: 700;
    }
}

component WeekPage {
    property <[int]> days: Face.activity-days;
    property <int> goal: Math.max(1, Face.activity-goal);
    property <[string]> initials: ["S", "M", "T", "W", "T", "F", "S"];
    property <int> best: Math.max(self.goal, self.days.length >= 7 ? Math.max(self.days[0], self.days[1], self.days[2], self.days[3], self.days[4], self.days[5], self.days[6]) : 0);
    property <int> sum: self.days.length >= 7 ? self.days[0] + self.days[1] + self.days[2] + self.days[3] + self.days[4] + self.days[5] + self.days[6] : 0;

    PageTitle {
        y: 12 * Theme.unit;
        text: "Last 7 days";
    }

    // The bars stand on y = 70, 40 high for the best day or the goal, whichever is more.
    for steps[i] in root.days: Rectangle {
        x: 18 * Theme.unit + i * 9.5 * Theme.unit;
        y: 70 * Theme.unit - self.height;
        width: 7 * Theme.unit;
        height: Math.max(1, 40 * steps / root.best) * Theme.unit;
        border-radius: 1 * Theme.unit;
        background: Activity.accent;
        opacity: steps >= root.goal ? 1 : 0.55;
    }

    Rectangle {
        x: 16 * Theme.unit;
        y: 70 * Theme.unit - 40 * Theme.unit * root.goal / root.best;
        width: 68 * Theme.unit;
        height: 0.5 * Theme.unit;
        background: white;
        opacity: 0.6;
    }

    for steps[i] in root.days: Text {
        x: 18 * Theme.unit + i * 9.5 * Theme.unit;
        y: 71 * Theme.unit;
        width: 7 * Theme.unit;
        height: 7 * Theme.unit;
        text: root.initials[Math.mod(Face.weekday + i + 1, 7)];
        color: i == root.days.length - 1 ? white : #ffffff99;
        font-size: 4.5 * Theme.unit;
        font-weight: i == root.days.length - 1 ? 700 : 300;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Caption {
        y: 79 * Theme.unit;
        text: "Average " + Activity.grouped(Math.round(root.sum / 7));
        font-size: 4.5 * Theme.unit;
        font-weight: 700;
    }
}

// The logged rates of the last day as dots, a day ago at the left and now at the right, from 40
// bpm at the bottom to 180 at the top, and how often to log.
component HeartPage {
    property <[HeartPoint]> log: Face.heart-log;
    property <int> low: 40;
    property <int> high: 180;
    property <int> choice: Face.hr-interval == 10 ? 1 : Face.hr-interval == 30 ? 2 : Face.hr-interval == 60 ? 3 : 0;

    PageTitle {
        y: 10 * Theme.unit;
        text: "Heart rate";
    }

    Rectangle {
        x: 15 * Theme.unit;
        y: 25 * Theme.unit;
        width: 70 * Theme.unit;
        height: 34 * Theme.unit;

        for y in [60, 100, 140]: Rectangle {
            y: parent.height * (1 - (y - root.low) / (root.high - root.low));
            width: parent.width;
            height: 0.25 * Theme.unit;
            background: white;
            opacity: 0.2;
        }

        for p in root.log: Rectangle {
            x: parent.width * p.x / 1000 - 0.9 * Theme.unit;
            y: parent.height * (1 - (Math.clamp(p.bpm, root.low, root.high) - root.low) / (root.high - root.low)) - 0.9 * Theme.unit;
            width: 1.8 * Theme.unit;
            height: 1.8 * Theme.unit;
            border-radius: 0.9 * Theme.unit;
            background: #e23b4e;
        }

        if root.log.length == 0: Text {
            width: parent.width;
            height: parent.height;
            text: Face.hr-interval > 0 ? "No readings yet" : "Not logged";
            color: #ffffff99;
            font-size: 5 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Caption {
        y: 59 * Theme.unit;
        text: root.log.length > 0 ? "Last " + root.log[root.log.length - 1].bpm + " bpm" : "";
        font-size: 4.5 * Theme.unit;
    }

    LabeledSwitch {
        y: 67 * Theme.unit;
        text: "Measure every";
        value: ["Off", "10 min", "30 min", "Hour"][root.choice];
        clicked => {
            Face.setting-set(Codes.setting-hr-interval, [10, 30, 60, 0][root.choice]);
        }
    }
}

// While it runs: the time since the start, the steps and what they come to, the heart rate where
// the watch has the sensor, and Stop. Otherwise Start, with the last workout under it.
component WorkoutPage {
    property <bool> running: Face.workout-running;
    property <int> seconds: self.running ? Math.max(0, Face.now - Face.workout-start) : Face.workout-seconds;
    property <bool> any: self.running || Face.workout-seconds > 0;

    PageTitle {
        y: 12 * Theme.unit;
        text: "Workout";
        visible: !root.running;
    }

    if root.running: Text {
        y: 14 * Theme.unit;
        width: 100 * Theme.unit;
        height: 18 * Theme.unit;
        text: Activity.duration(root.seconds);
        color: white;
        font-size: 14 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.any: Caption {
        y: root.running ? 33 * Theme.unit : 54 * Theme.unit;
        text: root.running ? Activity.grouped(Face.workout-steps) + " steps" : "Last: " + Activity.duration(root.seconds) + "  ·  " + Activity.grouped(Face.workout-steps) + " steps";
        font-size: root.running ? 6 * Theme.unit : 4.5 * Theme.unit;
    }

    if root.any: Caption {
        y: root.running ? 41 * Theme.unit : 61 * Theme.unit;
        text: Activity.distance(Face.workout-distance) + "  ·  " + Face.workout-kcal + " kcal";
        font-size: 4.5 * Theme.unit;
    }

    if Face.has-heart-rate && root.running: Caption {
        y: 49 * Theme.unit;
        text: Face.heart-rate > 0 ? Face.heart-rate + " bpm" : "– bpm";
        color: #e23b4e;
        font-size: 6 * Theme.unit;
        font-weight: 700;
    }

    if Face.has-heart-rate && !root.running && Face.workout-avg-bpm > 0: Caption {
        y: 68 * Theme.unit;
        text: "Heart rate " + Face.workout-avg-bpm + " avg, " + Face.workout-max-bpm + " max";
        font-size: 4.5 * Theme.unit;
    }

    Pill {
        x: 22.5 * Theme.unit;
        y: root.running ? 64 * Theme.unit : 28 * Theme.unit;
        text: root.running ? "Stop" : "Start";
        clicked => {
            Face.workout(!root.running);
        }
    }
}

component GoalPage {
    property <int> goal: Math.max(1, Face.activity-goal);

    PageTitle {
        y: 22 * Theme.unit;
        text: "Daily goal";
    }

    IntSelector {
        y: 40 * Theme.unit;
        value: root.goal;
        min: 500;
        max: 20000;
        step: 500;
        unit: "";
        down => {
            Face.setting-set(Codes.setting-step-goal, Math.max(500, root.goal - 500) / 500);
        }
        up => {
            Face.setting-set(Codes.setting-step-goal, Math.min(20000, root.goal + 500) / 500);
        }
        set(v) => {
            Face.setting-set(Codes.setting-step-goal, v / 500);
        }
    }

    Caption {
        y: 66 * Theme.unit;
        text: "steps a day";
    }
}

// Kept in cm and kg; shown in inches and pounds where temperatures are in Fahrenheit, where a
// press moves the weight a whole kg so that it always changes.
component BodyPage {
    property <bool> imperial: Face.fahrenheit;
    property <int> inches: Math.round(Face.height-cm / 2.54);
    property <int> pounds: Math.round(Face.weight-kg * 2.20462);

    RowLabel {
        y: 6 * Theme.unit;
        text: "Height";
    }

    IntSelector {
        y: 18 * Theme.unit;
        value: root.imperial ? root.inches : Face.height-cm;
        min: root.imperial ? 40 : 100;
        max: root.imperial ? 90 : 230;
        step: 1;
        unit: root.imperial ? " in" : " cm";
        down => {
            Face.setting-set(Codes.setting-height, root.imperial ? Math.round((root.inches - 1) * 2.54) : Face.height-cm - 1);
        }
        up => {
            Face.setting-set(Codes.setting-height, root.imperial ? Math.round((root.inches + 1) * 2.54) : Face.height-cm + 1);
        }
        set(v) => {
            Face.setting-set(Codes.setting-height, root.imperial ? Math.round(v * 2.54) : v);
        }
    }

    RowLabel {
        y: 45 * Theme.unit;
        text: "Weight";
    }

    IntSelector {
        y: 57 * Theme.unit;
        value: root.imperial ? root.pounds : Face.weight-kg;
        min: root.imperial ? 66 : 30;
        max: root.imperial ? 441 : 200;
        step: 1;
        unit: root.imperial ? " lb" : " kg";
        down => {
            Face.setting-set(Codes.setting-weight, Face.weight-kg - 1);
        }
        up => {
            Face.setting-set(Codes.setting-weight, Face.weight-kg + 1);
        }
        set(v) => {
            Face.setting-set(Codes.setting-weight, root.imperial ? Math.round(v / 2.20462) : v);
        }
    }
}

export component ActivityScreen {
    // Page kinds: 0 today, 1 week, 2 heart rate, 3 workout, 4 goal, 5 body.
    property <[int]> pages: Face.has-heart-rate ? [0, 1, 2, 3, 4, 5] : [0, 1, 3, 4, 5];
    property <length> scroll: pager.index * 100 * Theme.unit - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: 100%;
    height: 100%;

    pager := Pager {
        horizontal: false;
        item: 100 * Theme.unit;
        count: root.pages.length;
        limit: 1;
    }

    for kind[k] in root.pages: Rectangle {
        y: k * 100 * Theme.unit - root.scroll;
        width: 100 * Theme.unit;
        height: 100 * Theme.unit;
        visible: self.y > -100 * Theme.unit && self.y < 100 * Theme.unit;

        if kind == 0: TodayPage {
            width: 100%;
            height: 100%;
        }
        if kind == 1: WeekPage {
            width: 100%;
            height: 100%;
        }
        if kind == 2: HeartPage {
            width: 100%;
            height: 100%;
        }
        if kind == 3: WorkoutPage {
            width: 100%;
            height: 100%;
        }
        if kind == 4: GoalPage {
            width: 100%;
            height: 100%;
        }
        if kind == 5: BodyPage {
            width: 100%;
            height: 100%;
        }
    }

    PageDot {
        x: (100 * Theme.unit - self.width) / 2;
        y: 94 * Theme.unit;
        count: root.pages.length;
        current: pager.index;
        size: 2 * Theme.unit;
    }
}
