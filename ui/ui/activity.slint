// The Activity app: pages swiped sideways. Today's steps in the middle of a ring that fills
// towards the daily goal, the steps of the last seven days as bars with the goal as a line, a day
// of logged heart rates where the watch has the sensor, a workout to start and stop with the last
// one below it, and the daily goal to set; the height and weight it works with are in Settings.
import { Face, HeartPoint } from "face.slint";
import { Codes } from "codes.slint";
import { PageDot, IntSelector, RowLabel, Pill, LabeledSwitch, Scroller } from "controls.slint";
import { ActivityArc } from "activity_arc.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

global Activity {
    out property <color> accent: #ffc94a;

    public pure function grouped(n: int) -> string {
        return n < 1000 ? n : Math.floor(n / 1000) + "," + (Math.mod(n, 1000) < 100 ? "0" : "") + (Math.mod(n, 1000) < 10 ? "0" : "") + Math.mod(n, 1000);
    }
    // As the stopwatch shows its time.
    public pure function duration(s: int) -> string {
        let h = Math.floor(s / 3600);
        let m = Math.floor(Math.mod(s, 3600) / 60);
        return (h > 0 ? Face.two-digits(h) + "h" : "") + (h > 0 || m > 0 ? Face.two-digits(m) + "m" : "") + Face.two-digits(Math.mod(s, 60)) + "s";
    }
    // Miles where temperatures are in Fahrenheit, kilometres elsewhere, to a tenth.
    public pure function distance(m: int) -> string {
        let tenths = Math.round(Face.fahrenheit ? m / 160.934 : m / 100);
        return Math.floor(tenths / 10) + "." + Math.mod(tenths, 10) + (Face.fahrenheit ? " mi" : " km");
    }
}

component PageTitle inherits Text {
    width: 100 * Theme.unit;
    height: 12 * Theme.unit;
    color: white;
    font-family: "Noto Sans SemiCondensed ExtraLight";
    font-size: 9 * Theme.unit;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Caption inherits Text {
    width: 100 * Theme.unit;
    height: 8 * Theme.unit;
    color: #ffffffcc;
    font-size: 5 * Theme.unit;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component TodayPage {
    property <int> today: Face.activity-today;
    property <int> goal: Math.max(1, Face.activity-goal);
    // In whole degrees from 3 o'clock, as the filled arc comes: the filled run is 115..end.
    property <int> end: 115 + Math.round(Math.min(1, self.today / self.goal) * 310);

    for name in ["activity-arc/track", root.end > 115 ? "activity-arc/fill-" + (root.end - 115) : ""]: Image {
        x: ActivityArc.x;
        y: ActivityArc.x;
        width: ActivityArc.size;
        height: ActivityArc.size;
        source: Icons.get(name, self.width, self.height);
        colorize: name == "activity-arc/track" ? white : Activity.accent;
        opacity: name == "activity-arc/track" ? 0.25 : 1;
        visible: name != "";
    }

    Image {
        x: 44 * Theme.unit;
        y: 21 * Theme.unit;
        width: 12 * Theme.unit;
        height: 12 * Theme.unit;
        source: Icons.get("ios-walk", self.width, self.height);
        colorize: white;
    }

    Text {
        y: 33 * Theme.unit;
        width: 100 * Theme.unit;
        height: 22 * Theme.unit;
        text: Activity.grouped(root.today);
        color: white;
        font-size: root.today >= 10000 ? 15 * Theme.unit : 18 * Theme.unit;
        letter-spacing: -0.5 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Caption {
        y: 55 * Theme.unit;
        text: "steps";
        font-size: 6 * Theme.unit;
    }

    Caption {
        y: 64 * Theme.unit;
        text: Activity.distance(Face.activity-distance) + "  ·  " + Face.activity-kcal + " kcal";
        font-size: 4.5 * Theme.unit;
    }

    Caption {
        y: 78 * Theme.unit - Face.chin / 2;
        text: root.today >= root.goal ? "Goal reached" : "of " + Activity.grouped(root.goal);
        color: root.today >= root.goal ? Activity.accent : #ffffffcc;
        font-weight: 700;
    }
}

component WeekPage {
    property <[int]> days: Face.activity-days;
    property <int> goal: Math.max(1, Face.activity-goal);
    property <[string]> initials: ["S", "M", "T", "W", "T", "F", "S"];
    property <int> best: Math.max(self.goal, self.days.length >= 7 ? Math.max(self.days[0], self.days[1], self.days[2], self.days[3], self.days[4], self.days[5], self.days[6]) : 0);
    property <int> sum: self.days.length >= 7 ? self.days[0] + self.days[1] + self.days[2] + self.days[3] + self.days[4] + self.days[5] + self.days[6] : 0;
    // Where the bars stand and how tall the tallest is, above the flat tire.
    property <length> base: 70 * Theme.unit - Face.chin;
    property <length> tall: Math.min(40 * Theme.unit, 46 * Theme.unit - Face.chin);

    PageTitle {
        y: 10 * Theme.unit;
        text: "Last 7 days";
    }

    // The bars are tall for the best day or the goal, whichever is more.
    for steps[i] in root.days: Rectangle {
        x: 18 * Theme.unit + i * 9.5 * Theme.unit;
        y: root.base - self.height;
        width: 7 * Theme.unit;
        height: Math.max(1 * Theme.unit, root.tall * steps / root.best);
        border-radius: 1 * Theme.unit;
        background: Activity.accent;
        opacity: steps >= root.goal ? 1 : 0.55;
    }

    Rectangle {
        x: 16 * Theme.unit;
        y: root.base - root.tall * root.goal / root.best;
        width: 68 * Theme.unit;
        height: 0.5 * Theme.unit;
        background: white;
        opacity: 0.6;
    }

    for steps[i] in root.days: Text {
        x: 18 * Theme.unit + i * 9.5 * Theme.unit;
        y: root.base + 1 * Theme.unit;
        width: 7 * Theme.unit;
        height: 7 * Theme.unit;
        text: root.initials[Math.mod(Face.weekday + i + 1, 7)];
        color: i == root.days.length - 1 ? white : #ffffff99;
        font-size: 4.5 * Theme.unit;
        font-weight: i == root.days.length - 1 ? 700 : 300;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Caption {
        y: root.base + 9 * Theme.unit;
        text: "Average " + Activity.grouped(Math.round(root.sum / 7));
        font-size: 4.5 * Theme.unit;
        font-weight: 700;
    }
}

// The logged rates of the last day as dots, a day ago at the left and now at the right, from 40
// bpm at the bottom to 180 at the top, and how often to log.
component HeartPage {
    property <[HeartPoint]> log: Face.heart-log;
    property <int> low: 40;
    property <int> high: 180;
    property <int> choice: Face.hr-interval == 10 ? 1 : Face.hr-interval == 30 ? 2 : Face.hr-interval == 60 ? 3 : 0;

    PageTitle {
        y: 10 * Theme.unit;
        text: "Heart rate";
    }

    Rectangle {
        x: 15 * Theme.unit;
        y: 25 * Theme.unit;
        width: 70 * Theme.unit;
        height: 34 * Theme.unit - Face.chin;

        for y in [60, 100, 140]: Rectangle {
            y: parent.height * (1 - (y - root.low) / (root.high - root.low));
            width: parent.width;
            height: 0.25 * Theme.unit;
            background: white;
            opacity: 0.2;
        }

        for p in root.log: Rectangle {
            x: parent.width * p.x / 1000 - 0.9 * Theme.unit;
            y: parent.height * (1 - (Math.clamp(p.bpm, root.low, root.high) - root.low) / (root.high - root.low)) - 0.9 * Theme.unit;
            width: 1.8 * Theme.unit;
            height: 1.8 * Theme.unit;
            border-radius: 0.9 * Theme.unit;
            background: #e23b4e;
        }

        if root.log.length == 0: Text {
            width: parent.width;
            height: parent.height;
            text: Face.hr-interval > 0 ? "No readings yet" : "Logging off";
            color: #ffffff99;
            font-size: 5 * Theme.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Caption {
        y: 59 * Theme.unit - Face.chin;
        text: root.log.length > 0 ? "Last " + root.log[root.log.length - 1].bpm + " bpm" : "";
        font-size: 4.5 * Theme.unit;
    }

    // A hub that logs the rate by itself does it every five minutes, on or off.
    if Face.has-passive: LabeledSwitch {
        y: 67 * Theme.unit - Face.chin;
        text: "Log every 5 min";
        checked: Face.hr-interval > 0;
        clicked => {
            Face.setting-set(Codes.setting-hr-interval, Face.hr-interval > 0 ? 0 : 5);
        }
    }

    if !Face.has-passive: LabeledSwitch {
        y: 67 * Theme.unit - Face.chin;
        text: "Measure every";
        value: ["Off", "10 min", "30 min", "60 min"][root.choice];
        clicked => {
            Face.setting-set(Codes.setting-hr-interval, [10, 30, 60, 0][root.choice]);
        }
    }
}

// While it runs: the time since the start, the steps and what they come to, the heart rate where
// the watch has the sensor, and Stop. Otherwise Start, with the last workout under it.
component WorkoutPage {
    property <bool> running: Face.workout-running;
    property <int> seconds: self.running ? Math.max(0, Face.now - Face.workout-start) : Face.workout-seconds;
    property <bool> any: self.running || Face.workout-seconds > 0;

    PageTitle {
        y: 10 * Theme.unit;
        text: "Workout";
        visible: !root.running;
    }

    if root.running: Text {
        y: 14 * Theme.unit;
        width: 100 * Theme.unit;
        height: 18 * Theme.unit;
        text: Activity.duration(root.seconds);
        color: white;
        font-size: 14 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.any: Caption {
        y: root.running ? 33 * Theme.unit : 54 * Theme.unit;
        text: root.running ? Activity.grouped(Face.workout-steps) + " steps" : "Last: " + Activity.duration(root.seconds) + "  ·  " + Activity.grouped(Face.workout-steps) + " steps";
        font-size: root.running ? 6 * Theme.unit : 4.5 * Theme.unit;
    }

    if root.any: Caption {
        y: root.running ? 41 * Theme.unit : 61 * Theme.unit;
        text: Activity.distance(Face.workout-distance) + "  ·  " + Face.workout-kcal + " kcal";
        font-size: 4.5 * Theme.unit;
    }

    if Face.has-heart-rate && root.running: Caption {
        y: 49 * Theme.unit;
        text: Face.heart-rate > 0 ? Face.heart-rate + " bpm" : "– bpm";
        color: #e23b4e;
        font-size: 6 * Theme.unit;
        font-weight: 700;
    }

    if Face.has-heart-rate && root.any && !root.running && Face.workout-avg-bpm > 0: Caption {
        y: 68 * Theme.unit;
        text: "Heart rate: " + Face.workout-avg-bpm + " avg, " + Face.workout-max-bpm + " max";
        font-size: 4.5 * Theme.unit;
    }

    Pill {
        x: 22.5 * Theme.unit;
        y: root.running ? 64 * Theme.unit : 28 * Theme.unit;
        text: root.running ? "Stop" : "Start";
        clicked => {
            Face.workout(!root.running);
        }
    }
}

component GoalPage {
    property <int> goal: Math.max(1, Face.activity-goal);
    // While the selector is held to drag, the pages stay put.
    out property <bool> tracking: selector.tracking;

    RowLabel {
        y: 6 * Theme.unit;
        text: "Daily step goal";
    }

    selector := IntSelector {
        y: 18 * Theme.unit;
        value: root.goal;
        min: 500;
        max: 20000;
        step: 500;
        text: Activity.grouped(self.value);
        down => {
            Face.setting-set(Codes.setting-step-goal, Math.max(500, root.goal - 500) / 500);
        }
        up => {
            Face.setting-set(Codes.setting-step-goal, Math.min(20000, root.goal + 500) / 500);
        }
        set(v) => {
            Face.setting-set(Codes.setting-step-goal, v / 500);
        }
    }

    Caption {
        y: 48 * Theme.unit;
        text: "Height and weight: Settings, Profile";
        font-size: 4.5 * Theme.unit;
    }
}

export component ActivityScreen {
    // Page kinds: 0 today, 1 week, 2 heart rate, 3 workout, 4 goal; the charts after today, then
    // the workout and the goal, as the other apps keep their actions and settings last.
    property <[int]> pages: Face.has-heart-rate ? [0, 1, 2, 3, 4] : [0, 1, 3, 4];
    property <int> page;

    width: 100%;
    height: 100%;

    property <bool> goal-tracking;

    // Swiped sideways like the other apps' pages. A Scroller, so a swipe that starts on a
    // control still turns the page; it settles on the next page or the one before.
    list := Scroller {
        horizontal: true;
        enabled: !root.goal-tracking;
        width: 100 * Theme.unit;
        height: 100 * Theme.unit;
        content-width: root.pages.length * 100 * Theme.unit;
        give: 15 * Theme.unit;
        released(to) => {
            let at = root.page * 100 * Theme.unit;
            root.page = Math.clamp(to > at + 10 * Theme.unit ? root.page + 1 : to < at - 10 * Theme.unit ? root.page - 1 : root.page, 0, root.pages.length - 1);
            list.scroll-to(root.page * 100 * Theme.unit, 200ms);
        }

        for kind[k] in root.pages: Rectangle {
            x: k * 100 * Theme.unit;
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            visible: self.x - list.scroll > -100 * Theme.unit && self.x - list.scroll < 100 * Theme.unit;

            if kind == 0: TodayPage {
                width: 100%;
                height: 100%;
            }
            if kind == 1: WeekPage {
                width: 100%;
                height: 100%;
            }
            if kind == 2: HeartPage {
                width: 100%;
                height: 100%;
            }
            if kind == 3: WorkoutPage {
                width: 100%;
                height: 100%;
            }
            if kind == 4: GoalPage {
                width: 100%;
                height: 100%;
                changed tracking => {
                    root.goal-tracking = self.tracking;
                }
            }
        }
    }

    PageDot {
        x: (100 * Theme.unit - self.width) / 2;
        y: 94 * Theme.unit - Face.chin;
        count: root.pages.length;
        current: root.page;
        size: 2 * Theme.unit;
    }
}
