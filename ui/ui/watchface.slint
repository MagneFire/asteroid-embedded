// One Screen window per layer (see stack.h for how the layers are placed): the watchface
// (AsteroidOS's default digital one or the classic one), the notifications, Today, the
// launcher, the quick settings, the open app, and the overlay drawn over all of them. A
// single exported root keeps the fonts embedded once.
import "../fonts/NotoSans-Light.ttf";
import "../fonts/NotoSans-Bold.ttf";
import "../fonts/Roboto-Medium.ttf";
import "../fonts/Roboto-Light.ttf";
import "../fonts/Raleway-Light.ttf";
import { DigitalFace } from "digital.slint";
import { Face, Note, Day, AlarmItem, Watchface } from "face.slint";
import { NoteList } from "notes.slint";
import { TodayScreen } from "today.slint";
import { Launcher } from "launcher.slint";
import { AppScreen } from "apps.slint";
import { QuickSettings } from "quick.slint";
import { Overlay } from "overlay.slint";
import { Apps } from "launcher.slint";
export { Face, Note, Day, AlarmItem, Apps }

export component Screen inherits Window {
    in property <int> kind;

    background: transparent;
    default-font-family: "Noto Sans";
    default-font-weight: 300;

    if root.kind == 0 && Face.watchface == 0: DigitalFace { }
    if root.kind == 0 && Face.watchface == 1: Watchface { }
    if root.kind == 1: NoteList { }
    if root.kind == 2: TodayScreen { }
    if root.kind == 3: Launcher { }
    if root.kind == 4: Overlay { }
    if root.kind == 5: QuickSettings { }
    if root.kind == 6: AppScreen { }
}
