// The music app, laid out as asteroid-music: the title and artist scrolling along the top,
// previous and next arrows at the edges, a large play/pause button in the middle, and volume
// buttons around a thin level bar. Without a connected phone it shows a No data page instead.
import { Face } from "face.slint";
import { Codes } from "codes.slint";
import { IconButton, Marquee, StatusPage } from "controls.slint";

export component MusicScreen {
    width: 100%;
    height: 100%;

    if !Face.bluetooth-connected: StatusPage {
        icon: @image-url("../icons/ios-sync.svg");
        title: "No data";
        text: "Sync AsteroidOS with your phone.";
    }

    if Face.bluetooth-connected: Rectangle {
        Marquee {
            x: 80px;
            y: 28px;
            width: 240px;
            height: 40px;
            text: Face.media-title;
            font-weight: 700;
        }

        Marquee {
            x: 60px;
            y: 64px;
            width: 280px;
            height: 40px;
            text: Face.media-artist;
        }

        IconButton {
            x: 12px;
            y: 160px;
            icon: @image-url("../icons/ios-arrow-dropleft.svg");
            clicked => {
                Face.media-action(Codes.ui-media-previous);
            }
        }

        IconButton {
            x: 120px;
            y: 120px;
            size: 160px;
            icon: Face.media-playing ? @image-url("../icons/ios-pause.svg") : @image-url("../icons/ios-play.svg");
            clicked => {
                Face.media-action(Face.media-playing ? Codes.ui-media-pause : Codes.ui-media-play);
            }
        }

        IconButton {
            x: 308px;
            y: 160px;
            icon: @image-url("../icons/ios-arrow-dropright.svg");
            clicked => {
                Face.media-action(Codes.ui-media-next);
            }
        }

        IconButton {
            x: 64px;
            y: 272px;
            icon: @image-url("../icons/ios-volume-down.svg");
            clicked => {
                Face.media-action(Codes.ui-media-volume-down);
            }
        }

        Rectangle {
            x: 144px;
            y: 308px;
            width: 112px;
            height: 8px;
            border-radius: 4px;
            background: #ffffff99;
            clip: true;

            if Face.media-volume >= 0: Rectangle {
                x: 0;
                width: parent.width * Face.media-volume / 100;
                height: parent.height;
                background: white;
            }
        }

        IconButton {
            x: 256px;
            y: 272px;
            icon: @image-url("../icons/ios-volume-up.svg");
            clicked => {
                Face.media-action(Codes.ui-media-volume-up);
            }
        }
    }
}
