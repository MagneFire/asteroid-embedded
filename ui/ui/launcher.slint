// The app launcher, below the watchface: the apps as round icons with their names, two to a
// row, centred. A tap opens the app over the screen stack.
import { Face } from "face.slint";

export struct App {
    id: int,
    name: string,
    icon: image,
}

export global Apps {
    out property <[App]> list: [
        { id: 0, name: "Music", icon: @image-url("../icons/ios-musical-notes.svg") },
        { id: 1, name: "Settings", icon: @image-url("../icons/ios-settings.svg") },
    ];
}

export component Launcher {
    property <length> cell: 120px;
    property <int> rows: (Apps.list.length + 1) / 2;

    width: 100%;
    height: 100%;

    for app[i] in Apps.list: Rectangle {
        property <int> line: i / 2;
        property <bool> alone: Math.mod(i, 2) == 0 && i == Apps.list.length - 1;
        x: alone ? (root.width - root.cell) / 2 : root.width / 2 + (Math.mod(i, 2) == 0 ? -root.cell : 0);
        y: (root.height - root.rows * root.cell) / 2 + self.line * root.cell;
        width: root.cell;
        height: root.cell;

        Rectangle {
            x: (parent.width - 72px) / 2;
            y: 8px;
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: touch.pressed ? #ffffff60 : #ffffff28;

            Image {
                x: (parent.width - 40px) / 2;
                y: (parent.height - 40px) / 2;
                width: 40px;
                height: 40px;
                source: app.icon;
                colorize: white;
            }
        }

        Text {
            x: 0;
            y: 84px;
            width: parent.width;
            height: 28px;
            text: app.name;
            color: white;
            font-size: 18px;
            horizontal-alignment: center;
        }

        touch := TouchArea {
            clicked => {
                Face.app-opened(app.id);
            }
        }
    }
}
