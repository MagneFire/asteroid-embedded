// The app launchers, below the watchface: AsteroidOS's seven layouts, one of which the Launcher
// setting picks. Each lays out the same apps (with AsteroidOS's names, order and colours), scrolls
// with a flick that coasts like a Qt ListView (1500 px/s/s) before snapping to the nearest item,
// and tells the firmware through Face which drags are its own, which app it is on (for the mesh
// colours) and which edges lead somewhere. size is the screen it is drawn for, so the selector can
// show it small. A tap opens the app over the screen stack.
import { Face } from "face.slint";
import { Codes } from "codes.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

export struct App {
    id: int,
    name: string,
    icon: string,
    center: color,
    outer: color,
}

export global Apps {
    // The Heart Rate app only where the watch has the sensor (Face.has-heart-rate).
    property <[App]> all: [
        { id: 2, name: "Alarm Clock", icon: "ios-alarm-outline", center: #CC9800, outer: #0C0500 },
        { id: 8, name: "Calculator", icon: "ios-calculator-outline", center: #7CA600, outer: #0C0B00 },
        { id: 9, name: "Diamonds", icon: "2048", center: #009933, outer: #000C00 },
        { id: 7, name: "Flashlight", icon: "ios-bulb-outline", center: #00A698, outer: #000C07 },
        { id: 6, name: "Heart Rate", icon: "ios-heart-outline", center: #0097A6, outer: #00060C },
        { id: 0, name: "Music", icon: "ios-musical-notes-outline", center: #2577B3, outer: #000619 },
        { id: 1, name: "Settings", icon: "ios-settings-outline", center: #0044A6, outer: #00010C },
        { id: 4, name: "Stopwatch", icon: "ios-stopwatch-outline", center: #9800A6, outer: #0C0009 },
        { id: 3, name: "Timer", icon: "ios-timer-outline", center: #A6005F, outer: #0C0003 },
        { id: 5, name: "Weather", icon: "launcher-cloudy-outline", center: #990019, outer: #0C0200 },
    ];
    property <[App]> without-heart-rate: [
        { id: 2, name: "Alarm Clock", icon: "ios-alarm-outline", center: #CC9800, outer: #0C0500 },
        { id: 8, name: "Calculator", icon: "ios-calculator-outline", center: #7CA600, outer: #0C0B00 },
        { id: 9, name: "Diamonds", icon: "2048", center: #009933, outer: #000C00 },
        { id: 7, name: "Flashlight", icon: "ios-bulb-outline", center: #00A698, outer: #000C07 },
        { id: 0, name: "Music", icon: "ios-musical-notes-outline", center: #2577B3, outer: #000619 },
        { id: 1, name: "Settings", icon: "ios-settings-outline", center: #0044A6, outer: #00010C },
        { id: 4, name: "Stopwatch", icon: "ios-stopwatch-outline", center: #9800A6, outer: #0C0009 },
        { id: 3, name: "Timer", icon: "ios-timer-outline", center: #A6005F, outer: #0C0003 },
        { id: 5, name: "Weather", icon: "launcher-cloudy-outline", center: #990019, outer: #0C0200 },
    ];
    out property <[App]> list: Face.has-heart-rate ? all : without-heart-rate;
    out property <[string]> layouts: ["Horizontal", "Vertical", "Three icons", "Two columns", "Turbo list", "Three by three", "Speed dial"];
}

// Scrolling along one axis in steps of item, count steps, with a flick that coasts: the average
// speed of the moves before the last one (timed by Face.touch-time(), full until 50 ms without a
// report and nothing from 100 ms) projected over a deceleration of 0.0015 px/ms^2, then rounded
// to a step. offset is where the content is, animate it with anim unless dragging: long enough
// for the ease-out to start at the finger's speed (at least 1 px/ms). tapped fires for a press
// that did not move.
// With cross set, a drag mostly across the axis is reported in cross-drag instead, and in
// crossed when let go.
export component Pager inherits TouchArea {
    in property <bool> horizontal: true;
    in property <length> item: 100 * Theme.unit;
    in property <int> count: 1;
    in property <bool> wrap;
    // At most this many items per flick, 0 for no limit.
    in property <int> limit;
    in property <bool> cross;
    in-out property <int> index;
    out property <length> drag;
    out property <bool> dragging;
    out property <length> cross-drag;
    out property <bool> crossing;
    out property <duration> anim: 150ms;
    // The last three speeds, newest last, and how many there are.
    property <float> v0;
    property <float> v1;
    property <float> v2;
    property <int> samples;
    property <length> last;
    property <int> last-ms;
    property <length> pos: self.horizontal ? self.mouse-x : self.mouse-y;
    property <length> start: self.horizontal ? self.pressed-x : self.pressed-y;
    property <length> across: self.horizontal ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x;
    callback tapped(length, length);
    callback crossed(length);

    // Goes to item i at once.
    public function jump(i: int) {
        self.anim = 0ms;
        self.index = i;
    }

    moved => {
        if self.cross && !self.dragging && !self.crossing && Math.abs(self.across) > 2.5 * Theme.unit && Math.abs(self.across) > Math.abs(self.pos - self.start) {
            self.crossing = true;
        }
        if self.crossing {
            self.cross-drag = self.across;
        } else if !self.dragging && Math.abs(self.pos - self.start) > 2.5 * Theme.unit {
            // The move that starts the drag is a speed too, from the press or the move before.
            self.dragging = true;
        } else if !self.dragging {
            self.last = self.pos;
            self.last-ms = Face.touch-time();
        }
        if self.dragging {
            self.drag = self.wrap ? self.pos - self.start : Math.clamp(self.pos - self.start, (self.index + 1 - self.count) * self.item, self.index * self.item);
            let dt = Face.touch-time() - self.last-ms;
            if dt > 0 {
                self.v0 = self.v1;
                self.v1 = self.v2;
                self.v2 = (self.pos - self.last) / (0.25 * Theme.unit) / dt;
                self.samples = Math.min(self.samples + 1, 3);
                self.last = self.pos;
                self.last-ms = Face.touch-time();
            }
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            self.dragging = false;
            self.crossing = false;
            self.drag = 0;
            self.cross-drag = 0;
            self.samples = 0;
            self.last = self.pos;
            self.last-ms = Face.touch-time();
        }
        if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
            if self.crossing {
                self.crossed(self.mouse-x > -250 * Theme.unit ? self.cross-drag : 0);
            } else if self.dragging && self.mouse-x > -250 * Theme.unit {
                // A lift is reported about 40 ms after the last move, so the speed only fades
                // from 50 ms without a report, to nothing at 100 ms.
                let avg = self.samples == 3 ? (self.v0 + self.v1) / 2 : self.samples == 2 ? self.v1 : 0;
                let held = Face.touch-time() - self.last-ms;
                let v = Math.clamp(held > 100 ? 0 : held < 50 ? avg : avg * (100 - held) / 50, -2.5, 2.5);
                let projected = (self.index * self.item - self.drag) / (0.25 * Theme.unit) - v * Math.abs(v) / 0.003;
                let free = Math.round(projected / (self.item / (0.25 * Theme.unit)));
                let n = self.limit > 0 ? Math.clamp(free, self.index - self.limit, self.index + self.limit) : free;
                let from = self.index * self.item - self.drag;
                self.index = self.wrap ? n : Math.clamp(n, 0, self.count - 1);
                self.anim = Math.max(1.7 * Math.abs(self.index * self.item - from) / (0.25 * Theme.unit) / Math.max(Math.abs(v), 1), 150) * 1ms;
            } else if e.kind == PointerEventKind.up && self.mouse-x >= 0 {
                self.tapped(self.mouse-x, self.mouse-y);
            }
            self.drag = 0;
            self.dragging = false;
            self.crossing = false;
            self.cross-drag = 0;
        }
    }
}

// 000-default-horizontal and 000-vertical: one app per page, a white disc with a grey icon and
// name.
component Pages {
    in property <length> size: 100 * Theme.unit;
    in property <bool> vertical;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <length> scroll: pager.index * self.size - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: self.size;
    height: self.size;

    function report() {
        if !root.preview {
            Face.launcher-position = root.scroll / root.size;
            Face.launcher-edges = 4 + (root.vertical ? (pager.index < Apps.list.length - 1 ? 8 : 0) + (pager.index == 0 ? 16 : 0) : (pager.index > 0 ? 1 : 0) + (pager.index < Apps.list.length - 1 ? 2 : 0));
        }
    }
    changed last => {
        pager.index = self.last ? Apps.list.length - 1 : 0;
    }
    init => {
        self.report();
    }
    changed scroll => {
        self.report();
    }

    for app[i] in Apps.list: Rectangle {
        x: root.vertical ? 0 : i * root.size - root.scroll;
        y: root.vertical ? i * root.size - root.scroll : 0;
        width: root.size;
        height: root.size;
        visible: self.x > -root.size && self.x < root.size && self.y > -root.size && self.y < root.size;

        Rectangle {
            x: (parent.width - 65 * Theme.unit * root.k) / 2;
            y: (parent.height - 65 * Theme.unit * root.k) / 2;
            width: 65 * Theme.unit * root.k;
            height: self.width;
            border-radius: self.width / 2;
            background: pager.pressed && !pager.dragging && pager.index == i ? #dddddd99 : #f8f8f8;
        }

        Image {
            x: (parent.width - 30 * Theme.unit * root.k) / 2;
            y: (parent.height - 30 * Theme.unit * root.k) / 2 - 3 * Theme.unit * root.k;
            width: 30 * Theme.unit * root.k;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: pager.pressed && !pager.dragging && pager.index == i ? #333 : #666;
        }

        Text {
            x: (parent.width - 50 * Theme.unit * root.k) / 2;
            y: (parent.height + 30 * Theme.unit * root.k) / 2 - 0.5 * Theme.unit * root.k;
            width: 50 * Theme.unit * root.k;
            text: app.name.to-uppercase();
            color: pager.pressed && !pager.dragging && pager.index == i ? #333 : #666;
            font-size: Math.round(20 * root.k) * (0.25 * Theme.unit);
            font-weight: 600;
            horizontal-alignment: center;
        }
    }

    pager := Pager {
        enabled: !root.preview;
        horizontal: !root.vertical;
        item: root.size;
        count: Apps.list.length;
        tapped => {
            Face.app-opened(Apps.list[self.index].id);
        }
    }
}

// 001-three-icons-horizontal: half-size discs, the current one centred with half of each
// neighbour beside it, names in white below.
component ThreeIcons {
    in property <length> size: 100 * Theme.unit;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <length> cell: self.size / 2;
    property <length> scroll: pager.index * self.cell - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: self.size;
    height: self.size;

    function report() {
        if !root.preview {
            Face.launcher-position = root.scroll / root.cell;
            Face.launcher-edges = 4 + (pager.index > 0 ? 1 : 0) + (pager.index < Apps.list.length - 1 ? 2 : 0);
        }
    }
    changed last => {
        pager.index = self.last ? Apps.list.length - 1 : 0;
    }
    init => {
        self.report();
    }
    changed scroll => {
        self.report();
    }

    for app[i] in Apps.list: Rectangle {
        x: root.size / 2 - root.cell / 2 + i * root.cell - root.scroll;
        y: (root.size - root.cell) / 2;
        width: root.cell;
        height: root.cell;

        Rectangle {
            x: parent.width * 0.1;
            y: parent.height * 0.1;
            width: parent.width * 0.8;
            height: self.width;
            border-radius: self.width / 2;
            background: pager.pressed && !pager.dragging && pager.index == i ? #cccccc : #f4f4f4;
        }

        Image {
            x: parent.width * 0.2;
            y: parent.height * 0.2;
            width: parent.width * 0.6;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: pager.pressed && !pager.dragging && pager.index == i ? #444 : #666;
        }

        Text {
            x: 0;
            y: parent.height * 0.92;
            width: parent.width;
            text: app.name.to-uppercase();
            color: white;
            font-size: Math.round(20 * root.k) * (0.25 * Theme.unit);
            font-family: "Noto Sans SemiCondensed Bold";
            horizontal-alignment: center;
        }
    }

    pager := Pager {
        enabled: !root.preview;
        item: root.cell;
        count: Apps.list.length;
        tapped(x, y) => {
            let i = self.index + Math.round((x - root.size / 2) / root.cell);
            if i >= 0 && i < Apps.list.length && Math.abs(y - root.size / 2) < root.cell / 2 {
                Face.app-opened(Apps.list[i].id);
            }
        }
    }
}

// 002-two-columns: two discs per row, the current row centred, scrolling by rows.
component TwoColumns {
    in property <length> size: 100 * Theme.unit;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <length> cell: self.size / 2;
    property <int> rows: Math.ceil(Apps.list.length / 2);
    property <length> scroll: pager.index * self.cell - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: self.size;
    height: self.size;

    function report() {
        if !root.preview {
            Face.launcher-position = 0;
            Face.launcher-edges = 4 + (pager.index < root.rows - 1 ? 8 : 0) + (pager.index == 0 ? 16 : 0);
        }
    }
    // Back at the first app whenever the watchface comes back.
    property <bool> home: Face.screen == 0;
    changed home => {
        if self.home && !self.preview {
            pager.jump(0);
        }
    }
    changed last => {
        pager.index = self.last ? root.rows - 1 : 0;
    }
    init => {
        self.report();
    }
    changed scroll => {
        self.report();
    }

    for app[i] in Apps.list: Rectangle {
        property <int> column: Math.mod(i, 2);
        x: (self.column == 0 ? 0 : root.cell) + (self.column == 0 ? 2.25 * Theme.unit : -2.25 * Theme.unit) * root.k;
        y: root.size / 2 - root.cell / 2 + Math.floor(i / 2) * root.cell - root.scroll;
        width: root.cell;
        height: root.cell;

        Rectangle {
            x: parent.width * 0.12;
            y: parent.height * 0.12;
            width: parent.width * 0.76;
            height: self.width;
            border-radius: self.width / 2;
            background: pager.pressed && !pager.dragging && root.touched == i ? #cccccc : #f4f4f4;
        }

        Image {
            x: parent.width * 0.225;
            y: parent.height * 0.225;
            width: parent.width * 0.55;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: #666;
        }

        Text {
            x: 0;
            y: parent.height * 0.89;
            width: parent.width;
            text: app.name.to-uppercase();
            color: white;
            font-size: Math.round(20 * root.k) * (0.25 * Theme.unit);
            font-family: "Noto Sans SemiCondensed Bold";
            horizontal-alignment: center;
        }
    }

    // The disc pressed, -1 for the space around them.
    property <int> touch-row: pager.index + Math.floor((pager.pressed-y - root.size / 2 + root.cell / 2) / root.cell);
    property <int> pick: self.touch-row * 2 + (pager.pressed-x > root.size / 2 ? 1 : 0);
    property <int> touched: self.touch-row >= 0 && self.pick < Apps.list.length ? self.pick : -1;

    pager := Pager {
        enabled: !root.preview;
        horizontal: false;
        item: root.cell;
        count: root.rows;
        tapped => {
            if root.touched >= 0 {
                Face.app-opened(Apps.list[root.touched].id);
            }
        }
    }
}

// 003-turbo-list: a list of small discs in each app's colour with its name, bending along the
// left of the round screen, shrinking and fading away from the centre row. No mesh colours.
component TurboList {
    in property <length> size: 100 * Theme.unit;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <length> line: self.size / 6;
    property <length> scroll: pager.index * self.line - pager.drag;
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: self.size;
    height: self.size;

    function report() {
        if !root.preview {
            Face.launcher-edges = 4 + (pager.index < Apps.list.length - 1 ? 8 : 0) + (pager.index == 0 ? 16 : 0);
        }
    }
    // Back at the first app whenever the watchface comes back.
    property <bool> home: Face.screen == 0;
    changed home => {
        if self.home && !self.preview {
            pager.jump(0);
        }
    }
    changed last => {
        pager.index = self.last ? Apps.list.length - 1 : 0;
    }
    init => {
        self.report();
    }
    changed scroll => {
        self.report();
    }

    for app[i] in Apps.list: Rectangle {
        property <length> d: i * root.line - root.scroll;
        property <length> r: root.size / 2;
        property <length> bezel: Math.abs(self.d) >= self.r ? self.r : self.r - Math.sqrt(Math.pow(self.r / (0.25 * Theme.unit), 2) - Math.pow(self.d / (0.25 * Theme.unit), 2)) * (0.25 * Theme.unit);
        property <float> n: 1 - self.bezel / self.r;
        x: self.bezel + 5 * Theme.unit * root.k;
        y: root.size / 2 - root.line / 2 + self.d;
        width: root.size - self.x;
        height: root.line;
        opacity: self.n;
        visible: self.n > 0.1;

        Rectangle {
            x: 0;
            y: parent.height * 0.1;
            width: parent.height * 0.8;
            height: self.width;
            border-radius: self.width / 2;
            background: app.center;
            opacity: pager.pressed && !pager.dragging && pager.index == i ? 0.8 : 1;
        }

        Image {
            x: parent.height * 0.4 - self.width / 2;
            y: parent.height * 0.5 - self.width / 2;
            width: parent.height * 0.56;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: white;
            opacity: 0.9;
        }

        Text {
            x: parent.height * 0.8 + 4 * Theme.unit * root.k;
            width: parent.width - self.x;
            height: parent.height;
            text: app.name;
            color: white;
            font-size: Math.round((Math.pow(2.71828, parent.n) - 1) * 6 * root.k) * 1 * Theme.unit;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    pager := Pager {
        enabled: !root.preview;
        horizontal: false;
        item: root.line;
        count: Apps.list.length;
        tapped(x, y) => {
            let i = self.index + Math.round((y - root.size / 2) / root.line);
            if i >= 0 && i < Apps.list.length {
                Face.app-opened(Apps.list[i].id);
            }
        }
    }
}

// 004-three-by-three: a grid of discs three to a row, icons only, scrolling by rows between half
// a row of space at both ends. Holding a disc for 200 ms slides the app's name in on a band in its
// colour, 144 px above the centre when held in the lower half, otherwise below, for a second;
// letting go still opens the app. No mesh colours.
component ThreeByThree {
    in property <length> size: 100 * Theme.unit;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <length> margin: self.size * 0.026;
    property <length> cell: (self.size - 2 * self.margin) / 3;
    property <length> spacer: self.size / 6;
    property <int> rows: Math.ceil(Apps.list.length / 3);
    property <length> content: 2 * self.spacer + self.rows * self.cell;
    property <int> stops: Math.max(1, Math.ceil((self.content - self.size) / self.cell) + 1);
    property <length> scroll: Math.min(pager.index * self.cell, Math.max(0, self.content - self.size)) - pager.drag;
    property <int> held: -1;
    // The title: 0 hidden, 1 sliding in and shown, 2 sliding out; away is where it slides from.
    property <int> title;
    property <length> away: (self.held-y > self.size * 0.48 ? -62 * Theme.unit : 62 * Theme.unit) * self.k;
    property <length> held-y;
    property <bool> titled;
    property <bool> pressed: pager.pressed;
    changed pressed => {
        if self.pressed {
            self.titled = false;
        }
    }
    animate scroll {
        duration: pager.dragging ? 0ms : pager.anim;
        easing: ease-out;
    }

    width: self.size;
    height: self.size;

    function report() {
        if !root.preview {
            Face.launcher-edges = 4 + (pager.index < root.stops - 1 ? 8 : 0) + (pager.index == 0 ? 16 : 0);
        }
    }
    // Back at the first app whenever the watchface comes back.
    property <bool> home: Face.screen == 0;
    changed home => {
        if self.home && !self.preview {
            pager.jump(0);
        }
    }
    changed last => {
        pager.index = self.last ? root.stops - 1 : 0;
    }
    init => {
        self.report();
    }
    changed scroll => {
        self.report();
    }

    // The disc pressed, -1 for the space around them.
    property <int> touch-row: Math.floor((pager.pressed-y + root.scroll - root.spacer) / root.cell);
    property <int> touch-column: Math.floor((pager.pressed-x - root.margin) / root.cell);
    property <int> touched: self.touch-row >= 0 && self.touch-column >= 0 && self.touch-column < 3 && self.touch-row * 3 + self.touch-column < Apps.list.length ? self.touch-row * 3 + self.touch-column : -1;

    for app[i] in Apps.list: Rectangle {
        property <bool> down: pager.pressed && !pager.dragging && root.touched == i && !hold.running;
        x: root.margin + Math.mod(i, 3) * root.cell;
        y: root.spacer + Math.floor(i / 3) * root.cell - root.scroll;
        width: root.cell;
        height: root.cell;

        Rectangle {
            x: parent.width * 0.07;
            y: parent.height * 0.07;
            width: parent.width * 0.86;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.down ? app.center : #f4f4f4;
        }

        Image {
            x: parent.width * 0.199;
            y: parent.height * 0.199;
            width: parent.width * 0.602;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: parent.down ? white : #555;
        }
    }

    hold := Timer {
        interval: 200ms;
        running: pager.pressed && !pager.dragging && root.touched >= 0 && !root.titled;
        triggered => {
            root.titled = true;
            root.held = root.touched;
            root.held-y = pager.pressed-y;
            root.title = 1;
        }
    }

    Timer {
        interval: root.title == 1 ? 1100ms : 200ms;
        running: root.title > 0;
        triggered => {
            root.title = root.title == 1 ? 2 : 0;
        }
    }

    if root.held >= 0: Rectangle {
        property <length> offset: root.title == 1 ? root.away * 0.58 : root.away;
        animate offset {
            duration: root.title == 1 ? 100ms : root.title == 2 ? 200ms : 0ms;
            easing: ease-in-sine;
        }
        y: root.size / 2 + self.offset - self.height / 2;
        height: 24 * Theme.unit * root.k;
        opacity: root.title == 1 ? 1 : 0;
        animate opacity {
            duration: root.title == 2 ? 200ms : 0ms;
            easing: ease-in-sine;
        }

        Rectangle {
            y: (root.held-y > root.size * 0.48 ? -2 * Theme.unit : 2 * Theme.unit) * root.k;
            background: Apps.list[root.held].center;
            opacity: 0.85;
        }

        Text {
            width: parent.width;
            height: parent.height;
            text: Apps.list[root.held].name.to-uppercase();
            color: white;
            font-size: Math.round(36 * root.k) * (0.25 * Theme.unit);
            font-family: "Noto Sans Condensed Medium";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    pager := Pager {
        enabled: !root.preview;
        horizontal: false;
        item: root.cell;
        count: root.stops;
        tapped => {
            root.title = 0;
            if root.touched >= 0 {
                Face.app-opened(Apps.list[root.touched].id);
            }
        }
    }
}

// The discs of the speed dial, 45 degrees apart, or spread evenly around the wheel when there are
// fewer than eight, pos turning it. Only the eight nearest the selected one are shown, the seam
// at 9 o'clock being behind the bar. The held disc is lightened while pressed.
component Wheel {
    in property <length> size;
    in property <float> pos;
    in property <int> selected;
    in property <int> held: -1;
    property <int> n: Apps.list.length;
    property <int> slots: Math.min(self.n, 8);
    property <length> orbit: self.size * 0.355;
    property <length> disc: self.size / 3.5 * 0.8;

    for app[i] in Apps.list: Rectangle {
        property <float> d: Math.mod(Math.mod(i - root.pos + 4, root.n) + root.n, root.n) - 4;
        property <angle> a: self.d * 360deg / root.slots;
        visible: self.d < root.slots - 4;
        x: root.size / 2 + root.orbit * Math.cos(self.a) - root.disc / 2;
        y: root.size / 2 + root.orbit * Math.sin(self.a) - root.disc / 2;
        width: root.disc;
        height: root.disc;
        border-radius: root.disc / 2;
        background: (root.selected == i ? app.center : #f4f4f4).with-alpha(root.held == i ? 0.8 : 1);

        Image {
            x: root.disc * 0.15;
            y: root.disc * 0.15;
            width: root.disc * 0.7;
            height: self.width;
            source: Icons.get(app.icon, self.width, self.height);
            colorize: root.selected == i ? white : black;
            opacity: root.held == i ? 1 : 0.9;
        }
    }
}

// 005-speed-dial: the apps on a wheel, turned by dragging around it, the one at 3 o'clock
// selected: filled with its colour and named on a bar across the left. A pressed disc becomes the
// selected one until the wheel moves on to another app. Its mask hides the left half of the wheel
// behind the bar and fades it in above and below, to full at 1.6 times the bar's half height. The
// software renderer only clips to rectangles, so the wheel is drawn in the right half, the left
// half beyond the fade, and 4 px strips of the fade. A tap on a disc opens its app, one on the
// name the selected app; one between the discs does nothing.
//
// Let go, the wheel coasts like a PathView: from the average of the turning speeds before the
// last move (items/s, timed by Face.touch-time()), fading to nothing between 50 and 100 ms without a
// report, no coast under 75 px/s along the wheel, at most 2500 px/s, slowing by 10 items/s^2, for
// at most one turn less an app, ending on an app, at least a quarter app past where it was let go.
// A press stops it, and only stops it.
component SpeedDial {
    in property <length> size: 100 * Theme.unit;
    in property <bool> preview;
    // In a preview, at the last app instead of the first.
    in property <bool> last;
    property <float> k: self.size / (100 * Theme.unit);
    property <int> n: Apps.list.length;
    property <int> slots: Math.min(self.n, 8);
    property <angle> step: 360deg / self.slots;
    property <length> bar: self.size * 0.26;
    property <length> orbit: self.size * 0.355;
    property <length> disc: self.size / 3.5 * 0.8;
    // Physical pixels along the wheel per app.
    property <float> item-px: 2 * 3.14159265 * self.orbit / 1phx / self.slots;
    in-out property <int> index;
    property <angle> turn;
    // The turn the press stopped the wheel at, short of an app.
    property <angle> base;
    property <bool> turning;
    property <bool> pressing;
    property <int> touched: -1;
    property <bool> name-held;
    // The last three turning speeds, newest last, and how many there are.
    property <float> v0;
    property <float> v1;
    property <float> v2;
    property <int> samples;
    property <int> last-ms;
    property <angle> last-a;
    property <duration> anim: 300ms;
    property <float> pos: self.index - self.turn / self.step;
    animate pos {
        duration: root.turning ? 0ms : root.anim;
        easing: cubic-bezier(0.333, 0.667, 0.667, 1);
    }
    property <int> current: Math.mod(Math.mod(Math.round(self.pos), self.n) + self.n, self.n);
    property <int> selected: self.touched >= 0 ? self.touched : self.current;

    width: self.size;
    height: self.size;

    function wrap(i: int) -> int {
        return Math.mod(Math.mod(i, root.n) + root.n, root.n);
    }
    function report() {
        if !root.preview {
            // The pressed app's colours only while the wheel is at rest.
            Face.launcher-position = root.touched >= 0 && !root.turning && Math.abs(root.pos - root.index) < 0.001 ? root.touched : Math.mod(Math.mod(root.pos, root.n) + root.n, root.n);
            // A drag from the name moves the screen, not the wheel.
            Face.launcher-edges = 4 + (root.name-held ? 32 : 0);
        }
    }
    // Moves the wheel to a, an app, from where it is now, over t.
    function go(a: int, t: duration) {
        root.anim = t;
        root.index = a;
        root.turn = 0;
    }
    changed last => {
        self.index = self.last ? self.n - 1 : 0;
    }
    init => {
        self.report();
    }
    changed pos => {
        self.report();
    }
    changed touched => {
        self.report();
    }
    changed turning => {
        self.report();
    }
    changed name-held => {
        self.report();
    }
    changed current => {
        self.touched = -1;
    }

    Rectangle {
        x: -root.size * 0.4;
        y: (root.size - root.size * 0.26) / 2;
        width: root.size * 0.4 + root.size / 2 + root.size * 0.26 / 2 + root.orbit - root.disc / 2 - 1 * Theme.unit * root.k;
        height: root.size * 0.26;
        border-radius: self.height / 2;
        background: #00000066;
    }

    // The name at 12 % of the screen, made smaller to fit when it is too wide, as Text.Fit does.
    property <length> name-size: Math.round(48 * root.k) * (0.25 * Theme.unit);
    property <length> name-width: root.size * 0.66;
    measure := Text {
        visible: false;
        text: Apps.list[root.selected].name;
        font-size: root.name-size;
        font-family: "Noto Sans SemiCondensed Bold";
        letter-spacing: 0.2 * Theme.unit * root.k;
    }

    label := Text {
        x: root.size * 0.05;
        y: (root.size - self.height) / 2;
        width: root.name-width;
        height: root.name-size * 1.4;
        text: Apps.list[root.selected].name;
        color: white;
        opacity: root.name-held ? 0.5 : 1;
        font-size: root.name-size * Math.min(1, root.name-width / Math.max(measure.preferred-width, 1px));
        font-family: "Noto Sans SemiCondensed Bold";
        letter-spacing: 0.2 * Theme.unit * root.k * Math.min(1, root.name-width / Math.max(measure.preferred-width, 1px));
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    property <length> mask: root.bar / 2;
    property <length> fade: root.mask * 1.6;
    property <int> strips: Math.ceil((root.fade - root.mask) / (1 * Theme.unit));

    for part in [
        { x: 0.5, y: 0, w: 0.5, h: 1 },
        { x: 0, y: 0, w: 0.5, h: 0.5 - root.fade / root.size },
        { x: 0, y: 0.5 + root.fade / root.size, w: 0.5, h: 0.5 - root.fade / root.size },
    ]: Rectangle {
        x: part.x * root.size;
        y: part.y * root.size;
        width: part.w * root.size;
        height: part.h * root.size;
        clip: true;

        Wheel {
            x: -parent.x;
            y: -parent.y;
            size: root.size;
            pos: root.pos;
            selected: root.selected;
            held: root.pressing && !root.turning ? root.touched : -1;
        }
    }

    for j in root.strips * 2: Rectangle {
        property <length> d: root.mask + Math.mod(j, root.strips) * (root.fade - root.mask) / root.strips;
        x: 0;
        y: j < root.strips ? root.size / 2 - self.d - self.height : root.size / 2 + self.d;
        width: root.size / 2;
        height: (root.fade - root.mask) / root.strips;
        clip: true;
        opacity: (self.d + self.height / 2) / root.fade;

        Wheel {
            x: -parent.x;
            y: -parent.y;
            size: root.size;
            pos: root.pos;
            selected: root.selected;
            held: root.pressing && !root.turning ? root.touched : -1;
        }
    }

    TouchArea {
        enabled: !root.preview;
        property <angle> a: Math.atan2((self.mouse-y - root.size / 2) / (0.25 * Theme.unit), (self.mouse-x - root.size / 2) / (0.25 * Theme.unit));
        property <angle> a0: Math.atan2((self.pressed-y - root.size / 2) / (0.25 * Theme.unit), (self.pressed-x - root.size / 2) / (0.25 * Theme.unit));
        property <bool> on-name: self.mouse-x >= label.x && self.mouse-x < label.x + label.width && self.mouse-y >= label.y && self.mouse-y < label.y + label.height;
        property <bool> pressed-name;
        // A press that stopped the turning wheel, which only stops it.
        property <bool> stopped;
        // The app of the disc under the finger with the wheel at p, -1 between discs. Past the
        // eighth slot the disc shown is the one a turn back.
        function disc-at(p: float) -> int {
            let k = Math.round(p + self.a / root.step);
            let k2 = k - p >= root.slots - 4 ? k - root.slots : k - p < -4 ? k + root.slots : k;
            let c = (k2 - p) * root.step;
            let dx = (self.mouse-x - root.size / 2 - root.orbit * Math.cos(c)) / (0.25 * Theme.unit);
            let dy = (self.mouse-y - root.size / 2 - root.orbit * Math.sin(c)) / (0.25 * Theme.unit);
            return dx * dx + dy * dy < Math.pow(root.disc / 2 / (0.25 * Theme.unit), 2) ? root.wrap(k2) : -1;
        }

        moved => {
            // The name takes its own presses, as a label over the wheel: they do not turn it. A
            // drag from it moves the screen instead.
            if self.pressed-name {
                return;
            }
            let d = Math.mod(self.a - self.a0 + 540deg, 360deg) - 180deg;
            if !root.turning && Math.abs(d) > 4deg {
                // The move that starts the turn is a sample too, from the press or the move before.
                root.turning = true;
            } else if !root.turning {
                root.last-a = d;
                root.last-ms = Face.touch-time();
            }
            if root.turning {
                root.turn = root.base + d;
                let dt = Face.touch-time() - root.last-ms;
                if dt > 0 {
                    root.v0 = root.v1;
                    root.v1 = root.v2;
                    root.v2 = -(d - root.last-a) / root.step * 1000 / dt;
                    root.samples = Math.min(root.samples + 1, 3);
                    root.last-a = d;
                    root.last-ms = Face.touch-time();
                }
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.pressing = true;
                self.pressed-name = self.on-name;
                root.name-held = self.on-name;
            }
            if e.kind == PointerEventKind.down && !self.pressed-name {
                // Stops the wheel where it is.
                let p = root.pos;
                self.stopped = Math.abs(p - root.index) > 0.001 || root.turn != 0;
                root.anim = 0ms;
                root.index = Math.round(p);
                root.turn = (root.index - p) * root.step;
                root.base = root.turn;
                // Turning speeds are measured from the press.
                root.samples = 0;
                root.last-a = 0deg;
                root.last-ms = Face.touch-time();
                if !self.stopped && self.disc-at(p) >= 0 {
                    root.touched = self.disc-at(p);
                }
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && self.pressed-name {
                // A tap on the name opens the app selected then, the wheel coasting on.
                if e.kind == PointerEventKind.up && self.mouse-x >= 0 && self.on-name {
                    Face.app-opened(Apps.list[root.selected].id);
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                let from = root.pos;
                if root.turning && self.mouse-x > -250 * Theme.unit {
                    let avg = root.samples == 3 ? (root.v0 + root.v1) / 2 : root.samples == 2 ? root.v1 : 0;
                    let held = Face.touch-time() - root.last-ms;
                    // A lift is reported about 40 ms after the last move, so the speed only fades
                    // from 50 ms without a report, to nothing at 100 ms.
                    let v0 = held > 100 ? 0 : held < 50 ? avg : avg * (100 - held) / 50;
                    let v = Math.abs(v0) * root.item-px > 2500 ? (v0 > 0 ? 2500 : -2500) / root.item-px : v0;
                    if Math.abs(v) * root.item-px > 75 {
                        // A quarter app more, so a flick moves at least one app its way.
                        let dist = Math.min(root.n - 1, v * v / 20 + 0.25);
                        let to = Math.round(from + (v > 0 ? dist : -dist));
                        root.go(to, Math.max(2000 * Math.abs(to - from) / Math.abs(v), 1) * 1ms);
                    } else {
                        root.go(Math.round(from), 300ms);
                    }
                } else {
                    if !root.turning && e.kind == PointerEventKind.up && self.mouse-x >= 0 && !self.stopped && root.touched >= 0 && self.disc-at(from) == root.touched {
                        Face.app-opened(Apps.list[root.touched].id);
                    }
                    root.go(Math.round(from), 300ms);
                }
            }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.turning = false;
                root.pressing = false;
                root.name-held = false;
            }
        }
    }
}

export component LauncherView {
    in property <length> size: 100 * Theme.unit;
    in property <int> layout;
    in property <bool> preview;
    in property <bool> last;

    width: self.size;
    height: self.size;

    if root.layout == 0: Pages { size: root.size; preview: root.preview; last: root.last; }
    if root.layout == 1: Pages { size: root.size; vertical: true; preview: root.preview; last: root.last; }
    if root.layout == 2: ThreeIcons { size: root.size; preview: root.preview; last: root.last; }
    if root.layout == 3: TwoColumns { size: root.size; preview: root.preview; last: root.last; }
    if root.layout == 4: TurboList { size: root.size; preview: root.preview; last: root.last; }
    if root.layout == 5: ThreeByThree { size: root.size; preview: root.preview; last: root.last; }
    if root.layout == 6: SpeedDial { size: root.size; preview: root.preview; last: root.last; }
}

export component Launcher {
    width: 100%;
    height: 100%;

    LauncherView {
        layout: Face.launcher;
    }
}
