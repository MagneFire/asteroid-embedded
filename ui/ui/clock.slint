// The timer, laid out as asteroid-timer, and the stopwatch. The firmware keeps both running, also
// while the app is closed or the watch sleeps, and shows their state in Face; clock-action takes
// 20 to start or pause the timer, 30 to start or stop the stopwatch and 31 to reset it, and
// timer-set the timer's duration in seconds.
import { Face } from "face.slint";
import { IconButton, Spinner } from "controls.slint";

component Button inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> size: 56px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.pressed ? #ffffff70 : #ffffff30;

    if root.label != "": Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: white;
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.label == "": Image {
        x: (parent.width - parent.width * 0.5) / 2;
        y: (parent.height - parent.height * 0.5) / 2;
        width: parent.width * 0.5;
        height: parent.height * 0.5;
        source: root.icon;
        colorize: white;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Hours, minutes and seconds on three spinners with their unit raised beside each, and one
// button to start or pause. While it runs the spinners follow the time left; turned by hand
// they set a new duration.
export component TimerApp {
    property <int> left: Math.floor((Face.timer-ms + 999) / 1000);
    property <int> chosen: hours.value * 3600 + minutes.value * 60 + seconds.value;

    width: 100%;
    height: 100%;

    function follow() {
        if !Face.timer-running && root.left == root.chosen {
            return;
        }
        hours.show(Math.floor(root.left / 3600));
        minutes.show(Math.mod(Math.floor(root.left / 60), 60));
        seconds.show(Math.mod(root.left, 60));
    }
    changed left => {
        self.follow();
    }
    changed chosen => {
        if !Face.timer-running && self.chosen != self.left && self.chosen > 0 {
            Face.timer-set(self.chosen);
        }
    }

    hours := Spinner {
        x: 64px;
        y: 59px;
        width: 53px;
        height: 280px;
        count: 24;
        wrap: false;
        interactive: !Face.timer-running;
        value: Math.floor(root.left / 3600);
    }

    minutes := Spinner {
        x: 116px;
        y: 59px;
        width: 167px;
        height: 280px;
        count: 60;
        wrap: false;
        interactive: !Face.timer-running;
        value: Math.mod(Math.floor(root.left / 60), 60);
    }

    seconds := Spinner {
        x: 283px;
        y: 59px;
        width: 53px;
        height: 280px;
        count: 60;
        wrap: false;
        interactive: !Face.timer-running;
        value: Math.mod(root.left, 60);
    }

    for unit[i] in ["h", "m", "s"]: Text {
        x: [120px, 234px, 337px][i] - 15px;
        y: 160px;
        width: 30px;
        height: 36px;
        text: unit;
        color: white;
        opacity: 0.9;
        font-family: "Roboto";
        font-weight: 500;
        font-size: 26px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.chosen > 0 || Face.timer-running: IconButton {
        x: 160px;
        y: 308px;
        icon: Face.timer-running ? @image-url("../icons/ios-pause.svg") : @image-url("../icons/ios-timer-outline.svg");
        clicked => {
            Face.clock-action(20);
        }
    }
}

export component StopwatchApp {
    property <int> tenths: Math.floor(Face.stopwatch-ms / 100);

    width: 100%;
    height: 100%;

    Text {
        x: 0;
        y: root.height * 0.3;
        width: root.width;
        height: root.height * 0.2;
        text: Face.two-digits(Math.floor(root.tenths / 600)) + ":" + Face.two-digits(Math.mod(Math.floor(root.tenths / 10), 60)) + "." + Math.mod(root.tenths, 10);
        color: white;
        font-size: 64px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Button {
        x: root.width * 0.5 - 12px - self.width;
        y: root.height * 0.62;
        size: 64px;
        icon: Face.stopwatch-running ? @image-url("../icons/ios-pause.svg") : @image-url("../icons/ios-play.svg");
        clicked => {
            Face.clock-action(30);
        }
    }

    Button {
        x: root.width * 0.5 + 12px;
        y: root.height * 0.62;
        size: 64px;
        label: "Reset";
        clicked => {
            Face.clock-action(31);
        }
    }
}
