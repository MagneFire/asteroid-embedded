import { Theme } from "theme.slint";
// The watch state, in the Face global the firmware sets on every Screen, and the classic
// watchface: time, date, battery and today's weather. The always-on face (ambient) keeps only
// the time, date and battery, in white.
export struct Note {
    id: int,
    // The icon name, empty for the default.
    icon: string,
    app: string,
    summary: string,
    body: string,
    // RTC seconds when it arrived.
    time: int,
}

export struct Day {
    id: int,
    min: int,
    max: int,
}

// A tile of the Diamonds game: column and row (-1 while unused), value, whether it just merged
// and whether it slid to its place.
export struct Tile {
    x: int,
    y: int,
    val: int,
    pop: bool,
    anim: bool,
}

// An event of the Agenda app: its index in the agenda, start and end in minutes of the day, and
// its title.
export struct AgendaItem {
    index: int,
    start: int,
    end: int,
    title: string,
}

export struct AlarmItem {
    hour: int,
    minute: int,
    days: int,
    on: bool,
}

export global Face {
    in-out property <int> hour;
    in-out property <int> minute;
    in-out property <int> second;
    in-out property <int> weekday;
    in-out property <int> day;
    in-out property <int> month;
    in-out property <int> year: 2026;
    // Seconds since boot and the Bluetooth address, for About.
    in-out property <int> uptime;
    in-out property <string> bt-address;
    in-out property <int> battery-percent;
    in-out property <bool> charging;
    in-out property <bool> ambient;
    in-out property <int> watchface;
    in-out property <bool> nightstand;
    in-out property <bool> nightstand-on: true;
    in-out property <int> app: -1;
    // How many pages deep the open app is, and a count it watches to go one back. While the back
    // gesture drags the page on top aside, peek is how far, showing the page below in that strip.
    in-out property <int> app-depth;
    in-out property <int> back-count;
    in-out property <length> peek;
    in-out property <bool> peeking;
    in-out property <int> launcher;
    in-out property <float> launcher-position;
    // When the touch being handed to the UI was reported, in ms.
    in-out property <int> touch-ms;
    // touch-ms, or in the previewer, which does not set it, the time of the frame.
    public pure function touch-time() -> int {
        return self.touch-ms != 0 ? self.touch-ms : animation-tick() / 1ms;
    }
    // The panel the screen stack has on screen, under any app: 0 the watchface, 1 the
    // notifications, 2 Today, 3 the launcher, 5 the quick settings.
    in-out property <int> screen;
    // Edges of the launcher leading somewhere (left, right, top, bottom as bits 0-3) and bit 4
    // while it is scrolled to its start.
    in-out property <int> launcher-edges: 4;
    // The same for the notifications, bit 4 while the newest is on screen.
    in-out property <int> notes-edges: 18;
    in-out property <int> brightness: 100;
    in-out property <bool> bluetooth-on: true;
    in-out property <bool> bluetooth-connected;
    in-out property <bool> bluetooth-bonded;
    // The heart rate in bpm while the Heart Rate app measures, 0 until there is one.
    in-out property <int> heart-rate;
    // The Activity app: steps today, the daily goal, and the last seven days, today last.
    in-out property <int> activity-today;
    in-out property <int> activity-goal: 8000;
    in-out property <[int]> activity-days: [0, 0, 0, 0, 0, 0, 0];
    // Whether the Flashlight app's light is on, read by the firmware for the brightness.
    in-out property <bool> flashlight-on: true;
    // The calculator's display text (digits grouped) and the length of the number it shows.
    in-out property <string> calc-shown: "0";
    in-out property <int> calc-length: 1;
    // The Diamonds game: its 16 tiles, score, best score and whether it is over.
    in-out property <[Tile]> game-tiles;
    in-out property <int> game-score;
    in-out property <int> game-best;
    in-out property <bool> game-over;
    // The events of the day the Agenda app shows, and today's.
    in-out property <[AgendaItem]> agenda;
    in-out property <[AgendaItem]> agenda-today;
    // RTC seconds, for the age of notifications.
    in-out property <int> now;
    in-out property <bool> vibration-on: true;
    in-out property <bool> aod-on: true;
    in-out property <bool> clock12;
    // Tilt-to-wake: 0 off, 1 wakes the screen, 2 shows the always-on face for a moment.
    in-out property <int> tilt: 1;
    in-out property <bool> tap-on: true;
    in-out property <bool> fahrenheit;
    in-out property <int> nightstand-brightness: 30;
    in-out property <int> nightstand-delay: 5;
    in-out property <bool> nightstand-aod: true;
    in-out property <bool> nightstand-rotate: true;
    // Burn-in protection: 0 off, 1 high, 2 medium, 3 low.
    in-out property <int> burn-in: 1;
    in-out property <bool> auto-brightness: true;
    in-out property <string> build;
    in-out property <[AlarmItem]> alarms;
    in-out property <bool> alarm-ringing;
    in-out property <bool> ringing-timer;
    in-out property <int> timer-ms: 300000;
    in-out property <int> timer-set-ms: 300000;
    in-out property <bool> timer-running;
    in-out property <int> stopwatch-ms;
    in-out property <bool> stopwatch-running;
    // The stopwatch's laps as its time at each, newest first.
    in-out property <[int]> stopwatch-laps;
    in-out property <int> passkey: -1;
    in-out property <bool> notification-shown;
    in-out property <int> notification-id;
    in-out property <string> notification-icon;
    // The watch's codename, whether it has a heart rate sensor, whether its screen is round,
    // whether it has a light sensor and whether its panel can burn in, from the firmware.
    in property <string> board;
    in property <bool> has-heart-rate: true;
    in property <bool> round-screen: true;
    in property <bool> has-light-sensor;
    in property <bool> has-burn-in: true;
    // The lines at the bottom the panel cuts off, AsteroidOS's flat tire.
    in property <length> chin;
    in-out property <string> notification-app;
    in-out property <string> notification-summary;
    in-out property <string> notification-body;
    in-out property <[Note]> notes;
    in-out property <string> media-title;
    in-out property <string> media-artist;
    in-out property <string> media-album;
    in-out property <bool> media-playing;
    in-out property <int> media-volume: -1;
    in-out property <bool> weather-valid;
    in-out property <string> weather-city;
    in-out property <Day> weather-today;
    in-out property <[Day]> weather-forecast;
    callback notification-opened(int);
    callback notification-dismissed(int);
    callback notifications-cleared();
    // A notification's id and for how many minutes to put it away.
    callback notification-snoozed(int, int);
    callback media-action(int);
    callback app-opened(int);
    callback setting-toggled(int);
    callback alarm-saved(int, int, int, int, bool);
    callback alarm-deleted(int);
    callback alarm-action(int);
    callback clock-action(int);
    callback timer-set(int);
    callback brightness-set(int);
    // A temperature in degrees Celsius as shown: in Celsius, or rounded to Fahrenheit.
    public pure function temperature(c: int) -> string {
        return self.fahrenheit ? Math.round(c * 9 / 5 + 32) + "°F" : c + "°C";
    }
    // The time of day in minutes, and a date, as set by hand.
    callback time-set(int);
    callback date-set(int, int, int);
    // An enum setting and the value to set it to.
    callback setting-set(int, int);
    // A calculator key, and a move in the Diamonds game.
    callback calc-key(int);
    callback game-move(int);
    // The day the Agenda app turned to; an event as saved (index, -1 for a new one, the day,
    // month and year, start and end in minutes) and an event deleted.
    callback agenda-day(int, int, int);
    callback agenda-saved(int, int, int, int, int, int);
    callback agenda-deleted(int);

    public pure function two-digits(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }

    public pure function condition(id: int) -> string {
        return id >= 200 && id < 300 ? "Thunderstorm" : id >= 300 && id < 400 ? "Drizzle" : id == 511 ? "Freezing rain" : id >= 500 && id < 600 ? "Rain" : id >= 600 && id < 700 ? "Snow" : id >= 700 && id < 800 ? "Mist" : id == 800 ? "Clear" : id == 801 ? "Partly cloudy" : id > 801 && id < 900 ? "Cloudy" : "Unknown";
    }

    public pure function weather-icon(id: int) -> string {
        return id >= 200 && id < 300 ? "ios-thunderstorm-outline" : id >= 300 && id < 400 ? "ios-drizzle-outline" : id == 511 ? "ios-snow-outline" : id >= 500 && id < 600 ? "ios-rainy-outline" : id >= 600 && id < 700 ? "ios-snow-outline" : id >= 700 && id < 800 ? "ios-cloudy-outline" : id == 800 ? "ios-sunny-outline" : id == 801 ? "ios-partly-sunny-outline" : id > 801 && id < 900 ? "ios-cloudy-outline" : "ios-alert-outline";
    }
}

export component Watchface {
    in property <length> size: 100 * Theme.unit;
    property <float> k: self.size / (100 * Theme.unit);
    property <bool> show-seconds;
    property <[string]> weekdays: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    property <[string]> months: ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    width: self.size;
    height: self.size;

    if Face.weather-valid && !Face.ambient: Text {
        x: root.width * 0.2;
        y: root.height * 0.08;
        width: root.width * 0.6;
        height: root.height * 0.07;
        text: Face.condition(Face.weather-today.id) + "  " + Face.weather-today.max + "° / " + Face.weather-today.min + "°";
        color: #ffffffc0;
        font-size: 5 * Theme.unit * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 0;
        y: root.show-seconds && !Face.ambient ? root.height * 0.17 : root.height * 0.22;
        width: root.width;
        height: root.height * 0.36;
        text: (Face.clock12 ? (Math.mod(Face.hour + 11, 12) + 1) + "" : Face.two-digits(Face.hour)) + ":" + Face.two-digits(Face.minute);
        color: white;
        font-size: 27.5 * Theme.unit * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate y { duration: Face.ambient ? 0ms : 250ms; easing: ease-out; }

        TouchArea {
            clicked => {
                root.show-seconds = !root.show-seconds;
            }
        }
    }

    Text {
        x: 0;
        y: root.show-seconds && !Face.ambient ? root.height * 0.5 : root.height * 0.46;
        width: root.width;
        height: root.height * 0.12;
        text: Face.two-digits(Face.second);
        color: white;
        font-size: 9 * Theme.unit * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.show-seconds && !Face.ambient ? 1 : 0;
        animate y, opacity { duration: Face.ambient ? 0ms : 250ms; easing: ease-out; }
    }

    Text {
        x: 0;
        y: root.height * 0.63;
        width: root.width;
        height: root.height * 0.08;
        text: root.weekdays[Face.weekday];
        color: white;
        font-size: 6 * Theme.unit * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0;
        y: root.height * 0.70;
        width: root.width;
        height: root.height * 0.08;
        text: Face.day + " " + root.months[Face.month - 1];
        color: white;
        font-size: 6 * Theme.unit * root.k;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: 0;
        width: root.width;
        y: root.height * 0.82;
        height: root.height * 0.07;
        spacing: 2 * Theme.unit;
        alignment: center;

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 0.25 * Theme.unit;
                Rectangle {
                    width: 7 * Theme.unit;
                    height: 3.5 * Theme.unit;
                    border-width: 0.375 * Theme.unit;
                    border-color: white;
                    border-radius: 0.5 * Theme.unit;
                    Rectangle {
                        x: 0.75 * Theme.unit;
                        y: 0.75 * Theme.unit;
                        width: (parent.width - 1.5 * Theme.unit) * clamp(Face.battery-percent, 0, 100) / 100;
                        height: parent.height - 1.5 * Theme.unit;
                        background: white;
                        opacity: Face.charging && !Face.ambient ? pulse : 1;
                        property <float> pulse: 0.55 + 0.45 * Math.sin(animation-tick() / 1s * 180deg);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 0.5 * Theme.unit;
                        height: 1.5 * Theme.unit;
                        background: white;
                    }
                }
            }
        }

        Text {
            text: (Face.charging ? "+" : "") + Face.battery-percent + "%";
            color: white;
            font-size: 5 * Theme.unit * root.k;
            vertical-alignment: center;
        }
    }
}
