// qml-asteroid's controls as the apps use them, at their sizes on this 400 px screen (Dims.l(x) is
// 4x px): PageHeader, IconButton, Spinner and CircularSpinner, StatusPage, PageDot, Marquee,
// ListItem, the ListRow family (LabeledSwitch, LabeledActionButton, IntSelector), RowSeparator,
// the notification pill button, and Page, which slides a pushed page in like LayerStack.
import { Face } from "face.slint";
import { Pager } from "launcher.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

// A title over a band that fades out downwards, 80 px tall.
export component PageHeader {
    in property <string> text;

    x: 0;
    y: 0;
    width: 100 * Theme.unit;
    height: 20 * Theme.unit;

    Rectangle {
        background: @linear-gradient(180deg, #000000dd 20%, #00000055 80%, #00000000 100%);
    }

    Text {
        x: 25 * Theme.unit;
        width: parent.width - 50 * Theme.unit;
        height: parent.height;
        text: root.text;
        color: white;
        font-family: "Noto Sans SemiCondensed Light";
        font-size: 7 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// An icon, 80 px and white by default, dimmed while pressed.
export component IconButton {
    in property <string> icon;
    in property <length> size: 20 * Theme.unit;
    in property <color> color: white;
    callback clicked();

    width: self.size;
    height: self.size;

    Image {
        width: parent.width;
        height: parent.height;
        source: Icons.get(root.icon, self.width, self.height);
        colorize: root.color;
        opacity: touch.pressed ? 0.7 : 1;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A vertical list taller than the screen, as a Flickable: drag it, or flick it to coast as Pager
// does (the same speeds and deceleration) to any position. A drag past either end follows the
// finger less and less, up to give, and a flick that reaches an end with speed left goes past it
// by up to 0.6 give and comes back. The children are the content, content-height tall, and
// scroll is how far down it is. released says where a drag let go is heading, and scroll-to
// moves the content over d. horizontal makes it a row content-width wide.
export component Scroller inherits SwipeGestureHandler {
    in property <bool> horizontal;
    in property <length> content-height;
    in property <length> content-width: self.width;
    in-out property <length> scroll;
    in property <length> give: 15 * Theme.unit;
    callback released(length);
    property <length> max: Math.max(0, self.horizontal ? self.content-width - self.width : self.content-height - self.height);
    property <duration> anim: 0ms;
    // Where the content was when the drag took it, and where it comes back to after going past an end.
    property <length> grab;
    property <length> rest;
    property <bool> tracking;
    property <float> v0;
    property <float> v1;
    property <float> v2;
    property <int> samples;
    property <length> last;
    property <int> last-ms;
    animate scroll {
        duration: root.swiping ? 0ms : root.anim;
        easing: ease-out;
    }

    handle-swipe-up: !self.horizontal;
    handle-swipe-down: !self.horizontal;
    handle-swipe-left: self.horizontal;
    handle-swipe-right: self.horizontal;

    function resist(e: length) -> length {
        return self.give > 0 ? self.give * (e / (e + 2 * self.give)) : 0;
    }
    public function scroll-to(to: length, d: duration) {
        back.running = false;
        self.anim = d;
        self.rest = to;
        self.scroll = to;
    }
    function release(moving: bool) {
        let avg = self.samples == 3 ? (self.v0 + self.v1) / 2 : self.samples == 2 ? self.v1 : 0;
        let held = Face.touch-time() - self.last-ms;
        let v = !moving ? 0 : Math.clamp(held > 100 ? 0 : held < 50 ? avg : avg * (100 - held) / 50, -2.5, 2.5);
        let from = self.scroll;
        let free = from - v * Math.abs(v) / 0.003 * (0.25 * Theme.unit);
        let to = Math.clamp(free, 0, self.max);
        let to-end = Math.abs(to - from) / (0.25 * Theme.unit);
        let left = v * v - 0.003 * to-end;
        let over = free != to && left > 0 ? 0.6 * self.give * Math.min(1, Math.sqrt(left) / 1.5) : 0px;
        self.anim = Math.max(1.7 * (to-end + over / (0.25 * Theme.unit)) / Math.max(Math.abs(v), 1), from < 0 || from > self.max ? 250 : 150) * 1ms;
        self.rest = to;
        self.scroll = to + (free > to ? over : -over);
        if over > 0 {
            back.interval = self.anim;
            back.running = true;
        }
        self.tracking = false;
        self.released(to);
    }

    back := Timer {
        running: false;
        interval: 150ms;
        triggered => {
            self.running = false;
            root.anim = 300ms;
            root.scroll = root.rest;
        }
    }

    changed pressed-position => {
        self.tracking = false;
    }
    // Content that changes height while it moves (rows that grow as they scroll up) must not
    // stop the move, so it is only cut short when where it goes is past the new end.
    changed max => {
        if !self.swiping && !back.running && (self.rest > self.max || self.scroll > self.max) {
            self.anim = 0ms;
            self.scroll = self.rest > self.max ? self.max : Math.min(self.scroll, self.max);
            self.rest = Math.min(self.rest, self.max);
        }
    }

    moved => {
        let y = self.horizontal ? self.current-position.x : self.current-position.y;
        if !self.tracking {
            // The first move of a press takes the content where it is, coasting or not.
            self.tracking = true;
            back.running = false;
            self.grab = self.scroll;
            self.samples = 0;
            self.last = y;
            self.last-ms = Face.touch-time();
        }
        if !self.swiping {
            return;
        }
        let raw = self.grab - (y - (self.horizontal ? self.pressed-position.x : self.pressed-position.y));
        self.scroll = raw < 0 ? -self.resist(-raw) : raw > self.max ? self.max + self.resist(raw - self.max) : raw;
        let dt = Face.touch-time() - self.last-ms;
        if dt > 0 {
            self.v0 = self.v1;
            self.v1 = self.v2;
            self.v2 = (y - self.last) / (0.25 * Theme.unit) / dt;
            self.samples = Math.min(self.samples + 1, 3);
            self.last = y;
            self.last-ms = Face.touch-time();
        }
    }
    swiped => {
        self.release(true);
    }
    cancelled => {
        self.release(false);
    }

    Rectangle {
        clip: true;

        Rectangle {
            x: root.horizontal ? -root.scroll : 0;
            y: root.horizontal ? 0 : -root.scroll;
            width: root.content-width;
            height: root.horizontal ? root.height : root.content-height;

            @children
        }
    }
}

// CircularSpinner (wrap) or Spinner with its SpinnerDelegate: count two-digit values or labels,
// one every 48 px, the one in the middle 39 px and opaque, the others 22 px at 60 %, and the top
// and bottom fifth fading out. twelve shows 0 as 12, first is added to the numbers shown, and
// plain shows them without a leading zero. show(v, d) turns it to v from outside over d.
export component Spinner {
    in property <int> count;
    in property <[string]> labels;
    in property <bool> twelve;
    in property <int> first;
    in property <bool> plain;
    in property <bool> wrap: true;
    in property <bool> interactive: true;
    in-out property <int> value;
    property <length> step: 12 * Theme.unit;
    property <length> scroll: pager.index * self.step - pager.drag;
    property <duration> shown: -1ms;
    property <bool> dragging: pager.dragging;
    animate scroll {
        duration: pager.dragging ? 0ms : self.shown >= 0ms ? self.shown : pager.anim;
        easing: ease-out;
    }

    public function show(v: int, d: duration) {
        self.shown = d;
        pager.index = v;
    }

    changed dragging => {
        self.shown = -1ms;
    }

    changed scroll => {
        self.value = Math.mod(Math.mod(Math.round(self.scroll / self.step), self.count) + self.count, self.count);
    }
    init => {
        pager.index = self.value;
    }

    for k in 9: Text {
        property <int> n: Math.floor(root.scroll / root.step) + k - 4;
        property <int> v: Math.mod(Math.mod(self.n, root.count) + root.count, root.count);
        property <length> mid: root.height / 2 - root.step / 2 + self.n * root.step - root.scroll;
        property <float> near: Math.max(0, 1 - Math.abs(self.mid + root.step / 2 - root.height / 2) / root.step);
        property <float> fade: Math.clamp(Math.min(self.mid + root.step / 2, root.height - self.mid - root.step / 2) / (root.height * 0.2), 0, 1);
        y: self.mid;
        width: root.width;
        height: root.step;
        visible: root.wrap || (self.n >= 0 && self.n < root.count);
        text: root.labels.length > 0 ? root.labels[self.v] : root.twelve && self.v == 0 ? "12" : root.plain ? (self.v + root.first) + "" : Face.two-digits(self.v + root.first);
        color: white;
        font-size: Math.round(22 + 17 * self.near) * (0.25 * Theme.unit);
        opacity: (0.6 + 0.4 * self.near) * self.fade;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    pager := Pager {
        enabled: root.interactive;
        horizontal: false;
        wrap: root.wrap;
        item: root.step;
        count: root.count;
    }
}

// A 100 px dark disc with an icon at (200, 148), tappable, and a title line (bigger, as the
// <h3> of the original) over a second line, the two centred on y = 260.
export component StatusPage {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    in property <bool> active;
    callback clicked();

    x: 0;
    y: 0;
    width: 100 * Theme.unit;
    height: 100 * Theme.unit;

    Rectangle {
        x: 37.5 * Theme.unit;
        y: 24.5 * Theme.unit;
        width: 25 * Theme.unit;
        height: 25 * Theme.unit;
        border-radius: 12.5 * Theme.unit;
        background: black;
        opacity: root.active ? 0.4 : 0.2;
    }

    Image {
        x: 40.5 * Theme.unit;
        y: 27.5 * Theme.unit;
        width: 19 * Theme.unit;
        height: 19 * Theme.unit;
        source: Icons.get(root.icon, self.width, self.height);
        colorize: white;
    }

    TouchArea {
        x: 37.5 * Theme.unit;
        y: 24.5 * Theme.unit;
        width: 25 * Theme.unit;
        height: 25 * Theme.unit;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        x: 4 * Theme.unit;
        y: 65 * Theme.unit - self.preferred-height / 2;
        width: 92 * Theme.unit;
        height: self.preferred-height;

        Text {
            text: root.title;
            color: white;
            font-size: 6 * Theme.unit;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.text;
            color: white;
            font-size: 5 * Theme.unit;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Dots of diameter size, a quarter apart, the current one opaque; extra adds a "+" at the end.
export component PageDot {
    in property <int> count;
    in property <int> current;
    in property <bool> extra;
    in property <length> size: 3 * Theme.unit;

    width: (self.count + (self.extra ? 1 : 0)) * self.size * 1.25 - self.size * 0.25;
    height: self.size;

    for i in root.count: Rectangle {
        x: i * root.size * 1.25;
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: white;
        opacity: i == root.current ? 1 : 0.5;
    }

    if root.extra: Text {
        x: root.count * root.size * 1.25;
        width: root.size;
        height: root.size;
        text: "+";
        color: white;
        opacity: root.current == root.count ? 1 : 0.5;
        font-size: Math.round(root.size / (0.25 * Theme.unit) * 1.4) * (0.25 * Theme.unit);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Text centred when it fits, otherwise held for 2 s, scrolled to its end and back, over and over,
// each way taking 1 s per box width of text.
export component Marquee inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 7 * Theme.unit;
    in property <int> font-weight: 300;
    property <length> over: Math.max(0, label.preferred-width - self.width);
    property <duration> travel: label.preferred-width / Math.max(0.25 * Theme.unit, self.width) * 1000ms;
    property <length> shift;
    property <int> phase;

    clip: true;

    label := Text {
        x: root.over > 0 ? -root.shift : (root.width - self.preferred-width) / 2;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        color: white;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
    }

    animate shift {
        duration: root.phase == 1 || root.phase == 3 ? root.travel : 0ms;
        easing: cubic-bezier(0.455, 0.03, 0.515, 0.955);
    }

    Timer {
        interval: root.phase == 0 ? 2000ms : root.phase == 2 ? 400ms : root.travel;
        running: root.over > 0;
        triggered => {
            root.phase = Math.mod(root.phase + 1, 4);
            root.shift = root.phase == 1 || root.phase == 2 ? root.over : 0;
        }
    }

    changed text => {
        self.phase = 0;
        self.shift = 0;
    }
}

// A row of the settings list: 84 px, a 60 px icon at x = 72, the title from x = 156 at 36 px,
// the whole row lit while pressed.
export component ListItem {
    in property <string> icon;
    in property <string> title;
    callback clicked();

    width: 100 * Theme.unit;
    height: 21 * Theme.unit;

    Rectangle {
        background: touch.pressed ? #ffffff33 : #ffffff00;
        animate background {
            duration: 150ms;
            easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
    }

    Image {
        x: 18 * Theme.unit;
        y: 3 * Theme.unit;
        width: 15 * Theme.unit;
        height: 15 * Theme.unit;
        source: Icons.get(root.icon, self.width, self.height);
        colorize: white;
    }

    Text {
        x: 39 * Theme.unit;
        width: parent.width - self.x - 2 * Theme.unit;
        height: parent.height;
        text: root.title;
        color: white;
        font-family: "Noto Sans SemiCondensed Light";
        font-size: 9 * Theme.unit;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The ListRow family: a 100 px row with a 24 px label from x = 60 to 236 and an 80 px action
// centred at x = 300, the whole row lit while pressed. LabeledSwitch shows a check circle,
// LabeledActionButton an icon, OptionCycler a value in 28 px semi-condensed bold; dim greys a row
// that does not apply.
export component LabeledSwitch {
    in property <string> text;
    in property <bool> checked;
    in property <string> icon;
    in property <string> value;
    in property <bool> dim;
    callback clicked();

    width: 100 * Theme.unit;
    height: 25 * Theme.unit;
    opacity: self.dim ? 0.4 : 1;
    animate opacity {
        duration: 200ms;
    }

    Rectangle {
        background: touch.pressed ? #ffffff33 : #ffffff00;
        animate background {
            duration: 150ms;
            easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
    }

    Text {
        x: 15 * Theme.unit;
        width: 44 * Theme.unit;
        height: parent.height;
        text: root.text;
        color: white;
        font-size: 6 * Theme.unit;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    if root.value == "": Image {
        x: 65 * Theme.unit;
        y: 2.5 * Theme.unit;
        width: 20 * Theme.unit;
        height: 20 * Theme.unit;
        source: Icons.get(root.icon != "" ? root.icon : root.checked ? "ios-checkmark-circle-outline" : "ios-circle-outline", self.width, self.height);
        colorize: white;
    }

    if root.value != "": Text {
        x: 59 * Theme.unit;
        width: 32 * Theme.unit;
        height: parent.height;
        text: root.value;
        color: white;
        font-family: "Noto Sans SemiCondensed Bold";
        font-size: 7 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// IntSelector: a 100 px row with a pill from x = 67 to 333, its fill showing value between min
// and max, "-" and "+" buttons at its ends, dimmed at the limits, and the value with its unit
// in the middle. Dragged sideways, or held for 800 ms, the pill sets the value from where the
// finger is, in steps of step, with a darker fill and a larger number meanwhile.
export component IntSelector {
    in property <int> value;
    in property <int> min;
    in property <int> max: 100;
    in property <int> step: 10;
    in property <string> unit: "%";
    // What it shows, the value with its unit unless given.
    in property <string> text: root.value + root.unit;
    callback down();
    callback up();
    callback set(int);
    out property <bool> tracking;

    function track(x: length) {
        let f = Math.clamp((x - 8.25 * Theme.unit) / (66.5 * Theme.unit - 16.5 * Theme.unit), 0, 1);
        let v = Math.clamp(Math.round((root.min + f * (root.max - root.min)) / root.step) * root.step, root.min, root.max);
        if v != root.value {
            root.set(v);
        }
    }

    width: 100 * Theme.unit;
    height: 25 * Theme.unit;

    Rectangle {
        x: 16.75 * Theme.unit;
        y: 4.25 * Theme.unit;
        width: 66.5 * Theme.unit;
        height: 16.5 * Theme.unit;
        border-radius: 8.25 * Theme.unit;
        border-width: 0.625 * Theme.unit;
        border-color: white;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * (root.value - root.min) / Math.max(1, root.max - root.min);
            height: parent.height;
            background: root.tracking ? #00000099 : #00000066;
            animate width {
                duration: root.tracking ? 0ms : 120ms;
                easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
            }
        }

        drag := TouchArea {
            moved => {
                if !root.tracking {
                    let dx = Math.abs(self.mouse-x - self.pressed-x);
                    let dy = Math.abs(self.mouse-y - self.pressed-y);
                    if (dx < 2 * Theme.unit && dy < 2 * Theme.unit) || dx < dy {
                        return;
                    }
                    root.tracking = true;
                }
                root.track(self.mouse-x);
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    root.tracking = false;
                }
            }
        }

        Timer {
            interval: 800ms;
            running: drag.pressed && !root.tracking;
            triggered => {
                root.tracking = true;
                root.track(drag.mouse-x);
            }
        }
    }

    Text {
        x: 16.75 * Theme.unit;
        y: 4.25 * Theme.unit;
        width: 66.5 * Theme.unit;
        height: 16.5 * Theme.unit;
        text: root.text;
        color: white;
        font-size: root.tracking ? 8.25 * Theme.unit : 6.5 * Theme.unit;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    IconButton {
        x: 15.25 * Theme.unit;
        y: 2.5 * Theme.unit;
        icon: "ios-remove";
        opacity: root.value <= root.min ? 0.3 : 1;
        clicked => {
            root.down();
        }
    }

    IconButton {
        x: 64.75 * Theme.unit;
        y: 2.5 * Theme.unit;
        icon: "ios-add";
        opacity: root.value >= root.max ? 0.3 : 1;
        clicked => {
            root.up();
        }
    }
}

// A label over a ListRow, as the settings pages title their selectors: 24 px, 48 px tall,
// bottom-aligned and centred.
export component RowLabel {
    in property <string> text;

    width: 100 * Theme.unit;
    height: 12 * Theme.unit;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: white;
        font-size: 6 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }
}

export component RowSeparator inherits Rectangle {
    width: 100 * Theme.unit;
    height: 0.25 * Theme.unit;
    background: #ffffff40;
}

// NotificationButton: a dark pill with a 32 px label.
export component Pill {
    in property <string> text;
    callback clicked();

    width: 55 * Theme.unit;
    height: 20 * Theme.unit;

    Rectangle {
        border-radius: self.height / 2;
        background: touch.pressed ? #22222299 : #222222bb;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: white;
        font-size: 8 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A page pushed on top of another, sliding in from the right over 200 ms like LayerStack, and
// following the back gesture aside (Face.peek).
export component Page {
    property <length> offset: 100 * Theme.unit;

    x: self.offset + Face.peek;
    y: 0;
    width: 100 * Theme.unit;
    height: 100 * Theme.unit;
    animate x {
        duration: Face.peeking ? 0ms : 200ms;
        easing: ease-out-quint;
    }

    init => {
        self.offset = 0;
    }

    @children
}

// RemorseTimer: black at 80 % over the screen with the action's name over a 3 s countdown and
// "Tap to cancel" below it, fading in over 300 ms; unless tapped, it then calls
// Face.setting-toggled with code. Started by setting code, and back at -1 when done.
export component Remorse inherits Rectangle {
    in-out property <int> code: -1;
    in property <string> action;
    property <duration> started;
    property <int> left: self.code >= 0 ? Math.max(1, 3 - Math.floor((animation-tick() - self.started) / 1s)) : 3;

    x: 0;
    y: 0;
    width: 100 * Theme.unit;
    height: 100 * Theme.unit;
    background: #000000cc;
    opacity: self.code >= 0 ? 1 : 0;
    visible: self.code >= 0 || self.opacity > 0;
    animate opacity {
        duration: 300ms;
    }

    changed code => {
        self.started = animation-tick();
    }

    Text {
        y: 32 * Theme.unit;
        width: 100 * Theme.unit;
        height: 6 * Theme.unit;
        text: root.action;
        color: white;
        font-size: 6 * Theme.unit;
        horizontal-alignment: center;
    }

    Text {
        y: 39 * Theme.unit;
        width: 100 * Theme.unit;
        height: 22 * Theme.unit;
        text: root.left;
        color: white;
        font-family: "Noto Sans SemiCondensed SemiBold";
        font-size: 18 * Theme.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        y: 62 * Theme.unit;
        width: 100 * Theme.unit;
        text: "Tap to cancel";
        color: white;
        font-size: 6 * Theme.unit;
        horizontal-alignment: center;
    }

    TouchArea {
        enabled: root.code >= 0;
        clicked => {
            root.code = -1;
        }
    }

    Timer {
        interval: 3000ms;
        running: root.code >= 0;
        triggered => {
            Face.setting-toggled(root.code);
            root.code = -1;
        }
    }
}
