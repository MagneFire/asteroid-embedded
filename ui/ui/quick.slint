// The quick settings above the watchface, laid out as AsteroidOS's quick panel: a fixed row with
// lock (to the always-on face) and Settings, a row of toggles three to a page, paged sideways,
// with dots for the pages, and the battery level as a bar and a number. An enabled toggle is a
// darker disc with a bright icon, a disabled one a faint disc with a faint icon. The numbers
// passed to setting-toggled are the firmware's enum setting, 15 to lock and 16 for Settings.
import { Face } from "face.slint";

component Toggle {
    in property <image> icon;
    in property <bool> on;
    in property <bool> button;
    in property <bool> held;
    in property <length> size: 112px;
    callback clicked();

    width: root.size;
    height: root.size;

    Rectangle {
        border-radius: root.size / 2;
        background: #222222;
        opacity: touch.pressed || root.held ? 1 : root.button ? 1 : root.on ? 0.75 : 0.2;
    }

    Image {
        x: (root.size - root.size / 2) / 2;
        y: (root.size - root.size / 2) / 2;
        width: root.size / 2;
        height: root.size / 2;
        source: root.icon;
        colorize: white;
        opacity: root.button || root.on ? 1 : 0.3;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component QuickSettings {
    property <int> pages: 2;
    in-out property <int> page;
    property <length> drag;
    property <bool> dragging;
    property <bool> swiped;
    property <length> strip: 3 * 112px + 2 * 16px;
    // The toggle under a press on the strip, which swipes between pages and so takes the press
    // from the toggles: an index into toggles, or -1.
    property <length> at: strip-touch.pressed-x + root.page * (root.strip + 16px);
    property <int> column: Math.floor(self.at / 128px);
    property <length> left: Math.mod(self.at / 1px, 128) * 1px;
    property <int> hit: root.page == 0 ? (self.column < 3 && self.left < 112px ? self.column : -1)
        : self.at - root.strip - 16px >= (root.strip - 112px) / 2 && self.at - root.strip - 16px < (root.strip + 112px) / 2 ? 3 : -1;
    property <int> held: strip-touch.pressed && !root.dragging ? root.hit : -1;

    width: 100%;
    height: 100%;

    Toggle {
        x: root.width / 2 - 16px - self.width;
        y: 38px;
        size: 96px;
        button: true;
        icon: @image-url("../icons/ios-unlock.svg");
        clicked => {
            Face.setting-toggled(15);
        }
    }

    Toggle {
        x: root.width / 2 + 16px;
        y: 38px;
        size: 96px;
        button: true;
        icon: @image-url("../icons/ios-settings.svg");
        clicked => {
            Face.setting-toggled(16);
        }
    }

    Rectangle {
        x: (root.width - root.strip) / 2;
        y: 144px;
        width: root.strip;
        height: 112px;
        clip: true;

        Rectangle {
            x: -root.page * (root.strip + 16px) + root.drag;
            width: root.pages * (root.strip + 16px);
            animate x {
                duration: root.dragging ? 0ms : 150ms;
                easing: ease-out;
            }

            HorizontalLayout {
                x: 0;
                width: root.strip;
                spacing: 16px;

                Toggle {
                    icon: @image-url("../icons/ios-sunny.svg");
                    on: true;
                    held: root.held == 0;
                    clicked => {
                        Face.setting-toggled(0);
                    }
                }

                Toggle {
                    icon: Face.bluetooth-on ? @image-url("../icons/ios-bluetooth.svg") : @image-url("../icons/ios-bluetooth-off-outline.svg");
                    on: Face.bluetooth-on;
                    held: root.held == 1;
                    clicked => {
                        Face.setting-toggled(1);
                    }
                }

                Toggle {
                    icon: @image-url("../icons/ios-watch-vibrating.svg");
                    on: Face.vibration-on;
                    held: root.held == 2;
                    clicked => {
                        Face.setting-toggled(2);
                    }
                }
            }

            HorizontalLayout {
                x: root.strip + 16px;
                width: root.strip;
                spacing: 16px;
                alignment: center;

                Toggle {
                    icon: Face.aod-on ? @image-url("../icons/ios-watch-aod-on.svg") : @image-url("../icons/ios-watch-aod-off.svg");
                    on: Face.aod-on;
                    held: root.held == 3;
                    clicked => {
                        Face.setting-toggled(3);
                    }
                }
            }
        }

        strip-touch := TouchArea {
            clicked => {
                if !root.swiped && root.hit >= 0 {
                    Face.setting-toggled(root.hit);
                }
            }
            moved => {
                if !root.dragging && Math.abs(self.mouse-x - self.pressed-x) > 10px {
                    root.dragging = true;
                    root.swiped = true;
                }
                if root.dragging {
                    root.drag = self.mouse-x - self.pressed-x;
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.swiped = false;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.dragging {
                    root.page = Math.clamp(root.page + (root.drag < -40px ? 1 : root.drag > 40px ? -1 : 0), 0, root.pages - 1);
                    root.drag = 0;
                    root.dragging = false;
                }
            }
        }
    }

    for i in root.pages: Rectangle {
        x: root.width / 2 + (i - (root.pages - 1) / 2) * 22px - 8px;
        y: 272px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        opacity: i == root.page ? 0.6 : 0.3;
    }

    Rectangle {
        x: (root.width - 202px) / 2;
        y: 304px;
        width: 202px;
        height: 32px;
        border-radius: 16px;
        background: #ffffff33;
        clip: true;

        Rectangle {
            width: parent.width * Face.battery-percent / 100;
            height: parent.height;
            background: #ffffff4d;
        }

        if Face.charging: Image {
            x: (parent.width - 32px) / 2;
            width: 32px;
            height: 32px;
            source: @image-url("../icons/ios-flash.svg");
            colorize: white;
        }
    }

    Text {
        x: 0;
        y: 340px;
        width: root.width;
        height: 50px;
        text: Face.battery-percent + "%";
        color: white;
        font-size: 36px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
