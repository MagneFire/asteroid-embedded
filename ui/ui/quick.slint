// The quick settings above the watchface, laid out as AsteroidOS's quick panel: a fixed row with
// lock (to the always-on face) and Settings, a row of toggles three to a page, paged sideways,
// with dots for the pages, and the battery level as a bar and a number. An enabled toggle is a
// darker disc with a bright icon, a disabled one a faint disc with a faint icon, a pressed one a
// lighter disc with a dimmed icon. The toggles start at their first page each time the panel
// comes in. The brightness toggle switches between 10 % and 100 %; held for 300 ms it turns into
// a bar across the panel, the rest fading out, that sets the brightness from where the finger is
// in steps of 10 %. Cinema mode turns the always-on face off until it is left again, and power
// off and reboot count down 3 s first. While charging the bolt pulses and the bar's end swings.
// The numbers passed to setting-toggled are the firmware's enum setting, 37 to lock, 38 for
// Settings, 39 to reboot, 40 to power off and 41 for cinema mode.
import { Face } from "face.slint";
import { Remorse } from "controls.slint";

component Toggle {
    in property <image> icon;
    in property <bool> on;
    in property <bool> button;
    in property <bool> held;
    in property <length> size: 112px;
    callback clicked();
    property <bool> down: touch.pressed || root.held;

    width: root.size;
    height: root.size;

    Rectangle {
        border-radius: root.size / 2;
        background: #222222;
        opacity: root.down ? 0.6 : root.button ? 1 : root.on ? 0.75 : 0.2;
    }

    Image {
        x: (root.size - root.size / 2) / 2;
        y: (root.size - root.size / 2) / 2;
        width: root.size / 2;
        height: root.size / 2;
        source: root.icon;
        colorize: root.down ? #d3d3d3 : white;
        opacity: root.down ? 0.5 : root.button || root.on ? 1 : 0.3;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component QuickSettings {
    in-out property <int> page;
    property <length> drag;
    property <bool> dragging;
    property <bool> swiped;
    property <length> strip: 3 * 112px + 2 * 16px;
    // The toggle under a press on the strip, which swipes between pages and so takes the press
    // from the toggles: an index into toggles, or -1.
    // The toggles in AsteroidOS's default order, without WiFi and sound: three to a page, the
    // last page's centred. A press is mapped to the toggle under it.
    property <[{icon: image, on: bool, button: bool}]> toggles: [
        { icon: @image-url("../icons/ios-sunny.svg"), on: Face.brightness > 10 },
        { icon: Face.bluetooth-connected ? @image-url("../icons/ios-bluetooth-connected.svg") : @image-url("../icons/ios-bluetooth.svg"), on: Face.bluetooth-on },
        { icon: @image-url("../icons/ios-watch-vibrating.svg"), on: Face.vibration-on },
        { icon: @image-url("../icons/ios-film-outline.svg"), on: !Face.aod-on },
        { icon: Face.aod-on ? @image-url("../icons/ios-watch-aod-on.svg") : @image-url("../icons/ios-watch-aod-off.svg"), on: Face.aod-on },
        { icon: @image-url("../icons/ios-power-outline.svg"), button: true },
        { icon: @image-url("../icons/ios-sync.svg"), button: true },
    ];
    property <int> pages: Math.ceil(self.toggles.length / 3);
    property <length> local: strip-touch.pressed-x - root.pad(root.page);
    property <int> column: Math.floor(self.local / 128px);
    property <int> hit: self.local >= 0 && self.column < Math.min(3, self.toggles.length - 3 * root.page) && Math.mod(self.local / 1px, 128) < 112 ? 3 * root.page + self.column : -1;
    property <int> held: strip-touch.pressed && !root.dragging ? root.hit : -1;
    property <bool> scrubbing;
    property <float> shown: root.scrubbing ? 0 : 1;
    animate shown {
        duration: 200ms;
        easing: cubic-bezier(0.455, 0.03, 0.515, 0.955);
    }
    property <bool> visible-now: Face.screen == 5 && Face.app < 0;
    property <bool> charging: Face.charging && self.visible-now;
    // The bolt's pulse between 1 and 0.7 over 3 s and the bar's swing over 1.5 s, run only while
    // the panel is on screen.
    property <float> pulse: self.charging ? 0.85 + 0.15 * Math.cos(Math.mod(animation-tick() / 1ms, 3000) / 3000 * 360deg) : 1;
    property <float> wave: self.charging ? Math.sin(Math.mod(animation-tick() / 1ms, 1500) / 1500 * 360deg) : 0;

    width: 100%;
    height: 100%;

    changed visible-now => {
        if self.visible-now {
            self.page = 0;
        }
    }

    // Where page p's toggles start in the strip.
    pure function pad(p: int) -> length {
        let n = Math.min(3, root.toggles.length - 3 * p);
        return (root.strip - n * 112px - (n - 1) * 16px) / 2;
    }

    function press(i: int) {
        if i == 0 {
            Face.brightness-set(Face.brightness > 10 ? 10 : 100);
        } else if i == 1 || i == 2 {
            Face.setting-toggled(i);
        } else if i == 3 {
            Face.setting-toggled(41);
        } else if i == 4 {
            Face.setting-toggled(3);
        } else if i == 5 {
            remorse.action = "Power Off";
            remorse.code = 40;
        } else if i == 6 {
            remorse.action = "Reboot";
            remorse.code = 39;
        }
    }

    // From the finger's x across the panel, 15 % in from each side being the ends.
    function scrub(x: length) {
        let f = Math.clamp((x - root.width * 0.15) / (root.width * 0.7), 0, 1);
        let v = Math.clamp(Math.round((10 + f * 90) / 10) * 10, 10, 100);
        if v != Face.brightness {
            Face.brightness-set(v);
        }
    }

    Toggle {
        x: root.width / 2 - 16px - self.width;
        y: 32px;
        size: 96px;
        button: true;
        opacity: root.shown;
        icon: @image-url("../icons/ios-unlock.svg");
        clicked => {
            Face.setting-toggled(37);
        }
    }

    Toggle {
        x: root.width / 2 + 16px;
        y: 32px;
        size: 96px;
        button: true;
        opacity: root.shown;
        icon: @image-url("../icons/ios-settings.svg");
        clicked => {
            Face.setting-toggled(38);
        }
    }

    Rectangle {
        x: (root.width - root.strip) / 2;
        y: 144px;
        width: root.strip;
        height: 112px;
        clip: true;

        Rectangle {
            x: -root.page * (root.strip + 16px) + root.drag;
            width: root.pages * (root.strip + 16px);
            opacity: root.shown;
            animate x {
                duration: root.dragging ? 0ms : 150ms;
                easing: ease-out;
            }

            for t[i] in root.toggles: Toggle {
                x: Math.floor(i / 3) * (root.strip + 16px) + root.pad(Math.floor(i / 3)) + Math.mod(i, 3) * 128px;
                icon: t.icon;
                on: t.on;
                button: t.button;
                held: root.held == i;
            }
        }

        Timer {
            interval: 300ms;
            running: root.held == 0 && !root.scrubbing && !root.swiped;
            triggered => {
                root.scrubbing = true;
                root.swiped = true;
                root.scrub(strip-touch.pressed-x + parent.x);
            }
        }

        strip-touch := TouchArea {
            clicked => {
                if !root.swiped && root.hit >= 0 {
                    root.press(root.hit);
                }
            }
            moved => {
                if root.scrubbing {
                    root.scrub(self.mouse-x + parent.x);
                    return;
                }
                if !root.dragging && Math.abs(self.mouse-x - self.pressed-x) > 10px {
                    root.dragging = true;
                    root.swiped = true;
                }
                if root.dragging {
                    root.drag = self.mouse-x - self.pressed-x;
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.swiped = false;
                }
                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    root.scrubbing = false;
                    if root.dragging {
                        root.page = Math.clamp(root.page + (root.drag < -40px ? 1 : root.drag > 40px ? -1 : 0), 0, root.pages - 1);
                        root.drag = 0;
                        root.dragging = false;
                    }
                }
            }
        }
    }

    for i in root.pages: Rectangle {
        x: root.width / 2 + (i - (root.pages - 1) / 2) * 20px - 8px;
        y: 272px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        opacity: (i == root.page ? 0.5 : 0.25) * root.shown;
    }

    Rectangle {
        x: (root.width - 202px) / 2;
        y: 304px;
        width: 202px;
        height: 32px;
        border-radius: 16px;
        background: #ffffff33;
        clip: true;
        opacity: root.shown;

        Rectangle {
            x: 0;
            width: parent.width * (Face.battery-percent / 100 + 0.05 * root.wave);
            height: parent.height;
            background: #ffffff4d;
        }

        if Face.charging: Image {
            x: (parent.width - 32px) / 2;
            width: 32px;
            height: 32px;
            source: @image-url("../icons/ios-flash.svg");
            colorize: white;
            opacity: root.pulse;
        }
    }

    Text {
        x: 0;
        y: 340px;
        width: root.width;
        height: 50px;
        text: Face.battery-percent + "%";
        color: white;
        opacity: root.shown;
        font-family: "Noto Sans Condensed Medium";
        font-size: 36px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // The brightness bar while scrubbing: the value where the fixed row was, the bar in the middle
    // and its name where the battery bar was.
    Rectangle {
        x: root.width * 0.1;
        y: (root.height - 80px) / 2;
        width: root.width * 0.8;
        height: 80px;
        border-radius: 40px;
        background: #212121bf;
        clip: true;
        opacity: 1 - root.shown;

        Rectangle {
            x: 0;
            width: parent.width * Face.brightness / 100;
            height: parent.height;
            background: #ffffff4d;
            animate width {
                duration: 80ms;
                easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
            }
        }
    }

    Text {
        x: 0;
        y: 32px;
        width: root.width;
        height: 112px;
        text: Face.brightness + "%";
        color: white;
        opacity: (1 - root.shown) * 0.9;
        font-family: "Noto Sans SemiCondensed SemiBold";
        font-size: 48px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0;
        y: 320px - 12px - 32px;
        width: root.width;
        height: 64px;
        text: "Brightness";
        color: white;
        opacity: (1 - root.shown) * 0.9;
        font-family: "Noto Sans Condensed Medium";
        font-size: 48px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    remorse := Remorse { }
}
