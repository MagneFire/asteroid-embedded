// The alarm app, laid out as AsteroidOS's asteroid-alarmclock: one alarm per page, swiped
// sideways with dots on top and a last page to add one. A page shows the time (tap to change it),
// the weekdays it repeats on (tap to change them), a switch and a delete button. Times are picked
// on two spinning wheels like qml-asteroid's CircularSpinner, weekdays on a Repetition page of
// day buttons; a new alarm goes through both. Changes go out through
// alarm-saved(index, hour, minute, days, on), index -1 for a new alarm, and alarm-deleted(index).
import { Face, AlarmItem } from "face.slint";
import { Pager } from "launcher.slint";
import { PageHeader, IconButton, Spinner } from "controls.slint";

global Days {
    // Monday first, as the bits of days (bit 0 Sunday) and their names.
    out property <[int]> order: [1, 2, 3, 4, 5, 6, 0];
    out property <[string]> letters: ["S", "M", "T", "W", "T", "F", "S"];
    out property <[string]> names: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    public pure function has(days: int, i: int) -> bool {
        return Math.mod(Math.floor(days / Math.pow(2, i)), 2) == 1;
    }

    public pure function named(days: int) -> string {
        return days == 0 ? "Once" : days == 62 ? "Weekdays" : days == 65 ? "Weekends" : days == 127 ? "Every day" : "";
    }
}

// The days of an alarm as asteroid-alarmclock writes them: a name for the usual sets, otherwise
// the initials from Monday with the days it rings on in white.
component DaysText {
    in property <int> days;
    in property <float> dim;

    if Days.named(root.days) != "": Text {
        width: parent.width;
        height: parent.height;
        text: Days.named(root.days);
        color: white;
        opacity: root.dim;
        font-size: 28px;
        vertical-alignment: center;
    }

    if Days.named(root.days) == "": HorizontalLayout {
        spacing: 7px;
        alignment: start;

        for d in Days.order: Text {
            text: Days.letters[d];
            color: white;
            opacity: Days.has(root.days, d) ? root.dim : root.dim * 0.5;
            font-size: 28px;
            font-weight: Days.has(root.days, d) ? 700 : 300;
            vertical-alignment: center;
        }
    }

    @children
}

export component AlarmApp {
    // 0 the alarms, 1 picking a time, 2 picking weekdays; index is the alarm being changed, -1
    // for a new one.
    property <int> page;
    property <int> index;
    property <int> hour;
    property <int> minute;
    property <int> days;
    property <int> back: Face.back-count;
    property <bool> room: Face.alarms.length < 8;
    property <int> pages: Face.alarms.length + (self.room ? 1 : 0);

    changed page => {
        Face.app-depth = self.page > 0 ? 1 : 0;
    }
    changed back => {
        self.page = 0;
    }

    width: 100%;
    height: 100%;

    if root.page == 0: Rectangle {
        property <length> scroll: list.index * root.width - list.drag;
        animate scroll {
            duration: list.dragging ? 0ms : list.anim;
            easing: ease-out;
        }

        list := Pager {
            item: root.width;
            count: root.pages;
        }

        for alarm[i] in Face.alarms: Rectangle {
            x: i * root.width - parent.scroll;
            width: root.width;
            height: root.height;
            visible: self.x > -root.width && self.x < root.width;

            HorizontalLayout {
                x: 40px;
                y: 120px;
                width: 200px;
                height: 70px;
                alignment: start;

                Text {
                    text: (Face.clock12 ? Face.two-digits(Math.mod(alarm.hour, 12)) : Face.two-digits(alarm.hour)) + ":" + Face.two-digits(alarm.minute);
                    color: white;
                    opacity: alarm.on ? 1 : 0.7;
                    font-size: Face.clock12 ? 52px : 60px;
                    font-weight: 500;
                }

                if Face.clock12: Text {
                    text: alarm.hour >= 12 ? "PM" : "AM";
                    color: white;
                    opacity: alarm.on ? 1 : 0.7;
                    font-size: 26px;
                    vertical-alignment: bottom;
                }
            }

            TouchArea {
                x: 40px;
                y: 120px;
                width: 200px;
                height: 70px;
                clicked => {
                    root.index = i;
                    root.hour = alarm.hour;
                    root.minute = alarm.minute;
                    root.days = alarm.days;
                    root.page = 1;
                }
            }

            DaysText {
                x: 40px;
                y: 200px;
                width: 200px;
                height: 40px;
                days: alarm.days;
                dim: alarm.on ? 0.8 : 0.5;

                TouchArea {
                    clicked => {
                        root.index = i;
                        root.hour = alarm.hour;
                        root.minute = alarm.minute;
                        root.days = alarm.days;
                        root.page = 2;
                    }
                }
            }

            Image {
                x: 240px;
                y: 120px;
                width: 120px;
                height: 120px;
                source: alarm.on ? @image-url("../icons/ios-checkmark-circle-outline.svg") : @image-url("../icons/ios-circle-outline.svg");
                colorize: white;

                TouchArea {
                    clicked => {
                        Face.alarm-saved(i, alarm.hour, alarm.minute, alarm.days, !alarm.on);
                    }
                }
            }

            IconButton {
                x: (root.width - self.width) / 2;
                y: root.height - 12px - self.height;
                icon: @image-url("../icons/ios-trash-circle.svg");
                clicked => {
                    Face.alarm-deleted(i);
                }
            }
        }

        if root.room: Rectangle {
            x: Face.alarms.length * root.width - parent.scroll;
            width: root.width;
            height: root.height;

            Rectangle {
                x: (root.width - 100px) / 2;
                y: root.height / 2 - 20px - 50px;
                width: 100px;
                height: 100px;
                border-radius: 50px;
                background: add.pressed ? #333333 : black;
                opacity: 0.2;
            }

            Image {
                x: (root.width - 100px) / 2 + 12px;
                y: root.height / 2 - 20px - 50px + 12px;
                width: 76px;
                height: 76px;
                source: @image-url("../icons/ios-add.svg");
                colorize: white;
            }

            Text {
                x: 8px;
                y: root.height / 2 + 60px - 20px;
                width: root.width - 16px;
                height: 40px;
                text: "Add an alarm";
                color: white;
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            add := TouchArea {
                x: root.width * 0.15;
                y: root.height * 0.15;
                width: root.width * 0.7;
                height: root.height * 0.7;
                clicked => {
                    root.index = -1;
                    root.hour = Face.hour;
                    root.minute = Face.minute;
                    root.days = 0;
                    root.page = 1;
                }
            }
        }

        if root.pages > 1: HorizontalLayout {
            x: (root.width - self.width) / 2;
            y: 36px;
            width: root.pages * 15px - 3px;
            height: 12px;
            spacing: 3px;

            for alarm[i] in Face.alarms: Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: white;
                opacity: list.index == i ? 1 : 0.5;
            }

            if root.room: Text {
                width: 12px;
                text: "+";
                color: white;
                opacity: list.index == Face.alarms.length ? 1 : 0.5;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.page == 1: Rectangle {
        property <length> w: Face.clock12 ? 120px : 180px;

        hours := Spinner {
            x: 20px;
            y: 80px;
            width: parent.w;
            height: 240px;
            count: Face.clock12 ? 12 : 24;
            twelve: Face.clock12;
            value: Face.clock12 ? Math.mod(root.hour, 12) : root.hour;
        }

        Rectangle {
            x: 20px + parent.w - 1px;
            y: 80px + 24px;
            width: 1px;
            height: 192px;
            background: #ffffff88;
        }

        minutes := Spinner {
            x: 20px + parent.w;
            y: 80px;
            width: parent.w;
            height: 240px;
            count: 60;
            value: root.minute;
        }

        if Face.clock12: Rectangle {
            x: 20px + 2 * parent.w - 1px;
            y: 80px + 24px;
            width: 1px;
            height: 192px;
            background: #ffffff88;
        }

        ampm := Spinner {
            x: 20px + 2 * parent.w;
            y: 80px;
            width: parent.w;
            height: 240px;
            visible: Face.clock12;
            count: 2;
            wrap: false;
            labels: ["AM", "PM"];
            value: root.hour >= 12 ? 1 : 0;
        }

        PageHeader {
            x: 0;
            y: 0;
            text: "Time";
        }

        IconButton {
            x: (root.width - self.width) / 2;
            y: root.height - 12px - self.height;
            icon: root.index < 0 ? @image-url("../icons/ios-arrow-dropright.svg") : @image-url("../icons/ios-checkmark-circle-outline.svg");
            clicked => {
                root.hour = hours.value + (Face.clock12 ? ampm.value * 12 : 0);
                root.minute = minutes.value;
                if root.index < 0 {
                    root.page = 2;
                } else {
                    Face.alarm-saved(root.index, root.hour, root.minute, root.days, true);
                    root.page = 0;
                }
            }
        }
    }

    if root.page == 2: Rectangle {
        PageHeader {
            x: 0;
            y: 0;
            text: "Repetition";
        }

        for d[k] in Days.order: Rectangle {
            x: k < 4 ? 40px + k * 80px : 80px + (k - 4) * 80px;
            y: k < 4 ? 120px : 200px;
            width: 80px;
            height: 80px;

            Rectangle {
                x: 4px;
                y: 4px;
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: #333333;
                opacity: Days.has(root.days, d) ? 0.7 : 0.2;
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: Days.names[d];
                color: white;
                opacity: Days.has(root.days, d) ? 1 : 0.4;
                font-size: 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.days += Days.has(root.days, d) ? -Math.pow(2, d) : Math.pow(2, d);
                }
            }
        }

        IconButton {
            x: (root.width - self.width) / 2;
            y: root.height - 12px - self.height;
            icon: root.index < 0 ? @image-url("../icons/ios-add-circle-outline.svg") : @image-url("../icons/ios-checkmark-circle-outline.svg");
            clicked => {
                Face.alarm-saved(root.index, root.hour, root.minute, root.days, true);
                root.page = 0;
            }
        }
    }
}
