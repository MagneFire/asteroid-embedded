// The alarm app, laid out as AsteroidOS's asteroid-alarmclock: one alarm per page, swiped
// sideways with dots on top and a last page to add one. A page shows the time (tap to change it),
// the weekdays it repeats on (tap to change them), a switch and a delete button. Times are picked
// on two spinning wheels like qml-asteroid's CircularSpinner, weekdays on a Repetition page of
// day buttons; a new alarm goes through both. Changes go out through
// alarm-saved(index, hour, minute, days, on), index -1 for a new alarm, and alarm-deleted(index).
import { Face, AlarmItem } from "face.slint";
import { Pager } from "launcher.slint";
import { PageHeader, IconButton, Spinner, Page } from "controls.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

global Days {
    // Monday first, as the bits of days (bit 0 Sunday) and their names.
    out property <[int]> order: [1, 2, 3, 4, 5, 6, 0];
    out property <[string]> letters: ["S", "M", "T", "W", "T", "F", "S"];
    out property <[string]> names: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    public pure function has(days: int, i: int) -> bool {
        return Math.mod(Math.floor(days / Math.pow(2, i)), 2) == 1;
    }

    public pure function named(days: int) -> string {
        return days == 0 ? "Once" : days == 62 ? "Weekdays" : days == 65 ? "Weekends" : days == 127 ? "Every day" : "";
    }
}

// The days of an alarm as asteroid-alarmclock writes them: a name for the usual sets, otherwise
// the initials from Monday with the days it rings on in bold.
component DaysText {
    in property <int> days;
    in property <float> dim;

    if Days.named(root.days) != "": Text {
        width: parent.width;
        height: parent.height;
        text: Days.named(root.days);
        color: white;
        opacity: root.dim;
        font-size: 7 * Theme.unit;
        vertical-alignment: center;
    }

    if Days.named(root.days) == "": HorizontalLayout {
        spacing: 1.75 * Theme.unit;
        alignment: start;

        for d in Days.order: Text {
            text: Days.letters[d];
            color: white;
            opacity: root.dim;
            font-size: 7 * Theme.unit;
            font-weight: Days.has(root.days, d) ? 700 : 300;
            vertical-alignment: center;
        }
    }

    @children
}

export component AlarmApp {
    // 0 the alarms, 1 picking a time, 2 picking weekdays; index is the alarm being changed, -1
    // for a new one.
    property <int> page;
    property <int> index;
    property <int> hour;
    property <int> minute;
    property <int> days;
    property <int> back: Face.back-count;
    property <bool> room: Face.alarms.length < 8;
    property <int> pages: Face.alarms.length + (self.room ? 1 : 0);

    changed page => {
        Face.app-depth = self.page > 0 ? 1 : 0;
    }
    changed back => {
        self.page = 0;
        Face.peek = 0;
        Face.peeking = false;
    }

    // Slides the page on top out to the right and the alarms back in, as LayerStack's pop does,
    // then leaves it.
    function pop() {
        Face.peeking = false;
        Face.peek = 100 * Theme.unit;
        popped.running = true;
    }
    popped := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.page = 0;
            Face.peek = 0;
        }
    }

    width: 100%;
    height: 100%;

    // Moved out to the left as a page slides in, and back in beside a page dragged back or
    // popped, kept meanwhile, as LayerStack keeps the layer below, so it comes back as it was.
    Rectangle {
        property <length> scroll: list.index * root.width - list.drag;
        animate scroll {
            duration: list.dragging ? 0ms : list.anim;
            easing: ease-out;
        }

        x: root.page == 0 ? 0 : Face.peek - 100 * Theme.unit;
        width: 100 * Theme.unit;
        animate x {
            duration: Face.peeking ? 0ms : 200ms;
            easing: ease-out-quint;
        }

        list := Pager {
            item: root.width;
            count: root.pages;
        }

        for alarm[i] in Face.alarms: Rectangle {
            x: i * root.width - parent.scroll;
            width: root.width;
            height: root.height;
            visible: self.x > -root.width && self.x < root.width;

            HorizontalLayout {
                x: 10 * Theme.unit;
                y: 30 * Theme.unit;
                width: 50 * Theme.unit;
                height: 17.5 * Theme.unit;
                alignment: start;

                Text {
                    text: (Face.clock12 ? Face.two-digits(Math.mod(alarm.hour, 12)) : Face.two-digits(alarm.hour)) + ":" + Face.two-digits(alarm.minute);
                    color: white;
                    opacity: alarm.on ? 1 : 0.7;
                    font-size: Face.clock12 ? 13 * Theme.unit : 15 * Theme.unit;
                    font-weight: 500;
                }

                if Face.clock12: Text {
                    text: alarm.hour >= 12 ? "PM" : "AM";
                    color: white;
                    opacity: alarm.on ? 1 : 0.7;
                    font-size: 6.5 * Theme.unit;
                    vertical-alignment: bottom;
                }
            }

            TouchArea {
                x: 10 * Theme.unit;
                y: 30 * Theme.unit;
                width: 50 * Theme.unit;
                height: 17.5 * Theme.unit;
                clicked => {
                    root.index = i;
                    root.hour = alarm.hour;
                    root.minute = alarm.minute;
                    root.days = alarm.days;
                    root.page = 1;
                }
            }

            DaysText {
                x: 10 * Theme.unit;
                y: 50 * Theme.unit;
                width: 50 * Theme.unit;
                height: 10 * Theme.unit;
                days: alarm.days;
                dim: alarm.on ? 0.8 : 0.5;

                TouchArea {
                    clicked => {
                        root.index = i;
                        root.hour = alarm.hour;
                        root.minute = alarm.minute;
                        root.days = alarm.days;
                        root.page = 2;
                    }
                }
            }

            Image {
                x: 60 * Theme.unit;
                y: 30 * Theme.unit;
                width: 30 * Theme.unit;
                height: 30 * Theme.unit;
                source: Icons.get(alarm.on ? "ios-checkmark-circle-outline" : "ios-circle-outline", self.width, self.height);
                colorize: white;

                TouchArea {
                    clicked => {
                        Face.alarm-saved(i, alarm.hour, alarm.minute, alarm.days, !alarm.on);
                    }
                }
            }

            IconButton {
                x: (root.width - self.width) / 2;
                y: root.height - 3 * Theme.unit - self.height;
                icon: "ios-trash-circle";
                clicked => {
                    Face.alarm-deleted(i);
                }
            }
        }

        if root.room: Rectangle {
            x: Face.alarms.length * root.width - parent.scroll;
            width: root.width;
            height: root.height;

            Rectangle {
                x: (root.width - 25 * Theme.unit) / 2;
                y: root.height / 2 - 5 * Theme.unit - 12.5 * Theme.unit;
                width: 25 * Theme.unit;
                height: 25 * Theme.unit;
                border-radius: 12.5 * Theme.unit;
                background: add.pressed ? #333333 : black;
                opacity: 0.2;
            }

            Image {
                x: (root.width - 25 * Theme.unit) / 2 + 3 * Theme.unit;
                y: root.height / 2 - 5 * Theme.unit - 12.5 * Theme.unit + 3 * Theme.unit;
                width: 19 * Theme.unit;
                height: 19 * Theme.unit;
                source: Icons.get("ios-add", self.width, self.height);
                colorize: white;
            }

            Text {
                x: 2 * Theme.unit;
                y: root.height / 2 + 15 * Theme.unit - 5 * Theme.unit;
                width: root.width - 4 * Theme.unit;
                height: 10 * Theme.unit;
                text: "Add an alarm";
                color: white;
                font-size: 7 * Theme.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            add := TouchArea {
                x: root.width * 0.15;
                y: root.height * 0.15;
                width: root.width * 0.7;
                height: root.height * 0.7;
                clicked => {
                    root.index = -1;
                    root.hour = Face.hour;
                    root.minute = Face.minute;
                    root.days = 0;
                    root.page = 1;
                }
            }
        }

        if root.pages > 1: HorizontalLayout {
            x: (root.width - self.width) / 2;
            y: 9 * Theme.unit;
            width: root.pages * 3.75 * Theme.unit - 0.75 * Theme.unit;
            height: 3 * Theme.unit;
            spacing: 0.75 * Theme.unit;

            for alarm[i] in Face.alarms: Rectangle {
                width: 3 * Theme.unit;
                height: 3 * Theme.unit;
                border-radius: 1.5 * Theme.unit;
                background: white;
                opacity: list.index == i ? 1 : 0.5;
            }

            if root.room: Text {
                width: 3 * Theme.unit;
                text: "+";
                color: white;
                opacity: list.index == Face.alarms.length ? 1 : 0.5;
                font-size: 4 * Theme.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.page == 1: Page {
        property <length> w: Face.clock12 ? 30 * Theme.unit : 45 * Theme.unit;

        hours := Spinner {
            x: 5 * Theme.unit;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            count: Face.clock12 ? 12 : 24;
            twelve: Face.clock12;
            value: Face.clock12 ? Math.mod(root.hour, 12) : root.hour;
        }

        Rectangle {
            x: 5 * Theme.unit + parent.w - 0.25 * Theme.unit;
            y: 20 * Theme.unit + 6 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        minutes := Spinner {
            x: 5 * Theme.unit + parent.w;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            count: 60;
            value: root.minute;
        }

        if Face.clock12: Rectangle {
            x: 5 * Theme.unit + 2 * parent.w - 0.25 * Theme.unit;
            y: 20 * Theme.unit + 6 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        ampm := Spinner {
            x: 5 * Theme.unit + 2 * parent.w;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            visible: Face.clock12;
            count: 2;
            wrap: false;
            labels: ["AM", "PM"];
            value: root.hour >= 12 ? 1 : 0;
        }

        PageHeader {
            x: 0;
            y: 0;
            text: "Time";
        }

        IconButton {
            x: (root.width - self.width) / 2;
            y: root.height - 3 * Theme.unit - self.height;
            icon: root.index < 0 ? "ios-arrow-dropright" : "ios-checkmark-circle-outline";
            clicked => {
                root.hour = hours.value + (Face.clock12 ? ampm.value * 12 : 0);
                root.minute = minutes.value;
                if root.index < 0 {
                    root.page = 2;
                } else {
                    Face.alarm-saved(root.index, root.hour, root.minute, root.days, true);
                    root.pop();
                }
            }
        }
    }

    if root.page == 2: Page {
        PageHeader {
            x: 0;
            y: 0;
            text: "Repetition";
        }

        for d[k] in Days.order: Rectangle {
            x: k < 4 ? 10 * Theme.unit + k * 20 * Theme.unit : 20 * Theme.unit + (k - 4) * 20 * Theme.unit;
            y: k < 4 ? 30 * Theme.unit : 50 * Theme.unit;
            width: 20 * Theme.unit;
            height: 20 * Theme.unit;

            Rectangle {
                x: 1 * Theme.unit;
                y: 1 * Theme.unit;
                width: 18 * Theme.unit;
                height: 18 * Theme.unit;
                border-radius: 9 * Theme.unit;
                background: #333333;
                opacity: Days.has(root.days, d) ? 0.7 : 0.2;
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: Days.names[d];
                color: white;
                opacity: Days.has(root.days, d) ? 1 : 0.4;
                font-size: 6 * Theme.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.days += Days.has(root.days, d) ? -Math.pow(2, d) : Math.pow(2, d);
                }
            }
        }

        IconButton {
            x: (root.width - self.width) / 2;
            y: root.height - 3 * Theme.unit - self.height;
            icon: root.index < 0 ? "ios-add-circle-outline" : "ios-checkmark-circle-outline";
            clicked => {
                Face.alarm-saved(root.index, root.hour, root.minute, root.days, true);
                root.pop();
            }
        }
    }
}
