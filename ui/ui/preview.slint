// For make preview only: one window that takes the sample data as its own properties and
// shows the screen chosen by `screen` (0 watchface, 1 notifications, 2 weather, 3 launcher,
// 4 Today, 6 app) with the overlay on top, over a backdrop instead of the FlatMesh.
import "../fonts/NotoSans-Light.ttf";
import { Face, Note, Day, Tile, AgendaItem, Watchface } from "face.slint";
import { NoteList } from "notes.slint";
import { WeatherScreen } from "weather.slint";
import { Launcher } from "launcher.slint";
import { TodayScreen } from "today.slint";
import { AppScreen } from "apps.slint";
import { Overlay } from "overlay.slint";
import { Theme } from "theme.slint";

export component Preview inherits Window {
    in-out property <int> hour <=> Face.hour;
    in-out property <int> minute <=> Face.minute;
    in-out property <int> second <=> Face.second;
    in-out property <int> weekday <=> Face.weekday;
    in-out property <int> day <=> Face.day;
    in-out property <int> month <=> Face.month;
    in-out property <int> battery-percent <=> Face.battery-percent;
    in-out property <bool> charging <=> Face.charging;
    in-out property <int> passkey <=> Face.passkey;
    in-out property <bool> notification-shown <=> Face.notification-shown;
    in-out property <string> notification-icon <=> Face.notification-icon;
    in-out property <string> notification-app <=> Face.notification-app;
    in-out property <string> notification-summary <=> Face.notification-summary;
    in-out property <string> notification-body <=> Face.notification-body;
    in-out property <[Note]> notes <=> Face.notes;
    in-out property <string> media-title <=> Face.media-title;
    in-out property <string> media-artist <=> Face.media-artist;
    in-out property <string> media-album <=> Face.media-album;
    in-out property <bool> media-playing <=> Face.media-playing;
    in-out property <int> media-volume <=> Face.media-volume;
    in-out property <bool> weather-valid <=> Face.weather-valid;
    in-out property <string> weather-city <=> Face.weather-city;
    in-out property <Day> weather-today <=> Face.weather-today;
    in-out property <[Day]> weather-forecast <=> Face.weather-forecast;
    in-out property <int> app <=> Face.app;
    in-out property <string> calc-shown <=> Face.calc-shown;
    in-out property <int> calc-length <=> Face.calc-length;
    in-out property <[Tile]> game-tiles <=> Face.game-tiles;
    in-out property <int> game-score <=> Face.game-score;
    in-out property <int> game-best <=> Face.game-best;
    in-out property <bool> game-over <=> Face.game-over;
    in-out property <[AgendaItem]> agenda <=> Face.agenda;
    in-out property <[AgendaItem]> agenda-today <=> Face.agenda-today;
    in-out property <int> activity-today <=> Face.activity-today;
    in-out property <int> activity-goal <=> Face.activity-goal;
    in-out property <[int]> activity-days <=> Face.activity-days;
    in-out property <int> activity-distance <=> Face.activity-distance;
    in-out property <int> activity-kcal <=> Face.activity-kcal;
    in-out property <bool> workout-running <=> Face.workout-running;
    in-out property <int> workout-start <=> Face.workout-start;
    in-out property <int> workout-seconds <=> Face.workout-seconds;
    in-out property <int> workout-steps <=> Face.workout-steps;
    in-out property <int> workout-distance <=> Face.workout-distance;
    in-out property <int> workout-kcal <=> Face.workout-kcal;
    in-out property <int> workout-avg-bpm <=> Face.workout-avg-bpm;
    in-out property <int> workout-max-bpm <=> Face.workout-max-bpm;
    in-out property <int> heart-rate <=> Face.heart-rate;
    in-out property <int> now <=> Face.now;
    in property <int> screen;
    in property <brush> backdrop: #303030;
    in property <bool> round-mask;

    width: 100 * Theme.unit;
    height: 100 * Theme.unit;
    background: root.backdrop;
    default-font-family: "Noto Sans";
    default-font-weight: 300;

    if root.screen == 0: Watchface { }
    if root.screen == 1: NoteList { }
    if root.screen == 2: WeatherScreen { }
    if root.screen == 3: Launcher { }
    if root.screen == 4: TodayScreen { }
    if root.screen == 6: AppScreen { }
    Overlay { }

    if root.round-mask: Rectangle {
        x: -25 * Theme.unit;
        y: -25 * Theme.unit;
        width: root.width + 50 * Theme.unit;
        height: root.height + 50 * Theme.unit;
        border-radius: self.width / 2;
        border-width: 25 * Theme.unit;
        border-color: #000000c0;
    }
}
