// The notifications, left of the watchface, laid out as asteroid-launcher's: one notification per
// page, the newest next to the watchface and older ones further left, with a strip of their icons
// along the top, the one on screen white. A page shows the app and how long ago it came, the
// summary in bold, the body, and a Dismiss button, and scrolls up and down when it is longer than
// the screen. Above each page, pulled down from its top, are its actions: Snooze, which offers 10
// and 30 minutes and 1 and 3 hours, Dismiss all and Dismiss. Without notifications a mail icon
// says so.
// notes-edges tells the screen stack which edges lead somewhere and, in bit 4, that the newest
// page is on screen, where a swipe left goes back to the watchface.
import { Face, Note } from "face.slint";
import { Pill, PageHeader, Page } from "controls.slint";
import { NoteIcons } from "note_icons.slint";

global Notes {
    // How long ago, from seconds: Now, then minutes, hours and days.
    public pure function ago(s: int) -> string {
        return s < 60 ? "Now" : s < 3600 ? Math.floor(s / 60) + "m" : s < 216000 ? Math.floor(s / 3600) + "h" : Math.floor(s / 86400) + "d";
    }

    public pure function icon(n: Note) -> image {
        return n.icon >= 0 ? NoteIcons.list[n.icon] : @image-url("../icons/ios-mail-outline.svg");
    }
}

component NotificationView {
    in property <Note> note;
    in property <length> offset;
    out property <length> content-height: column.preferred-height;
    property <int> age: Face.now - self.note.time;

    width: 400px;
    height: 400px;

    Rectangle {
        x: 60px;
        width: 280px;
        height: 400px;

        column := VerticalLayout {
            y: root.offset;
            width: 280px;
            height: self.preferred-height;
            alignment: start;
            padding-top: 60px;
            padding-bottom: 40px;

            HorizontalLayout {
                height: 40px;

                Text {
                    width: 224px;
                    text: root.note.app;
                    color: white;
                    font-size: 24px;
                    overflow: elide;
                }

                Text {
                    width: 56px;
                    text: Notes.ago(root.age);
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: right;
                }
            }

            Rectangle {
                height: 12px;
            }

            Text {
                text: root.note.summary;
                color: white;
                font-size: 28px;
                font-weight: 700;
                overflow: elide;
            }

            Rectangle {
                height: 4px;
            }

            Text {
                text: root.note.body;
                color: white;
                font-size: 28px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 40px;
            }

            HorizontalLayout {
                alignment: center;

                Pill {
                    text: "Dismiss";
                    clicked => {
                        Face.notification-dismissed(root.note.id);
                    }
                }
            }
        }
    }
}

// NotificationActions: three 220 by 80 px buttons down the middle, and the app's icon with how
// long ago it came along the bottom.
component Actions {
    in property <Note> note;
    callback snooze();
    property <int> age: Face.now - self.note.time;

    width: 400px;
    height: 400px;

    VerticalLayout {
        x: 90px;
        y: 48px;
        width: 220px;
        height: 304px;
        spacing: 32px;

        Pill {
            text: "Snooze";
            clicked => {
                root.snooze();
            }
        }

        Pill {
            text: "Dismiss all";
            clicked => {
                Face.notifications-cleared();
            }
        }

        Pill {
            text: "Dismiss";
            clicked => {
                Face.notification-dismissed(root.note.id);
            }
        }
    }

    HorizontalLayout {
        y: 400px - 12px - 34px;
        height: 34px;
        alignment: center;

        Image {
            width: 34px;
            height: 34px;
            source: Notes.icon(root.note);
            colorize: white;
        }

        Text {
            text: Notes.ago(root.age);
            color: #b0b0b0;
            font-size: 24px;
            vertical-alignment: center;
        }
    }
}

// The snooze times: round 104 px buttons two by two under a header.
component SnoozeTimes {
    callback picked(int);

    x: 0;
    y: 0;
    width: 400px;
    height: 400px;

    for t[i] in [{ label: "10m", minutes: 10 }, { label: "30m", minutes: 30 }, { label: "1h", minutes: 60 }, { label: "3h", minutes: 180 }]: Rectangle {
        x: 80px + Math.mod(i, 2) * 136px;
        y: 80px + Math.floor(i / 2) * 136px;
        width: 104px;
        height: 104px;
        border-radius: 52px;
        background: touch.pressed ? #22222299 : #222222bb;

        Text {
            text: t.label;
            color: white;
            font-size: 32px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        touch := TouchArea {
            clicked => {
                root.picked(t.minutes);
            }
        }
    }

    PageHeader {
        text: "Snooze";
    }
}

// One touch area under the pages takes every drag, deciding by the average move per event as the
// screen stack does: sideways ones turn the pages, one at a time, past half the screen or faster
// than 10 px per event, sliding over 100 ms; up and down ones scroll the page on screen when it is
// longer than the screen, or, from its top, pull its actions down over it the same way. Up there
// only a drag up goes back. Only the buttons take presses themselves.
export component NoteList {
    property <int> count: Face.notes.length;
    property <int> page;
    property <length> drag;
    property <length> vdrag;
    property <length> offset;
    // 0 undecided, 1 sideways, 2 scrolling the page, 3 pulling the actions down or pushing them up.
    property <int> axis;
    property <length> page-height;
    property <bool> actions;
    property <bool> snoozing;
    // The average move per event since the press, across and down, and where the last one was.
    property <int> moves;
    property <float> vx;
    property <float> vy;
    property <length> last-x;
    property <length> last-y;
    property <length> scroll: self.page * 400px - (self.axis == 1 ? self.drag : 0);
    animate scroll {
        duration: root.axis == 1 ? 0ms : 100ms;
        easing: linear;
    }
    property <length> lift: Math.clamp((self.actions ? 400px : 0) + (self.axis == 3 ? self.vdrag : 0), 0, 400px);
    animate lift {
        duration: root.axis == 3 ? 0ms : 100ms;
        easing: linear;
    }
    // The note on screen, an index into Face.notes.
    property <int> current: self.count - 1 - self.page;
    property <int> edges: self.count == 0 ? 2 + 16 : self.actions ? 8 : 2 + (self.page > 0 ? 1 : 0) + (self.offset == 0 ? 4 : 0) + (self.page >= self.count - 1 ? 16 : 0);

    width: 100%;
    height: 100%;

    init => {
        self.page = Math.max(0, self.count - 1);
        Face.notes-edges = self.edges;
    }
    changed count => {
        self.page = Math.max(0, self.count - 1);
        self.offset = 0;
        self.actions = false;
        self.snoozing = false;
    }
    changed page => {
        self.offset = 0;
    }
    changed edges => {
        Face.notes-edges = self.edges;
    }

    if root.count == 0: Rectangle {
        Image {
            x: 146px;
            y: 110px;
            width: 108px;
            height: 108px;
            source: @image-url("../icons/ios-mail-outline.svg");
            colorize: white;
            opacity: 0.8;
        }

        Text {
            x: 0;
            y: 234px;
            width: 400px;
            text: "No notifications";
            color: white;
            opacity: 0.8;
            font-size: 24px;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        enabled: !root.snoozing;
        moved => {
            let dx = self.mouse-x - self.pressed-x;
            let dy = self.mouse-y - self.pressed-y;
            if root.axis == 0 && (Math.abs(dx) > 10px || Math.abs(dy) > 10px) {
                root.axis = Math.abs(dx) > Math.abs(dy) ? (root.actions ? 4 : 1) : root.actions || (root.offset == 0 && dy > 0) ? 3 : 2;
            }
            root.moves += 1;
            root.vx += ((self.mouse-x - root.last-x) / 1px - root.vx) / root.moves;
            root.vy += ((self.mouse-y - root.last-y) / 1px - root.vy) / root.moves;
            root.last-x = self.mouse-x;
            root.last-y = self.mouse-y;
            if root.axis == 1 {
                root.drag = Math.clamp(dx, (root.page + 1 - Math.max(1, root.count)) * 400px, root.page * 400px);
            } else if root.axis == 2 || root.axis == 3 {
                root.vdrag = dy;
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.axis = 0;
                root.drag = 0;
                root.vdrag = 0;
                root.moves = 0;
                root.vx = 0;
                root.vy = 0;
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                let live = self.mouse-x > -1000px;
                if root.axis == 1 && live {
                    let n = root.drag < -200px || (root.vx < -10 && root.drag < 0) ? 1 : root.drag > 200px || (root.vx > 10 && root.drag > 0) ? -1 : 0;
                    root.page = Math.clamp(root.page + n, 0, Math.max(0, root.count - 1));
                } else if root.axis == 2 && live {
                    root.offset = Math.clamp(root.offset + root.vdrag, Math.min(0, 400px - root.page-height), 0);
                } else if root.axis == 3 && live {
                    root.actions = root.actions ? !(root.vdrag < -200px || (root.vy < -10 && root.vdrag < 0)) : root.vdrag > 200px || (root.vy > 10 && root.vdrag > 0);
                }
                root.axis = 0;
                root.drag = 0;
                root.vdrag = 0;
            }
        }
    }

    for note[i] in Face.notes: NotificationView {
        property <bool> shown: i == root.current;
        x: (root.count - 1 - i) * 400px - root.scroll;
        y: root.lift;
        visible: self.x > -400px && self.x < 400px;
        note: note;
        offset: self.shown ? Math.clamp(root.offset + (root.axis == 2 ? root.vdrag : 0), Math.min(0, 400px - self.content-height), 0) : 0;
        init => {
            if self.shown {
                root.page-height = self.content-height;
            }
        }
        changed shown => {
            if self.shown {
                root.page-height = self.content-height;
            }
        }
    }

    // Snooze slides in over the actions as a LayerStack page, pushing them out to the left.
    if root.count > 0 && root.lift > 0: Actions {
        x: root.snoozing ? -400px : 0;
        y: root.lift - 400px;
        animate x {
            duration: 200ms;
            easing: ease-out-quint;
        }
        note: Face.notes[root.current];
        snooze => {
            root.snoozing = true;
        }
    }

    // The icon strip: 32 px icons at y = 20, the current one in the middle, newer ones to its
    // right, then a grey separator and clock.
    if root.count > 0 && root.lift == 0: Rectangle {
        property <length> cx: 184px + root.current * 32px;
        y: 20px;
        height: 32px;
        clip: true;

        for note[i] in Face.notes: Image {
            x: parent.cx - i * 32px;
            width: 32px;
            height: 32px;
            visible: self.x > -32px && self.x < 400px;
            source: Notes.icon(note);
            colorize: i == root.current ? white : #8e8e8e;
        }

        Rectangle {
            x: parent.cx + 35px;
            width: 1px;
            height: 32px;
            background: #8e8e8e;
        }

        Image {
            x: parent.cx + 39px;
            width: 32px;
            height: 32px;
            source: @image-url("../icons/ios-time.svg");
            colorize: #8e8e8e;
        }
    }

    if root.snoozing: Page {
        TouchArea {
            // A drag right goes back to the actions.
            pointer-event(e) => {
                if e.kind == PointerEventKind.up && self.mouse-x - self.pressed-x > 60px {
                    root.snoozing = false;
                }
            }
        }

        SnoozeTimes {
            picked(minutes) => {
                Face.notification-snoozed(Face.notes[root.current].id, minutes);
                root.snoozing = false;
                root.actions = false;
            }
        }
    }
}
