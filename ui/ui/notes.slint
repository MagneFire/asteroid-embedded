// The notifications, left of the watchface, laid out as asteroid-launcher's: one notification per
// page, the newest next to the watchface and older ones further left. A page shows the app and
// how long ago it came, the summary in bold, the body, and a Dismiss button, and scrolls up and
// down when it is longer than the screen. Without notifications a mail icon says so.
// notes-edges tells the screen stack which edges lead somewhere and, in bit 4, that the newest
// page is on screen, where a swipe left goes back to the watchface.
import { Face, Note } from "face.slint";
import { Pill } from "controls.slint";
import { Pager } from "launcher.slint";

component NotificationView {
    in property <Note> note;
    in property <length> offset;
    out property <length> content-height: column.preferred-height;
    property <int> age: Face.now - self.note.time;

    width: 400px;
    height: 400px;

    pure function ago(s: int) -> string {
        return s < 60 ? "Now" : s < 3600 ? Math.floor(s / 60) + "m" : s < 216000 ? Math.floor(s / 3600) + "h" : Math.floor(s / 86400) + "d";
    }

    Rectangle {
        x: 60px;
        width: 280px;
        height: 400px;

        column := VerticalLayout {
            y: root.offset;
            width: 280px;
            height: self.preferred-height;
            alignment: start;
            padding-top: 60px;
            padding-bottom: 40px;

            HorizontalLayout {
                height: 40px;

                Text {
                    width: 224px;
                    text: root.note.app;
                    color: white;
                    font-size: 24px;
                    overflow: elide;
                }

                Text {
                    width: 56px;
                    text: root.ago(root.age);
                    color: white;
                    font-size: 24px;
                    horizontal-alignment: right;
                }
            }

            Rectangle {
                height: 12px;
            }

            Text {
                text: root.note.summary;
                color: white;
                font-size: 28px;
                font-weight: 700;
                overflow: elide;
            }

            Rectangle {
                height: 4px;
            }

            Text {
                text: root.note.body;
                color: white;
                font-size: 28px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 40px;
            }

            HorizontalLayout {
                alignment: center;

                Pill {
                    text: "Dismiss";
                    clicked => {
                        Face.notification-dismissed(root.note.id);
                    }
                }
            }
        }
    }
}

// One touch area under the pages takes every drag: sideways ones turn the pages, one page at a
// time, up and down ones scroll the page on screen when it is longer than the screen. Only the
// Dismiss buttons take presses themselves.
export component NoteList {
    property <int> count: Face.notes.length;
    property <int> page;
    property <length> drag;
    property <length> vdrag;
    property <length> offset;
    property <int> axis;
    property <length> page-height;
    property <length> scroll: self.page * 400px - (self.axis == 1 ? self.drag : 0);
    animate scroll {
        duration: root.axis == 1 ? 0ms : 200ms;
        easing: ease-out;
    }

    width: 100%;
    height: 100%;

    function report() {
        Face.notes-edges = 2 + (self.page > 0 ? 1 : 0) + (self.page >= self.count - 1 ? 16 : 0);
    }
    init => {
        self.page = Math.max(0, self.count - 1);
        self.report();
    }
    changed count => {
        self.page = Math.max(0, self.count - 1);
        self.offset = 0;
        self.report();
    }
    changed page => {
        self.offset = 0;
        self.report();
    }

    if root.count == 0: Rectangle {
        Image {
            x: 146px;
            y: 110px;
            width: 108px;
            height: 108px;
            source: @image-url("../icons/ios-mail-outline.svg");
            colorize: white;
            opacity: 0.8;
        }

        Text {
            x: 0;
            y: 234px;
            width: 400px;
            text: "No notifications";
            color: white;
            opacity: 0.8;
            font-size: 24px;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        moved => {
            let dx = self.mouse-x - self.pressed-x;
            let dy = self.mouse-y - self.pressed-y;
            if root.axis == 0 && (Math.abs(dx) > 10px || Math.abs(dy) > 10px) {
                root.axis = Math.abs(dx) > Math.abs(dy) ? 1 : 2;
            }
            if root.axis == 1 {
                root.drag = Math.clamp(dx, (root.page + 1 - Math.max(1, root.count)) * 400px, root.page * 400px);
            } else if root.axis == 2 {
                root.vdrag = dy;
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.axis = 0;
                root.drag = 0;
                root.vdrag = 0;
            }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if root.axis == 1 && self.mouse-x > -1000px {
                    root.page = Math.clamp(root.page + (root.drag < -60px ? 1 : root.drag > 60px ? -1 : 0), 0, Math.max(0, root.count - 1));
                } else if root.axis == 2 {
                    root.offset = Math.clamp(root.offset + root.vdrag, Math.min(0, 400px - root.page-height), 0);
                }
                root.axis = 0;
                root.drag = 0;
                root.vdrag = 0;
            }
        }
    }


    for note[i] in Face.notes: NotificationView {
        property <bool> shown: root.count - 1 - i == root.page;
        x: (root.count - 1 - i) * 400px - root.scroll;
        y: 0;
        visible: self.x > -400px && self.x < 400px;
        note: note;
        offset: self.shown ? Math.clamp(root.offset + (root.axis == 2 ? root.vdrag : 0), Math.min(0, 400px - self.content-height), 0) : 0;
        init => {
            if self.shown {
                root.page-height = self.content-height;
            }
        }
        changed shown => {
            if self.shown {
                root.page-height = self.content-height;
            }
        }
    }

}
