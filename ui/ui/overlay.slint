// Drawn over every screen: a notification that was opened or just came in, the
// Bluetooth pairing code, or a ringing alarm or timer with dismiss and snooze buttons.
import { NoteIcons } from "note_icons.slint";
import { Face } from "face.slint";
import { IconButton, StatusPage } from "controls.slint";

export component Overlay {
    width: 100%;
    height: 100%;

    // NotificationPreview: black at 80 % over the screen with the icon, summary and body as a
    // centred block; hides itself after 5 s or on a tap, leaving the notification in the list.
    if Face.notification-shown: Rectangle {
        background: preview-touch.pressed ? #000000d9 : #000000cc;

        VerticalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                padding-top: 12px;

                Image {
                    width: 80px;
                    height: 80px;
                    source: Face.notification-icon >= 0 ? NoteIcons.list[Face.notification-icon] : @image-url("../icons/ios-mail-outline.svg");
                    colorize: white;
                }
            }

            if Face.notification-summary != "": HorizontalLayout {
                alignment: center;

                Text {
                    width: 360px;
                    text: Face.notification-summary;
                    color: white;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                alignment: center;

                Text {
                    width: 320px;
                    max-height: 4 * 33px;
                    text: Face.notification-body;
                    color: white;
                    font-size: 24px;
                    font-weight: Face.notification-summary == "" ? 700 : 300;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        Timer {
            interval: 5s;
            running: Face.notification-shown;
            triggered => {
                Face.notification-shown = false;
            }
        }

        preview-touch := TouchArea {
            clicked => {
                Face.notification-shown = false;
            }
        }
    }

    // BluetoothAgent: a light disc with a drop shadow, a grey Bluetooth icon, the pass key, and
    // grey cancel and confirm buttons below it (setting-toggled 42 and 43).
    if Face.passkey >= 0: Rectangle {
        Rectangle {
            x: 58px;
            y: 58px;
            width: 284px;
            height: 284px;
            border-radius: 142px;
            background: #00000040;
        }

        Rectangle {
            x: 60px;
            y: 60px;
            width: 280px;
            height: 280px;
            border-radius: 140px;
            background: #f4f4f4;
        }

        Image {
            x: 160px;
            y: 80px;
            width: 80px;
            height: 80px;
            source: @image-url("../icons/ios-bluetooth.svg");
            colorize: #666666;
        }

        Text {
            x: 60px;
            y: 172px;
            width: 280px;
            text: "Pass Key:";
            color: #666666;
            font-size: 20px;
            horizontal-alignment: center;
        }

        Text {
            x: 60px;
            y: 200px;
            width: 280px;
            height: 40px;
            text: Face.two-digits(Math.floor(Face.passkey / 10000)) + Face.two-digits(Math.mod(Math.floor(Face.passkey / 100), 100)) + Face.two-digits(Math.mod(Face.passkey, 100));
            color: #666666;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        IconButton {
            x: 112px;
            y: 236px;
            color: #666666;
            icon: @image-url("../icons/ios-close-circle-outline.svg");
            clicked => {
                Face.setting-toggled(42);
            }
        }

        IconButton {
            x: 208px;
            y: 236px;
            color: #666666;
            icon: @image-url("../icons/ios-checkmark-circle-outline.svg");
            clicked => {
                Face.setting-toggled(43);
            }
        }
    }

    // The alarm presenter: a dark mesh, the alarm or timer icon in a disc, the alarm's time (or
    // the timer's duration) at the bottom, dismiss on the left and snooze (or, for the timer,
    // start again) on the right.
    if Face.alarm-ringing: Rectangle {
        background: @radial-gradient(circle, #333333 0%, #000000 100%);

        StatusPage {
            icon: Face.ringing-timer ? @image-url("../icons/ios-timer-outline.svg") : @image-url("../icons/ios-alarm-outline.svg");
        }

        Text {
            x: 76px;
            y: 224px;
            width: 248px;
            height: 176px;
            text: Face.ringing-timer ? Face.two-digits(Math.floor(Face.timer-set-ms / 3600000)) + ":" + Face.two-digits(Math.mod(Math.floor(Face.timer-set-ms / 60000), 60)) + ":" + Face.two-digits(Math.mod(Math.floor(Face.timer-set-ms / 1000), 60)) : (Face.clock12 ? Face.two-digits(Math.mod(Face.hour, 12)) : Face.two-digits(Face.hour)) + ":" + Face.two-digits(Face.minute) + (Face.clock12 ? (Face.hour >= 12 ? "PM" : "AM") : "");
            color: white;
            font-size: Face.ringing-timer ? 32px : 60px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        IconButton {
            x: 12px;
            y: 160px;
            icon: @image-url("../icons/ios-checkmark-circle-outline.svg");
            clicked => {
                Face.alarm-action(1);
            }
        }

        IconButton {
            x: 308px;
            y: 160px;
            icon: Face.ringing-timer ? @image-url("../icons/ios-refresh-circle-outline.svg") : @image-url("../icons/ios-sleep-circle-outline.svg");
            clicked => {
                Face.alarm-action(0);
                if Face.ringing-timer {
                    Face.clock-action(20);
                }
            }
        }
    }
}
