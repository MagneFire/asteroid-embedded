// Drawn over every screen: a notification that was opened or just came in, the
// Bluetooth pairing code, or a ringing alarm or timer with Snooze and Dismiss.
import { NoteIcons } from "note_icons.slint";
import { Face } from "face.slint";

export component Overlay {
    width: 100%;
    height: 100%;

    // NotificationPreview: black at 80 % over the screen with the icon, summary and body as a
    // centred block; hides itself after 5 s or on a tap, leaving the notification in the list.
    if Face.notification-shown: Rectangle {
        background: preview-touch.pressed ? #000000d9 : #000000cc;

        VerticalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                padding-top: 12px;

                Image {
                    width: 80px;
                    height: 80px;
                    source: Face.notification-icon >= 0 ? NoteIcons.list[Face.notification-icon] : @image-url("../icons/ios-mail-outline.svg");
                    colorize: white;
                }
            }

            if Face.notification-summary != "": HorizontalLayout {
                alignment: center;

                Text {
                    width: 360px;
                    text: Face.notification-summary;
                    color: white;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                alignment: center;

                Text {
                    width: 320px;
                    max-height: 4 * 33px;
                    text: Face.notification-body;
                    color: white;
                    font-size: 24px;
                    font-weight: Face.notification-summary == "" ? 700 : 300;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        Timer {
            interval: 5s;
            running: Face.notification-shown;
            triggered => {
                Face.notification-shown = false;
            }
        }

        preview-touch := TouchArea {
            clicked => {
                Face.notification-shown = false;
            }
        }
    }

    if Face.passkey >= 0: Rectangle {
        background: black;

        Text {
            y: root.height * 0.3;
            height: root.height * 0.1;
            width: root.width;
            text: "Pairing code";
            color: white;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            y: root.height * 0.42;
            height: root.height * 0.2;
            width: root.width;
            text: Face.two-digits(Math.floor(Face.passkey / 10000)) + Face.two-digits(Math.mod(Math.floor(Face.passkey / 100), 100)) + Face.two-digits(Math.mod(Face.passkey, 100));
            color: white;
            font-size: 64px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if Face.alarm-ringing: Rectangle {
        background: black;

        Text {
            x: 0;
            y: root.height * 0.14;
            width: root.width;
            height: root.height * 0.1;
            text: Face.ringing-timer ? "Timer" : "Alarm";
            color: #ffffffa0;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 0;
            y: root.height * 0.25;
            width: root.width;
            height: root.height * 0.25;
            text: Face.two-digits(Face.hour) + ":" + Face.two-digits(Face.minute);
            color: white;
            font-size: 80px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        for action[i] in ["Snooze", "Dismiss"]: Rectangle {
            visible: i == 1 || !Face.ringing-timer;
            x: Face.ringing-timer ? (root.width - self.width) / 2 : root.width * 0.5 + (i == 0 ? -128px : 8px);
            y: root.height * 0.6;
            width: 120px;
            height: 64px;
            border-radius: 32px;
            background: touch.pressed ? #ffffff70 : #ffffff30;

            Text {
                width: parent.width;
                height: parent.height;
                text: action;
                color: white;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => {
                    Face.alarm-action(i);
                }
            }
        }
    }
}
