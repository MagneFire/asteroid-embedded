// The AsteroidOS default digital watchface: the hour large in Roboto Medium with the minutes in
// Roboto Light and the date in Raleway Light to its right, white with a dark halo, and on the
// charger (nightstand) a ring of 50 battery segments, shown up to the charge, red below a third,
// yellow below two thirds, green above, with the face at 86 %. size is the screen it is drawn
// for, so the selector can show it small.
import { Face } from "face.slint";
import { Ring } from "ring.slint";

component Label {
    in property <length> s;
    in property <float> cx;
    in property <float> cy;
    in property <string> text;
    in property <length> font-size;
    in property <string> family;
    in property <int> weight;

    x: 0;
    y: 0;
    width: self.s;
    height: self.s;

    // A label centred at (cx, cy) of the face, over a soft black halo.
    for d[i] in [[0, 0], [-1, 0], [1, 0], [0, -1], [0, 1]]: Text {
        x: root.s * root.cx - 200px + d[0] * root.s * 0.006;
        y: root.s * root.cy - 100px + d[1] * root.s * 0.006;
        width: 400px;
        height: 200px;
        text: root.text;
        color: i == 0 ? transparent : #00000048;
        font-size: root.font-size;
        font-family: root.family;
        font-weight: root.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: root.s * root.cx - 200px;
        y: root.s * root.cy - 100px;
        width: 400px;
        height: 200px;
        text: root.text;
        color: white;
        font-size: root.font-size;
        font-family: root.family;
        font-weight: root.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DigitalFace {
    in property <length> size: 400px;
    in property <bool> preview;
    property <bool> nightstand: Face.nightstand && !self.preview;
    property <length> s: self.size * (self.nightstand ? 0.86 : 1);
    property <[string]> months: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    property <int> hour: Face.clock12 ? Math.mod(Face.hour + 11, 12) + 1 : Face.hour;

    width: self.size;
    height: self.size;

    Rectangle {
        x: (root.size - root.s) / 2;
        y: (root.size - root.s) / 2;
        width: root.s;
        height: root.s;

        Label {
            s: root.s;
            cx: 0.379;
            cy: 0.487;
            text: Face.two-digits(root.hour);
            font-size: Math.round(root.s * 0.36 / 1px) * 1px;
            family: "Roboto";
            weight: 500;
        }

        Label {
            s: root.s;
            cx: 0.717;
            cy: 0.45;
            text: Face.two-digits(Face.minute);
            font-size: Math.round(root.s * 0.18 / 1px) * 1px;
            family: "Roboto";
            weight: 300;
        }

        if Face.clock12: Label {
            s: root.s;
            cx: 0.898;
            cy: 0.368;
            text: Face.hour < 12 ? "AM" : "PM";
            font-size: Math.round(root.s * 0.065 / 1px) * 1px;
            family: "Raleway";
            weight: 300;
        }

        Label {
            s: root.s;
            cx: 0.719;
            cy: 0.587;
            text: Face.day + " " + root.months[Face.month - 1];
            font-size: Math.round(root.s * 0.076 / 1px) * 1px;
            family: "Raleway";
            weight: 300;
        }
    }

    // The segments of the battery ring (generated by build.rs); the first always shows.
    for seg[i] in root.nightstand ? Ring.segments : []: Image {
        x: seg.x;
        y: seg.y;
        source: seg.img;
        visible: i == 0 || i < Face.battery-percent / 2;
        colorize: Face.battery-percent < 34 ? red : Face.battery-percent < 67 ? yellow : #51ff0de6;
    }
}
