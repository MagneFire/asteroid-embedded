// The app panel: whichever app the launcher opened, full screen over the screen stack.
import { Face } from "face.slint";
import { MusicScreen } from "music.slint";
import { WeatherScreen } from "weather.slint";
import { SettingsApp } from "settings.slint";
import { AlarmApp } from "alarm.slint";
import { TimerApp, StopwatchApp } from "clock.slint";
import { HeartRateScreen } from "heart.slint";

export component AppScreen {
    width: 100%;
    height: 100%;

    if Face.app == 0: MusicScreen { }
    if Face.app == 1: SettingsApp { }
    if Face.app == 2: AlarmApp { }
    if Face.app == 3: TimerApp { }
    if Face.app == 4: StopwatchApp { }
    if Face.app == 5: WeatherScreen { }
    if Face.app == 6: HeartRateScreen { }
}
