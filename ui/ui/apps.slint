// The app panel: whichever app the launcher opened, full screen over the screen stack.
import { Face } from "face.slint";
import { MusicScreen } from "music.slint";
import { SettingsApp } from "settings.slint";

export component AppScreen {
    width: 100%;
    height: 100%;

    if Face.app == 0: MusicScreen { }
    if Face.app == 1: SettingsApp { }
}
