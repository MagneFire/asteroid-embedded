// The Today screen, right of the watchface, as AsteroidOS's: today's weather on top (icon left
// of the middle, lowest and highest temperature to its right) and today's agenda, which is
// always empty here as nothing provides one.
import { Face } from "face.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

export component TodayScreen {
    width: 100%;
    height: 100%;

    if Face.weather-valid: Image {
        x: root.width / 2 - 15 * Theme.unit;
        y: 17.5 * Theme.unit - 7.5 * Theme.unit;
        width: 15 * Theme.unit;
        height: 15 * Theme.unit;
        source: Icons.get(Face.weather-icon(Face.weather-today.id), self.width, self.height);
        colorize: white;
        opacity: 0.8;
    }

    if Face.weather-valid: Text {
        x: root.width * 0.55;
        y: 0;
        width: root.width * 0.45;
        height: 35 * Theme.unit;
        text: Face.temperature(Face.weather-today.min) + "\n" + Face.temperature(Face.weather-today.max);
        color: white;
        opacity: 0.8;
        font-size: 5 * Theme.unit;
        vertical-alignment: center;
    }

    Image {
        x: (root.width - 27 * Theme.unit) / 2;
        y: (root.height - 27 * Theme.unit) / 2 + (Face.weather-valid ? 1 * Theme.unit : -9 * Theme.unit);
        width: 27 * Theme.unit;
        height: 27 * Theme.unit;
        source: Icons.get("ios-calendar-outline", self.width, self.height);
        colorize: white;
        opacity: 0.8;
    }

    Text {
        x: 0;
        y: (root.height + 27 * Theme.unit) / 2 + (Face.weather-valid ? 1 * Theme.unit : -9 * Theme.unit) + 4 * Theme.unit;
        width: root.width;
        text: "No events today";
        color: white;
        opacity: 0.8;
        font-size: 6 * Theme.unit;
        horizontal-alignment: center;
    }
}
