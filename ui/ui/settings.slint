// The Settings app, laid out as asteroid-settings: a list of icon rows, each opening a page that
// slides in from the right. The pages are the ones the firmware has settings for: Display
// (brightness, always on, burn-in protection, tilt and tap to wake), Nightstand (with its
// brightness, delay and always on), Watchface and Launcher pickers, Time and Date, Units (12 hour
// clock, Fahrenheit), Bluetooth (on/off, connection, forgetting the phone), Power (off, reboot)
// and About. Rows call setting-toggled with a setting or an action from the Codes global (the
// firmware's enum setting and enum ui_action), setting-set with a setting and its value,
// brightness-set with a brightness in per cent, and time-set and date-set with the time or date
// set.
import { Face, Watchface } from "face.slint";
import { Codes } from "codes.slint";
import { Apps, LauncherView } from "launcher.slint";
import { DigitalFace } from "digital.slint";
import { PageHeader, Scroller, ListItem, LabeledSwitch, IntSelector, RowLabel, RowSeparator, StatusPage, Page, Spinner, IconButton, Remorse } from "controls.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

// A 60 px check badge with a soft shadow, as the pickers mark the current choice.
component Check {
    width: 15 * Theme.unit;
    height: 15 * Theme.unit;

    Image {
        x: 0.5 * Theme.unit;
        y: 0.5 * Theme.unit;
        width: 15 * Theme.unit;
        height: 15 * Theme.unit;
        source: Icons.get("ios-checkmark-circle", self.width, self.height);
        colorize: #00000060;
    }

    Image {
        width: 15 * Theme.unit;
        height: 15 * Theme.unit;
        source: Icons.get("ios-checkmark-circle", self.width, self.height);
        colorize: white;
    }
}

export component SettingsApp {
    // 0 the list, then 1 Display, 2 Nightstand, 3 Watchface, 4 Launcher, 5 Units, 6 Bluetooth,
    // 7 About, 8 Time, 9 Date, 10 Power.
    in-out property <int> page;
    property <int> back: Face.back-count;

    changed page => {
        Face.app-depth = self.page > 0 ? 1 : 0;
        self.flip = false;
        self.flipped = false;
    }
    changed back => {
        self.page = 0;
        Face.peek = 0;
        Face.peeking = false;
    }

    // Slides the page on top out to the right and the list back in, as LayerStack's pop does,
    // then leaves it.
    function pop() {
        Face.peeking = false;
        Face.peek = 100 * Theme.unit;
        popped.running = true;
    }
    popped := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.page = 0;
            Face.peek = 0;
        }
    }

    width: 100%;
    height: 100%;

    // Moved out to the left as a page slides in, and back in beside a page dragged back or
    // popped, kept meanwhile, as LayerStack keeps the layer below, so it comes back as it was.
    Rectangle {
        x: root.page == 0 ? 0 : Face.peek - 100 * Theme.unit;
        width: 100 * Theme.unit;
        animate x {
            duration: Face.peeking ? 0ms : 200ms;
            easing: ease-out-quint;
        }

        Scroller {
            x: 0;
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            content-height: list.preferred-height;

            list := VerticalLayout {
                padding-top: 6 * Theme.unit;
                padding-bottom: 6 * Theme.unit;

                for item[i] in [
                    { icon: "ios-display-outline", title: "Display", page: 1 },
                    { icon: "ios-moon-outline", title: "Nightstand", page: 2 },
                    { icon: "ios-watchface-outline", title: "Watchface", page: 3 },
                    { icon: "ios-launcher-outline", title: "Launcher", page: 4 },
                    { icon: "ios-clock-outline", title: "Time", page: 8 },
                    { icon: "ios-date-outline", title: "Date", page: 9 },
                    { icon: "ios-units-outline", title: "Units", page: 5 },
                    { icon: "ios-bluetooth-outline", title: "Bluetooth", page: 6 },
                    { icon: "ios-power-outline", title: "Power", page: 10 },
                    { icon: "ios-help-circle-outline", title: "About", page: 7 },
                ]: ListItem {
                    icon: item.icon;
                    title: item.title;
                    clicked => {
                        root.page = item.page;
                    }
                }
            }
        }
    }

    if root.page == 1: Page {
        Scroller {
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            content-height: display.preferred-height;

            display := VerticalLayout {
                padding-top: 15 * Theme.unit;
                padding-bottom: 15 * Theme.unit;

                RowLabel {
                    text: "Brightness";
                }

                IntSelector {
                    value: Face.brightness;
                    min: 10;
                    max: 100;
                    down => {
                        Face.brightness-set(Math.max(10, Face.brightness - 10));
                    }
                    up => {
                        Face.brightness-set(Math.min(100, Face.brightness + 10));
                    }
                    set(v) => {
                        Face.brightness-set(v);
                    }
                }

                RowSeparator { }

                LabeledSwitch {
                    text: "Always on Display";
                    checked: Face.aod-on;
                    clicked => {
                        Face.setting-toggled(Codes.setting-aod);
                    }
                }

                if Face.has-burn-in: VerticalLayout {
                    RowSeparator { }

                    // OptionCycler: Off, High, Medium, Low.
                    LabeledSwitch {
                        text: "Burn-in Protection";
                        value: ["Off", "High", "Medium", "Low"][Face.burn-in];
                        clicked => {
                            Face.setting-set(Codes.setting-burn-in, Math.mod(Face.burn-in + 1, 4));
                        }
                    }
                }

                RowSeparator { }

                LabeledSwitch {
                    text: "Tilt-to-wake";
                    checked: Face.tilt-on;
                    clicked => {
                        Face.setting-toggled(Codes.setting-tilt);
                    }
                }

                RowSeparator { }

                LabeledSwitch {
                    text: "Tap-to-wake";
                    checked: Face.tap-on;
                    clicked => {
                        Face.setting-toggled(Codes.setting-tap);
                    }
                }
            }
        }

        PageHeader {
            text: "Display";
        }
    }

    if root.page == 2: Page {
        Scroller {
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            content-height: nightstand.preferred-height;

            nightstand := VerticalLayout {
                padding-top: 15 * Theme.unit;
                padding-bottom: 6 * Theme.unit;

                LabeledSwitch {
                    text: "Enable";
                    checked: Face.nightstand-on;
                    clicked => {
                        Face.setting-toggled(Codes.setting-nightstand);
                    }
                }

                VerticalLayout {
                    opacity: Face.nightstand-on ? 1 : 0.4;
                    animate opacity {
                        duration: 200ms;
                        easing: cubic-bezier(0.25, 0.46, 0.45, 0.94);
                    }

                    RowLabel {
                        text: "Brightness";
                    }

                    IntSelector {
                        value: Face.nightstand-brightness;
                        min: 10;
                        max: 100;
                        down => {
                            Face.setting-set(Codes.setting-nightstand-brightness, Math.max(10, Face.nightstand-brightness - 10));
                        }
                        up => {
                            Face.setting-set(Codes.setting-nightstand-brightness, Math.min(100, Face.nightstand-brightness + 10));
                        }
                        set(v) => {
                            Face.setting-set(Codes.setting-nightstand-brightness, v);
                        }
                    }

                    RowLabel {
                        text: "Delay";
                    }

                    IntSelector {
                        value: Face.nightstand-delay;
                        min: 0;
                        max: 30;
                        step: 5;
                        unit: "s";
                        down => {
                            Face.setting-set(Codes.setting-nightstand-delay, Math.max(0, Face.nightstand-delay - 5));
                        }
                        up => {
                            Face.setting-set(Codes.setting-nightstand-delay, Math.min(30, Face.nightstand-delay + 5));
                        }
                        set(v) => {
                            Face.setting-set(Codes.setting-nightstand-delay, v);
                        }
                    }

                    LabeledSwitch {
                        text: "Always on Display";
                        checked: Face.nightstand-aod;
                        clicked => {
                            Face.setting-toggled(Codes.setting-nightstand-aod);
                        }
                    }

                    LabeledSwitch {
                        text: "Auto rotate";
                        checked: Face.nightstand-rotate;
                        clicked => {
                            Face.setting-toggled(Codes.setting-nightstand-rotate);
                        }
                    }
                }
            }
        }

        PageHeader {
            text: "Nightstand";
        }
    }

    if root.page == 3: Page {
        for name[i] in ["Digital", "Classic"]: Rectangle {
            x: Math.mod(i, 2) * 50 * Theme.unit;
            y: 30 * Theme.unit;
            width: 50 * Theme.unit;
            height: 40 * Theme.unit;

            Rectangle {
                x: 5 * Theme.unit;
                width: 40 * Theme.unit;
                height: 40 * Theme.unit;
                border-radius: 20 * Theme.unit;
                clip: true;
                background: Face.watchface == i ? #00000080 : #00000040;

                if i == 0: DigitalFace {
                    size: 40 * Theme.unit;
                    preview: true;
                }
                if i == 1: Watchface {
                    size: 40 * Theme.unit;
                }
            }

            if Face.watchface == i: Check {
                x: (parent.width - self.width) / 2 + (Math.mod(i, 2) == 0 ? 18 * Theme.unit : -18 * Theme.unit);
                y: parent.height - self.height + 1.25 * Theme.unit;
            }

            TouchArea {
                clicked => {
                    Face.setting-toggled(Codes.ui-watchface-first + i);
                }
            }
        }
    }

    // The chosen launcher's preview turns between its first and last app every 5 s, first at
    // once.
    property <bool> flip;
    property <bool> flipped;
    Timer {
        interval: root.flipped ? 5000ms : 1ms;
        running: root.page == 4;
        triggered => {
            root.flip = !root.flip;
            root.flipped = true;
        }
    }

    if root.page == 4: Page {
        Scroller {
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            content-height: Math.ceil(Apps.layouts.length / 2) * 40 * Theme.unit;
            init => {
                self.scroll = Math.clamp(Math.floor(Face.launcher / 2) * 40 * Theme.unit + 20 * Theme.unit - 50 * Theme.unit, 0, self.content-height - 100 * Theme.unit);
            }

            for name[i] in Apps.layouts: Rectangle {
                x: Math.mod(i, 2) * 50 * Theme.unit;
                y: Math.floor(i / 2) * 40 * Theme.unit;
                width: 50 * Theme.unit;
                height: 40 * Theme.unit;
                clip: true;

                LauncherView {
                    x: 5 * Theme.unit;
                    size: 40 * Theme.unit;
                    layout: i;
                    preview: true;
                    last: Face.launcher == i && root.flip;
                }

                if Face.launcher == i: Rectangle {
                    background: #00000066;
                }

                if Face.launcher == i: Check {
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                }

                TouchArea {
                    clicked => {
                        Face.setting-toggled(Codes.ui-launcher-first + i);
                    }
                }
            }
        }
    }

    if root.page == 5: Page {
        VerticalLayout {
            padding-top: 25 * Theme.unit;

            LabeledSwitch {
                text: "Use 12H format:";
                checked: Face.clock12;
                clicked => {
                    Face.setting-toggled(Codes.setting-clock12);
                }
            }

            LabeledSwitch {
                text: "Use Fahrenheit:";
                checked: Face.fahrenheit;
                clicked => {
                    Face.setting-toggled(Codes.setting-fahrenheit);
                }
            }
        }

        PageHeader {
            text: "Units";
        }
    }

    if root.page == 6: Page {
        StatusPage {
            icon: Face.bluetooth-on ? "ios-bluetooth-outline" : "ios-bluetooth-off-outline";
            active: Face.bluetooth-on;
            title: Face.bluetooth-on ? "Bluetooth on" : "Bluetooth off";
            text: Face.bluetooth-connected ? "Connected" : "Not connected";
            clicked => {
                Face.setting-toggled(Codes.setting-bluetooth);
            }
        }

        LabeledSwitch {
            y: 72.5 * Theme.unit;
            text: "Forget phone";
            icon: "ios-trash-outline";
            dim: !Face.bluetooth-bonded;
            clicked => {
                if Face.bluetooth-bonded {
                    Face.setting-toggled(Codes.ui-forget-phone);
                }
            }
        }
    }

    // TimePage: hours and minutes (and AM/PM) on circular spinners from the current time, set
    // with the check button.
    if root.page == 8: Page {
        property <length> w: Face.clock12 ? 30 * Theme.unit : 45 * Theme.unit;

        time-hours := Spinner {
            x: 5 * Theme.unit;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            count: Face.clock12 ? 12 : 24;
            twelve: Face.clock12;
            value: Face.clock12 ? Math.mod(Face.hour, 12) : Face.hour;
        }

        Rectangle {
            x: 5 * Theme.unit + parent.w - 0.25 * Theme.unit;
            y: 26 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        time-minutes := Spinner {
            x: 5 * Theme.unit + parent.w;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            count: 60;
            value: Face.minute;
        }

        if Face.clock12: Rectangle {
            x: 5 * Theme.unit + 2 * parent.w - 0.25 * Theme.unit;
            y: 26 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        time-ampm := Spinner {
            x: 5 * Theme.unit + 2 * parent.w;
            y: 20 * Theme.unit;
            width: parent.w;
            height: 60 * Theme.unit;
            visible: Face.clock12;
            count: 2;
            wrap: false;
            labels: ["AM", "PM"];
            value: Face.hour >= 12 ? 1 : 0;
        }

        IconButton {
            x: (100 * Theme.unit - self.width) / 2;
            y: 100 * Theme.unit - 3 * Theme.unit - self.height;
            icon: "ios-checkmark-circle-outline";
            clicked => {
                Face.time-set((time-hours.value + (Face.clock12 ? time-ampm.value * 12 : 0)) * 60 + time-minutes.value);
                root.pop();
            }
        }

        PageHeader {
            text: "Time";
        }
    }

    // DatePage: day, month and year on circular spinners from today, set with the check button.
    if root.page == 9: Page {
        date-day := Spinner {
            x: 5 * Theme.unit;
            y: 20 * Theme.unit;
            width: 30 * Theme.unit;
            height: 60 * Theme.unit;
            count: 31;
            first: 1;
            plain: true;
            value: Face.day - 1;
        }

        Rectangle {
            x: 34.75 * Theme.unit;
            y: 26 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        date-month := Spinner {
            x: 35 * Theme.unit;
            y: 20 * Theme.unit;
            width: 30 * Theme.unit;
            height: 60 * Theme.unit;
            count: 12;
            labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            value: Face.month - 1;
        }

        Rectangle {
            x: 64.75 * Theme.unit;
            y: 26 * Theme.unit;
            width: 0.25 * Theme.unit;
            height: 48 * Theme.unit;
            background: #ffffff88;
        }

        date-year := Spinner {
            x: 65 * Theme.unit;
            y: 20 * Theme.unit;
            width: 30 * Theme.unit;
            height: 60 * Theme.unit;
            count: 100;
            first: 2000;
            plain: true;
            value: Face.year - 2000;
        }

        IconButton {
            x: (100 * Theme.unit - self.width) / 2;
            y: 100 * Theme.unit - 3 * Theme.unit - self.height;
            icon: "ios-checkmark-circle-outline";
            clicked => {
                Face.date-set(date-day.value + 1, date-month.value + 1, date-year.value + 2000);
                root.pop();
            }
        }

        PageHeader {
            text: "Date";
        }
    }

    // PowerPage: Power Off and Reboot rows, each after a 3 s countdown that a tap cancels
    // (RemorseTimer). A reboot ends in the bootloader's fastboot, as the firmware is booted from
    // there.
    if root.page == 10: Page {
        VerticalLayout {
            y: 20 * Theme.unit;
            height: self.preferred-height;

            for item[i] in [
                { icon: "ios-power-outline", title: "Power Off", action: Codes.ui-power-off },
                { icon: "ios-sync", title: "Reboot", action: Codes.ui-reboot },
            ]: ListItem {
                icon: item.icon;
                title: item.title;
                clicked => {
                    remorse.action = item.title;
                    remorse.code = item.action;
                }
            }
        }

        PageHeader {
            text: "Power";
        }

        remorse := Remorse { }
    }

    if root.page == 7: Page {
        Scroller {
            width: 100 * Theme.unit;
            height: 100 * Theme.unit;
            content-height: about.preferred-height;

            about := VerticalLayout {
                padding-top: 10 * Theme.unit;
                padding-bottom: 10 * Theme.unit;
                padding-left: 10 * Theme.unit;
                padding-right: 10 * Theme.unit;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        width: 40 * Theme.unit;
                        height: 40 * Theme.unit;
                        source: Icons.get("logo-asteroidos", self.width, self.height);
                        colorize: white;
                    }
                }

                Text {
                    text: "AsteroidOS";
                    color: white;
                    font-size: 7 * Theme.unit;
                    horizontal-alignment: center;
                }

                Text {
                    text: "asteroid-embedded";
                    color: white;
                    opacity: 0.8;
                    font-size: 7 * Theme.unit;
                    horizontal-alignment: center;
                }

                for item in [
                    { label: "Build ID", value: Face.build },
                    { label: "Codename", value: Face.board },
                    { label: "Bluetooth address", value: Face.bt-address },
                    { label: "Display size", value: "400W x 400H" },
                    { label: "Uptime", value: Math.floor(Face.uptime / 86400) + " days " + Face.two-digits(Math.mod(Math.floor(Face.uptime / 3600), 24)) + ":" + Face.two-digits(Math.mod(Math.floor(Face.uptime / 60), 60)) + ":" + Face.two-digits(Math.mod(Face.uptime, 60)) },
                    { label: "Total memory", value: "512 MB" },
                    { label: "Battery", value: Face.battery-percent + "%" },
                ]: VerticalLayout {
                    padding-top: 5 * Theme.unit;

                    Text {
                        text: item.label;
                        color: white;
                        font-size: 7 * Theme.unit;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: item.value;
                        color: white;
                        font-size: 7 * Theme.unit;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
