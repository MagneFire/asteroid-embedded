// The Settings app, laid out as asteroid-settings: a list of icon rows, each opening a page that
// slides in from the right. The pages are the ones the firmware has settings for: Display
// (brightness, always on), Nightstand, Watchface and Launcher pickers, Units (12 hour clock),
// Bluetooth (on/off, connection, forgetting the phone) and About. Rows call setting-toggled with
// the firmware's enum setting, 12 to forget the paired phone, 13 + n to pick watchface n and
// 20 + n to pick launcher n, and brightness-set with a brightness in per cent.
import { Face, Watchface } from "face.slint";
import { Apps, LauncherView } from "launcher.slint";
import { DigitalFace } from "digital.slint";
import { PageHeader, ListItem, LabeledSwitch, IntSelector, RowLabel, RowSeparator, StatusPage, Page } from "controls.slint";

// A 60 px check badge with a soft shadow, as the pickers mark the current choice.
component Check {
    width: 60px;
    height: 60px;

    Image {
        x: 2px;
        y: 2px;
        width: 60px;
        height: 60px;
        source: @image-url("../icons/ios-checkmark-circle.svg");
        colorize: #00000060;
    }

    Image {
        width: 60px;
        height: 60px;
        source: @image-url("../icons/ios-checkmark-circle.svg");
        colorize: white;
    }
}

export component SettingsApp {
    // 0 the list, then 1 Display, 2 Nightstand, 3 Watchface, 4 Launcher, 5 Units, 6 Bluetooth,
    // 7 About.
    in-out property <int> page;
    property <int> back: Face.back-count;

    changed page => {
        Face.app-depth = self.page > 0 ? 1 : 0;
        self.flip = false;
        self.flipped = false;
    }
    changed back => {
        self.page = 0;
        Face.peek = 0;
        Face.peeking = false;
    }

    width: 100%;
    height: 100%;

    // Moved out to the left as a page slides in, and back in beside a page dragged back, kept
    // meanwhile, as LayerStack keeps the layer below, so it comes back as it was.
    Rectangle {
        x: root.page == 0 ? 0 : Face.peeking ? Face.peek - 400px : -400px;
        width: 400px;
        animate x {
            duration: Face.peeking ? 0ms : 200ms;
            easing: ease-out-quint;
        }

        Flickable {
            x: 0;
            width: 400px;
            height: 400px;
            content-height: list.preferred-height;

            list := VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;

                for item[i] in [
                    { icon: @image-url("../icons/ios-display-outline.svg"), title: "Display", page: 1 },
                    { icon: @image-url("../icons/ios-moon-outline.svg"), title: "Nightstand", page: 2 },
                    { icon: @image-url("../icons/ios-watchface-outline.svg"), title: "Watchface", page: 3 },
                    { icon: @image-url("../icons/ios-launcher-outline.svg"), title: "Launcher", page: 4 },
                    { icon: @image-url("../icons/ios-units-outline.svg"), title: "Units", page: 5 },
                    { icon: @image-url("../icons/ios-bluetooth-outline.svg"), title: "Bluetooth", page: 6 },
                    { icon: @image-url("../icons/ios-help-circle-outline.svg"), title: "About", page: 7 },
                ]: ListItem {
                    icon: item.icon;
                    title: item.title;
                    clicked => {
                        root.page = item.page;
                    }
                }
            }
        }
    }

    if root.page == 1: Page {
        Flickable {
            width: 400px;
            height: 400px;
            content-height: display.preferred-height;

            display := VerticalLayout {
                padding-top: 60px;
                padding-bottom: 60px;

                RowLabel {
                    text: "Brightness";
                }

                IntSelector {
                    value: Face.brightness;
                    min: 10;
                    max: 100;
                    down => {
                        Face.brightness-set(Math.max(10, Face.brightness - 10));
                    }
                    up => {
                        Face.brightness-set(Math.min(100, Face.brightness + 10));
                    }
                    set(v) => {
                        Face.brightness-set(v);
                    }
                }

                RowSeparator { }

                LabeledSwitch {
                    text: "Always on Display";
                    checked: Face.aod-on;
                    clicked => {
                        Face.setting-toggled(3);
                    }
                }

                RowSeparator { }
            }
        }

        PageHeader {
            text: "Display";
        }
    }

    if root.page == 2: Page {
        VerticalLayout {
            padding-top: 60px;

            LabeledSwitch {
                text: "Enable";
                checked: Face.nightstand-on;
                clicked => {
                    Face.setting-toggled(6);
                }
            }
        }

        PageHeader {
            text: "Nightstand";
        }
    }

    if root.page == 3: Page {
        for name[i] in ["Digital", "Classic"]: Rectangle {
            x: Math.mod(i, 2) * 200px;
            y: 120px;
            width: 200px;
            height: 160px;

            Rectangle {
                x: 20px;
                width: 160px;
                height: 160px;
                border-radius: 80px;
                clip: true;
                background: Face.watchface == i ? #00000080 : #00000040;

                if i == 0: DigitalFace {
                    size: 160px;
                    preview: true;
                }
                if i == 1: Watchface {
                    size: 160px;
                }
            }

            if Face.watchface == i: Check {
                x: (parent.width - self.width) / 2 + (Math.mod(i, 2) == 0 ? 72px : -72px);
                y: parent.height - self.height + 5px;
            }

            TouchArea {
                clicked => {
                    Face.setting-toggled(13 + i);
                }
            }
        }
    }

    // The chosen launcher's preview turns between its first and last app every 5 s, first at
    // once.
    property <bool> flip;
    property <bool> flipped;
    Timer {
        interval: root.flipped ? 5000ms : 1ms;
        running: root.page == 4;
        triggered => {
            root.flip = !root.flip;
            root.flipped = true;
        }
    }

    if root.page == 4: Page {
        Flickable {
            width: 400px;
            height: 400px;
            content-height: Math.ceil(Apps.layouts.length / 2) * 160px;
            init => {
                self.content-y = -Math.clamp(Math.floor(Face.launcher / 2) * 160px + 80px - 200px, 0, self.content-height - 400px);
            }

            for name[i] in Apps.layouts: Rectangle {
                x: Math.mod(i, 2) * 200px;
                y: Math.floor(i / 2) * 160px;
                width: 200px;
                height: 160px;
                clip: true;

                LauncherView {
                    x: 20px;
                    size: 160px;
                    layout: i;
                    preview: true;
                    last: Face.launcher == i && root.flip;
                }

                if Face.launcher == i: Rectangle {
                    background: #00000066;
                }

                if Face.launcher == i: Check {
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                }

                TouchArea {
                    clicked => {
                        Face.setting-toggled(20 + i);
                    }
                }
            }
        }
    }

    if root.page == 5: Page {
        VerticalLayout {
            padding-top: 100px;

            LabeledSwitch {
                text: "Use 12H format:";
                checked: Face.clock12;
                clicked => {
                    Face.setting-toggled(4);
                }
            }
        }

        PageHeader {
            text: "Units";
        }
    }

    if root.page == 6: Page {
        StatusPage {
            icon: Face.bluetooth-on ? @image-url("../icons/ios-bluetooth-outline.svg") : @image-url("../icons/ios-bluetooth-off-outline.svg");
            active: Face.bluetooth-on;
            title: Face.bluetooth-on ? "Bluetooth on" : "Bluetooth off";
            text: Face.bluetooth-connected ? "Connected" : "Not connected";
            clicked => {
                Face.setting-toggled(1);
            }
        }

        LabeledSwitch {
            y: 290px;
            text: "Forget phone";
            icon: @image-url("../icons/ios-trash-outline.svg");
            clicked => {
                Face.setting-toggled(12);
            }
        }
    }

    if root.page == 7: Page {
        Flickable {
            width: 400px;
            height: 400px;
            content-height: about.preferred-height;

            about := VerticalLayout {
                padding-top: 40px;
                padding-bottom: 40px;
                padding-left: 40px;
                padding-right: 40px;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        width: 160px;
                        height: 160px;
                        source: @image-url("../icons/logo-asteroidos.svg");
                        colorize: white;
                    }
                }

                Text {
                    text: "AsteroidOS";
                    color: white;
                    font-size: 28px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "asteroid-embedded";
                    color: white;
                    opacity: 0.8;
                    font-size: 28px;
                    horizontal-alignment: center;
                }

                for item in [
                    { label: "Build ID", value: Face.build },
                    { label: "Codename", value: "sturgeon" },
                    { label: "Display size", value: "400W x 400H" },
                    { label: "Battery", value: Face.battery-percent + "%" },
                ]: VerticalLayout {
                    padding-top: 20px;

                    Text {
                        text: item.label;
                        color: white;
                        font-size: 28px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: item.value;
                        color: white;
                        font-size: 28px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
